# HTTPS for QA Tracker. Caddy gets and renews a Let's Encrypt certificate for
# QATRACKER_DOMAIN automatically (the name must resolve to this server, with ports 80 and
# 443 reachable), redirects HTTP to HTTPS, and adds the X-Forwarded-* headers the app trusts.
{$QATRACKER_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8080
}
