# QA Tracker on-premises: local accounts + attachments.
# Copy to .env, fill in every value, and keep the file out of version control.

# The DNS name people use (Caddy gets its HTTPS certificate for it).
QATRACKER_DOMAIN=qa.example.com
# A release tag (e.g. 2026.11.14) to control upgrades, or latest.
QATRACKER_IMAGE_TAG=latest

# Database password (shared by the db and app services).
QATRACKER_DB_PASSWORD=change-me-long-random

# File storage (Garage). The RPC secret is 64 hex characters: openssl rand -hex 32
GARAGE_RPC_SECRET=replace-with-openssl-rand-hex-32
QATRACKER_S3_ACCESS_KEY=qatracker
QATRACKER_S3_SECRET_KEY=change-me-16-plus-characters

# The first QA account, created on first start. Sign in with it, then add your team under
# System settings → Users.
QATRACKER_ADMIN_EMAIL=you@example.com
QATRACKER_ADMIN_PASSWORD=Change-me-1!

# true = start with example projects to explore (only ever into an empty database).
QATRACKER_DEMO_DATA=false
