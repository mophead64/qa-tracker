# QA Tracker on-premises: Microsoft Entra ID sign-in + attachments + Application Insights.
# Copy to .env, fill in every value, and keep the file out of version control.
# Register the app in Entra first (docs/sso.md): redirect URI https://<QATRACKER_DOMAIN>/signin-oidc,
# app roles QA / Dev / Viewer, the email optional claim, and a client secret.

QATRACKER_DOMAIN=qa.example.com
QATRACKER_IMAGE_TAG=latest

QATRACKER_DB_PASSWORD=change-me-long-random

GARAGE_RPC_SECRET=replace-with-openssl-rand-hex-32
QATRACKER_S3_ACCESS_KEY=qatracker
QATRACKER_S3_SECRET_KEY=change-me-16-plus-characters

# Single sign-on with Microsoft Entra ID. People's roles come from the app roles.
QATRACKER_AUTH_PROVIDER=Entra
QATRACKER_OIDC_TENANT_ID=00000000-0000-0000-0000-000000000000
QATRACKER_OIDC_CLIENT_ID=00000000-0000-0000-0000-000000000000
QATRACKER_OIDC_CLIENT_SECRET=client-secret-value
# Make SSO the only way in (no local passwords at all):
# QATRACKER_LOCAL_AUTH_ENABLED=false

# Traces, metrics and logs to Application Insights (its connection string, from the portal).
QATRACKER_TELEMETRY_PROVIDER=AzureMonitor
QATRACKER_AZURE_MONITOR_CONNECTION_STRING=InstrumentationKey=…;IngestionEndpoint=…

# Optional break-glass local QA (ignored when QATRACKER_LOCAL_AUTH_ENABLED=false).
# QATRACKER_ADMIN_EMAIL=you@example.com
# QATRACKER_ADMIN_PASSWORD=Change-me-1!
