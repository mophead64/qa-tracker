###############################################################################
# QA Tracker — environment configuration
#
# Copy this file to `.env` for local development. Never commit the real `.env`.
# In hosted environments these values should come from real environment variables
#
# Sections:
#   1. Database                (required)
#   2. Bootstrap admin         (optional)
#   3. SSO / OIDC              (optional)
#   4. File storage            (optional)
#   5. Telemetry               (optional)
#   6. Horizontal scaling      (optional, managed hosts)
#   7. ASP.NET runtime         (required)
#   8. Notifications           (optional)
#
#------------------------------------------------------------------------------
# Value formats
#------------------------------------------------------------------------------
# Booleans   : only `true` / `false` (case-insensitive). 
#
# Enums      : the accepted set is listed per-variable below as
#              "Values: ...". Matching is case-insensitive unless noted.
#
# Numbers    : plain integers, no units.
###############################################################################


#==============================================================================
# 1. DATABASE  (required)
#==============================================================================
# Precedence: if ConnectionStrings__DefaultConnection (below) is set it is used
# verbatim and every QATRACKER_DB_* value here is ignored.

QATRACKER_DB_HOST=localhost
QATRACKER_DB_PORT=5432                  # integer, default 5432
QATRACKER_DB_NAME=qatracker
QATRACKER_DB_USER=qatracker
QATRACKER_DB_PASSWORD=qatracker

#------------------------------------------------------------------------------
# Connection pool bounds
#------------------------------------------------------------------------------
# Integers. Apply only on the assembled (QATRACKER_DB_*) path — ignored when
# ConnectionStrings__DefaultConnection is set (See below). Budget across instances:
#   instances * MaxPoolSize + headroom < postgres max_connections
# Defaults: 20 / 1.
# QATRACKER_DB_MAX_POOL_SIZE=20
# QATRACKER_DB_MIN_POOL_SIZE=1

#------------------------------------------------------------------------------
# Full connection string (alternative to the QATRACKER_DB_* vars above)
#------------------------------------------------------------------------------
# A standard Npgsql connection string. When set, this takes precedence over the
# assembled values above AND over QATRACKER_DB_MAX_POOL_SIZE / MIN_POOL_SIZE
# (put Maximum Pool Size / Minimum Pool Size in the string yourself).
# Note the double underscore.
# ConnectionStrings__DefaultConnection=Host=localhost;Database=qatracker;Username=qatracker;Password=qatracker

#------------------------------------------------------------------------------
# Startup/Database migrations
#------------------------------------------------------------------------------
# QATRACKER_MIGRATE_ON_STARTUP
#   Values: true | false     Default: true
#   true  -> apply EF migrations + seeding on startup (under a Postgres advisory
#            lock, so concurrent starts are safe).
#   false -> a dedicated migration step owns the schema: run the same image with
#            `--migrate-only` first; instances then refuse to start while any
#            migration is still pending.
# QATRACKER_MIGRATE_ON_STARTUP=false


#==============================================================================
# 2. BOOTSTRAP ADMIN  (optional)
#==============================================================================
# If BOTH values are set, a confirmed QA user is created on first startup (and
# on later startups if that email no longer exists). If either is blank, no
# bootstrap user is created.
#
# The password must satisfy the ASP.NET Identity default policy: at least 6
# characters with an uppercase letter, a lowercase letter, a digit and a
# non-alphanumeric character.

QATRACKER_ADMIN_EMAIL=admin@example.com
QATRACKER_ADMIN_PASSWORD=ChangeMe123!


#==============================================================================
# 3. SSO / OIDC  (optional)
#==============================================================================
# Leave QATRACKER_AUTH_PROVIDER unset (or blank) for local accounts only. Set
# it to add ONE external OpenID Connect provider alongside local login (never
# two at once). Provider-managed users get their QA/Dev roles from the token
# and cannot change email/password/roles in-app.
#
# Values (case-insensitive):
#   Keycloak                         -> self-hosted Keycloak (docker-compose
#                                       ships one; admin console :8081)
#   Entra | EntraId | AzureAD | AAD  -> Microsoft Entra ID
#   (unset / anything else)          -> local accounts only
#
# When set, QATRACKER_OIDC_CLIENT_ID and QATRACKER_OIDC_CLIENT_SECRET are
# REQUIRED, plus an authority: either QATRACKER_OIDC_AUTHORITY, or — for Entra —
# QATRACKER_OIDC_TENANT_ID. The app fails to start without them.

QATRACKER_AUTH_PROVIDER=Keycloak

#------------------------------------------------------------------------------
# Provider endpoints and client credentials  (required when provider is set)
#------------------------------------------------------------------------------
# QATRACKER_OIDC_AUTHORITY is the browser-facing issuer URL. The Keycloak dev
# realm is shown below.
#
# For Entra, skip QATRACKER_OIDC_AUTHORITY and set QATRACKER_OIDC_TENANT_ID to
# the directory (tenant) ID from the portal — the app composes the v2 authority
#   https://login.microsoftonline.com/<tenant-id>/v2.0
# For a national cloud, also set QATRACKER_OIDC_INSTANCE (e.g.
#   https://login.microsoftonline.us). An explicit QATRACKER_OIDC_AUTHORITY
# still wins if you set both.
# QATRACKER_OIDC_TENANT_ID=00000000-0000-0000-0000-000000000000
# QATRACKER_OIDC_INSTANCE=https://login.microsoftonline.com
QATRACKER_OIDC_AUTHORITY=http://localhost:8081/realms/qatracker
QATRACKER_OIDC_CLIENT_ID=qatracker-web
QATRACKER_OIDC_CLIENT_SECRET=qatracker-dev-secret

#------------------------------------------------------------------------------
# Back-channel discovery override  (optional)
#------------------------------------------------------------------------------
# Override ONLY the back-channel discovery URL (leave AUTHORITY as the public
# issuer). Needed when the app can't resolve the public issuer host — e.g. the
# web container reaching the compose Keycloak. Unset when the app runs on the host.
# QATRACKER_OIDC_METADATA_ADDRESS=http://keycloak:8080/realms/qatracker/.well-known/openid-configuration

#------------------------------------------------------------------------------
# Scopes  (optional)
#------------------------------------------------------------------------------
# Separator: space or comma. `openid` is always added if you leave it out.
# Default: "openid profile email".
# QATRACKER_OIDC_SCOPES=openid profile email

#------------------------------------------------------------------------------
# Role mapping  (optional)
#------------------------------------------------------------------------------
# QATRACKER_OIDC_ROLE_CLAIM      - token claim carrying roles. Default "roles".
#                                  Entra emits "roles"; Keycloak needs a mapper
#                                  (the shipped dev realm has one).
# QATRACKER_OIDC_ROLE_QA_VALUE   - claim value that grants QA.  Default "QA".
# QATRACKER_OIDC_ROLE_DEV_VALUE  - claim value that grants Dev. Default "Dev".
QATRACKER_OIDC_ROLE_CLAIM=roles
# QATRACKER_OIDC_ROLE_QA_VALUE=QA
# QATRACKER_OIDC_ROLE_DEV_VALUE=Dev

#------------------------------------------------------------------------------
# Transport security  (optional)
#------------------------------------------------------------------------------
# QATRACKER_OIDC_REQUIRE_HTTPS_METADATA
#   Values: true | false      Default: true
#   Set false ONLY for plain-HTTP dev IdPs (the compose Keycloak).
QATRACKER_OIDC_REQUIRE_HTTPS_METADATA=false


#==============================================================================
# 4. FILE STORAGE  (optional)
#==============================================================================
# Uploaded attachments (project resources, test-case resources, defect
# evidence). Pick ONE provider — the app never uses both.
#
# QATRACKER_STORAGE_PROVIDER
#   Values (case-insensitive):
#     S3                      -> real AWS S3 or an S3-compatible service
#                                (MinIO, Garage)
#     Azure                   -> Azure Blob Storage
#     (unset / anything else) -> uploads disabled entirely
#
# When set, the chosen provider's *_BUCKET / *_ACCESS_KEY / *_SECRET_KEY (S3)
# or *_CONNECTION_STRING (Azure) are REQUIRED — the app fails to start without them.

QATRACKER_STORAGE_PROVIDER=S3

#------------------------------------------------------------------------------
# S3 provider
#------------------------------------------------------------------------------
# QATRACKER_S3_BUCKET            - required when provider is S3
# QATRACKER_S3_REGION            - default "us-east-1"
# QATRACKER_S3_ENDPOINT          - set for anything that isn't AWS (MinIO,
#                                  Garage); leave UNSET for real AWS S3
# QATRACKER_S3_ACCESS_KEY        - required when provider is S3
# QATRACKER_S3_SECRET_KEY        - required when provider is S3
# QATRACKER_S3_FORCE_PATH_STYLE  - Values: true | false
#                                  Default: true when QATRACKER_S3_ENDPOINT is
#                                  set, false otherwise. MinIO/Garage need true.
QATRACKER_S3_BUCKET=qatracker-attachments
QATRACKER_S3_REGION=us-east-1
QATRACKER_S3_ENDPOINT=http://localhost:9000
QATRACKER_S3_ACCESS_KEY=minioadmin
QATRACKER_S3_SECRET_KEY=minioadmin
QATRACKER_S3_FORCE_PATH_STYLE=true

#------------------------------------------------------------------------------
# Azure Blob Storage provider
#------------------------------------------------------------------------------
# Set QATRACKER_STORAGE_PROVIDER=Azure and these instead of the S3 vars.
# QATRACKER_AZURE_STORAGE_CONNECTION_STRING  - required when provider is Azure
# QATRACKER_AZURE_CONTAINER                  - default "qatracker-attachments"
#
#
# QATRACKER_AZURE_STORAGE_CONNECTION_STRING=
# QATRACKER_AZURE_CONTAINER=qatracker-attachments

#------------------------------------------------------------------------------
# Upload limits
#------------------------------------------------------------------------------
# QATRACKER_MAX_UPLOAD_MB - integer megabytes. Default 20. Also raises the
#                           Kestrel request body limit (max + 5 MB overhead).
#
QATRACKER_MAX_UPLOAD_MB=20


#==============================================================================
# 5. TELEMETRY  (optional)
#==============================================================================
# Export OpenTelemetry traces/metrics/logs. Traces cover ASP.NET Core requests,
# outbound HTTP and PostgreSQL and carry exceptions as span events. Static
# assets (css/js/images, Blazor framework files) are kept out.
#
# QATRACKER_TELEMETRY_PROVIDER
#   Values (case-insensitive):
#     Otlp | Otel | OpenTelemetry                       -> any OTLP endpoint
#         (SigNoz, Grafana Alloy/Tempo, an OpenTelemetry Collector)
#     AzureMonitor | Azure | ApplicationInsights | AppInsights | AI
#         -> Azure Monitor / Application Insights
#     (unset / anything else)                           -> telemetry off
#
# When set, the chosen provider's endpoint/connection-string var below is
# REQUIRED — the app fails to start without it.
#
# `docker compose up` runs an OTLP collector + Jaeger and the web service exports
# to them by default (traces UI: http://localhost:16686). Running the app with
# `dotnet run` instead? Start those two with `docker compose up otel-collector`
# and set the vars below:
QATRACKER_TELEMETRY_PROVIDER=Otlp
QATRACKER_OTLP_ENDPOINT=http://localhost:4317
#
# The collector fans signals out: traces -> Jaeger, metrics + logs -> its stdout.
# Jaeger's own OTLP port only accepts traces, so point the app at the collector,
# not directly at Jaeger.

QATRACKER_TELEMETRY_PROVIDER=Otlp
QATRACKER_TELEMETRY_SERVICE_NAME=qa-tracker   # service.name resource attr. Default "qa-tracker".

#------------------------------------------------------------------------------
# Log level
#------------------------------------------------------------------------------
# QATRACKER_TELEMETRY_LOG_LEVEL - minimum ILogger level shipped to the backend
#   (traces/metrics unaffected).
#   Values: Trace | Debug | Information | Warning | Error | Critical | None
#   Default: Warning  (keeps exceptions, drops per-request info noise)
#
#
# QATRACKER_TELEMETRY_LOG_LEVEL=Warning

#------------------------------------------------------------------------------
# OTLP endpoint  (required when provider is Otlp)
#------------------------------------------------------------------------------
# QATRACKER_OTLP_PROTOCOL
#   Values: grpc | http/protobuf     Default: grpc
#   (an unrecognised value is a startup error, not a silent fallback)
#
#
# QATRACKER_OTLP_ENDPOINT=http://localhost:4317
# QATRACKER_OTLP_PROTOCOL=grpc

#------------------------------------------------------------------------------
# Azure Monitor endpoint  (required when provider is AzureMonitor)
#------------------------------------------------------------------------------
# QATRACKER_AZURE_MONITOR_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...


#==============================================================================
# 6. HORIZONTAL SCALING  (optional, managed hosts)
#==============================================================================

#------------------------------------------------------------------------------
# Forwarded headers
#------------------------------------------------------------------------------
# QATRACKER_FORWARDED_HEADERS
#   Values: true | false     Default: false
#   Trust X-Forwarded-For / X-Forwarded-Proto from a TLS-terminating proxy /
#   platform ingress (Azure App Service, Container Apps, nginx, ...). Required
#   behind a proxy so OIDC callback URLs use https.
#   Do NOT also set ASPNETCORE_FORWARDEDHEADERS_ENABLED.
# QATRACKER_FORWARDED_HEADERS=true
#
# The next three apply only when QATRACKER_FORWARDED_HEADERS=true, and only when
# fronting the app with YOUR OWN proxy (platform ingress needs none of them):
#   QATRACKER_KNOWN_PROXIES            - comma-separated IP addresses
#   QATRACKER_KNOWN_NETWORKS           - comma-separated CIDR ranges
#   QATRACKER_FORWARDED_HEADERS_LIMIT  - integer; max proxy hops to unwrap.
#                                       Unset = no limit.
# QATRACKER_KNOWN_PROXIES=10.0.0.4
# QATRACKER_KNOWN_NETWORKS=10.0.0.0/16
# QATRACKER_FORWARDED_HEADERS_LIMIT=1

#------------------------------------------------------------------------------
# In-app HTTPS redirection
#------------------------------------------------------------------------------
# QATRACKER_HTTPS_REDIRECT
#   Values: true | false     Default: false
#   TLS is normally terminated at a reverse proxy, so app-level redirection is
#   off by default. Set true only when the app is directly internet-facing.
# QATRACKER_HTTPS_REDIRECT=false




#==============================================================================
# 7. ASP.NET RUNTIME  (required)
#==============================================================================

#------------------------------------------------------------------------------
# Environment name
#------------------------------------------------------------------------------
# ASPNETCORE_ENVIRONMENT
#   Conventional values: Development | Staging | Production
#   (any string is accepted; only "Development" is special-cased — it enables
#   the EF migrations endpoint and the developer exception page. Every other
#   value, including unset, runs the production pipeline: exception handler +
#   HSTS.)
#   Default when unset: Production.
#   DOTNET_ENVIRONMENT is an equivalent fallback if this is unset.
ASPNETCORE_ENVIRONMENT=Development

#------------------------------------------------------------------------------
# Listening ports  (optional)
#------------------------------------------------------------------------------
# ASPNETCORE_HTTP_PORTS - semicolon-separated ports for plain HTTP. The Docker
#                         image sets this to 8080.
# ASPNETCORE_URLS       - full binding URLs, overrides *_HTTP_PORTS
#                         (e.g. http://+:8080).
# ASPNETCORE_HTTP_PORTS=8080


#==============================================================================
# 8. NOTIFICATIONS  (optional)
#==============================================================================
# The notification bell keeps its badge live and pops toasts by polling the
# backend from the browser — no WebSocket / SignalR / extra service, and it
# works across multiple instances because every instance reads the same
# database. The poll endpoint is a small per-user query and is kept out of the
# request log and traces.
#
# QATRACKER_NOTIFICATIONS_POLL_SECONDS
#   Integer seconds between polls, per open browser tab (polling pauses while
#   the tab is backgrounded). Clamped to 5..3600. Default 45.
#   Lower = notifications surface sooner, at the cost of more requests.
# QATRACKER_NOTIFICATIONS_POLL_SECONDS=45
