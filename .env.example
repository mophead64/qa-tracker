# Copy to .env for local development. Never commit the real .env.
# In hosted environments these come from real environment variables / Key Vault.

# --- Database -----------------------------------------------------------
QATRACKER_DB_HOST=localhost
QATRACKER_DB_PORT=5432
QATRACKER_DB_NAME=qatracker
QATRACKER_DB_USER=qatracker
QATRACKER_DB_PASSWORD=qatracker

# Alternatively provide a full connection string (takes precedence):
# ConnectionStrings__DefaultConnection=Host=localhost;Database=qatracker;Username=qatracker;Password=qatracker

# --- Bootstrap admin (optional) ---------------------------------------
# If both are set, a confirmed QA user is created on first startup.
QATRACKER_ADMIN_EMAIL=admin@example.com
QATRACKER_ADMIN_PASSWORD=ChangeMe123!

# --- SSO / OIDC (optional) -------------------------------------------
# Leave QATRACKER_AUTH_PROVIDER unset for local accounts only. Set it to add ONE external
# OpenID Connect provider alongside local login (never two at once). Provider-managed users
# get their QA/Dev roles from the token and cannot change email/password/roles in-app.
#   Keycloak -> self-hosted Keycloak (docker-compose ships one; admin console :8081)
#   Entra    -> Microsoft Entra ID
QATRACKER_AUTH_PROVIDER=Keycloak

# Browser-facing issuer URL. Keycloak dev realm below; Entra is
# https://login.microsoftonline.com/<tenant-id>/v2.0
QATRACKER_OIDC_AUTHORITY=http://localhost:8081/realms/qatracker
QATRACKER_OIDC_CLIENT_ID=qatracker-web
QATRACKER_OIDC_CLIENT_SECRET=qatracker-dev-secret

# Optional: override ONLY the back-channel discovery URL (leave AUTHORITY as the public
# issuer). Needed when the app can't resolve the public issuer host — e.g. the web
# container reaching the compose Keycloak. Unset when the app runs on the host.
# QATRACKER_OIDC_METADATA_ADDRESS=http://keycloak:8080/realms/qatracker/.well-known/openid-configuration

# Space-separated; openid is always included. Default: "openid profile email".
# QATRACKER_OIDC_SCOPES=openid profile email

# Token claim carrying roles, and the values that map to QA / Dev. Entra emits "roles";
# Keycloak needs a mapper (the shipped dev realm has one). Defaults: roles / QA / Dev.
QATRACKER_OIDC_ROLE_CLAIM=roles
# QATRACKER_OIDC_ROLE_QA_VALUE=QA
# QATRACKER_OIDC_ROLE_DEV_VALUE=Dev

# Set false only for plain-HTTP dev IdPs (the compose Keycloak). Default true.
QATRACKER_OIDC_REQUIRE_HTTPS_METADATA=false

# --- File storage (optional) -------------------------------------------
# Uploaded attachments (project resources, test-case resources, defect evidence). Pick
# one provider — the app never uses both. Leave QATRACKER_STORAGE_PROVIDER unset to
# disable uploads entirely.
QATRACKER_STORAGE_PROVIDER=S3

# S3 — works against real AWS S3 or an S3-compatible service (MinIO, Garage). Set
# QATRACKER_S3_ENDPOINT for anything that isn't AWS; leave it unset for real S3.
QATRACKER_S3_BUCKET=qatracker-attachments
QATRACKER_S3_REGION=us-east-1
QATRACKER_S3_ENDPOINT=http://localhost:9000
QATRACKER_S3_ACCESS_KEY=minioadmin
QATRACKER_S3_SECRET_KEY=minioadmin
QATRACKER_S3_FORCE_PATH_STYLE=true

# Azure Blob Storage — set QATRACKER_STORAGE_PROVIDER=Azure and these instead of the S3 vars.
# QATRACKER_AZURE_STORAGE_CONNECTION_STRING=
# QATRACKER_AZURE_CONTAINER=qatracker-attachments

# Maximum upload size, in megabytes.
QATRACKER_MAX_UPLOAD_MB=20

# --- Telemetry (optional) --------------------------------------------
# Export OpenTelemetry traces/metrics/logs by setting QATRACKER_TELEMETRY_PROVIDER; unset
# = off. Traces cover ASP.NET Core requests, outbound HTTP and PostgreSQL and carry
# exceptions as span events. Static assets (css/js/images, Blazor framework files) are
# kept out.
#   Otlp         -> any OTLP endpoint (SigNoz, Grafana Alloy/Tempo, an OpenTelemetry Collector)
#   AzureMonitor -> Azure Monitor / Application Insights
# QATRACKER_TELEMETRY_PROVIDER=Otlp
# QATRACKER_TELEMETRY_SERVICE_NAME=qa-tracker
# Minimum log level shipped to the backend (traces/metrics unaffected). Default Warning
# keeps exceptions but drops per-request info noise.
# QATRACKER_TELEMETRY_LOG_LEVEL=Warning

# OTLP:
# QATRACKER_OTLP_ENDPOINT=http://localhost:4317
# QATRACKER_OTLP_PROTOCOL=grpc          # grpc (default) or http/protobuf

# Azure Monitor (set QATRACKER_TELEMETRY_PROVIDER=AzureMonitor and this instead):
# QATRACKER_AZURE_MONITOR_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# --- ASP.NET ----------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
