# Copy to .env for local development. Never commit the real .env.
# In hosted environments these come from real environment variables / Key Vault.

# --- Database -----------------------------------------------------------
QATRACKER_DB_HOST=localhost
QATRACKER_DB_PORT=5432
QATRACKER_DB_NAME=qatracker
QATRACKER_DB_USER=qatracker
QATRACKER_DB_PASSWORD=qatracker

# Alternatively provide a full connection string (takes precedence):
# ConnectionStrings__DefaultConnection=Host=localhost;Database=qatracker;Username=qatracker;Password=qatracker

# --- Bootstrap admin (optional) ---------------------------------------
# If both are set, a confirmed QA user is created on first startup.
QATRACKER_ADMIN_EMAIL=admin@example.com
QATRACKER_ADMIN_PASSWORD=ChangeMe123!

# --- ASP.NET ----------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
