<Project Sdk="Microsoft.NET.Sdk">

  <!-- Seeds a throwaway QA Tracker database with fictional demo data (through the app's own
       services, with a movable clock so history is realistic) and captures the documentation
       screenshots with Playwright. Not part of QaTracker.slnx; see README.md in this folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
    <!-- Only the services and EF model are used; the screenshots come from the Docker image, so
         the web project's Tailwind build step is skipped. -->
    <ProjectReference Include="..\..\src\QaTracker.Web\QaTracker.Web.csproj" AdditionalProperties="SkipTailwind=true" />
  </ItemGroup>

</Project>
