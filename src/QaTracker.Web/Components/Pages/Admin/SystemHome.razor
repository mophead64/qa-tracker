@page "/admin"
@using QaTracker.Web.Auth
@using QaTracker.Web.Hosting
@using QaTracker.Web.Hosting.UpdateCheck
@using QaTracker.Web.Storage
@using QaTracker.Web.Telemetry
@inject SystemStatsService Stats
@inject SystemSettingsService Settings
@inject IConfiguration Configuration
@inject BuildInfo Build
@inject UpdateCheckService UpdateCheck
@inject NavigationManager Nav

<PageTitle>System settings · QA Tracker</PageTitle>

<h1>System settings</h1>
<p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
    Usage stats, feature status, developer permissions, and user accounts.
</p>

<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="card">
        <p class="text-sm font-medium text-gray-500">Projects</p>
        <p class="mt-1 text-2xl font-semibold text-gray-900 dark:text-white">@stats.Projects</p>
    </div>
    <div class="card">
        <p class="text-sm font-medium text-gray-500">Test cases</p>
        <p class="mt-1 text-2xl font-semibold text-gray-900 dark:text-white">@stats.TestCases</p>
    </div>
    <div class="card">
        <p class="text-sm font-medium text-gray-500">Defects</p>
        <p class="mt-1 text-2xl font-semibold text-gray-900 dark:text-white">@stats.Defects</p>
    </div>
    <div class="card">
        <p class="text-sm font-medium text-gray-500">Files</p>
        <p class="mt-1 text-2xl font-semibold text-gray-900 dark:text-white">@stats.Files</p>
        <p class="mt-1 text-xs text-gray-400">@ByteSize.Format(stats.FileBytes) stored</p>
    </div>
</div>

<div class="mt-6 grid items-start gap-4 lg:grid-cols-2">
    <div class="space-y-4">
        <div class="card">
            <h2>System status</h2>
            <ul class="mt-3 divide-y divide-gray-100 dark:divide-gray-800">
                <li class="flex items-center justify-between py-3">
                    <span class="text-sm text-gray-700 dark:text-gray-300">Storage</span>
                    <span class="@StorageBadgeClass">@StorageLabel</span>
                </li>
                <li class="flex items-center justify-between py-3">
                    <span class="text-sm text-gray-700 dark:text-gray-300">Authentication</span>
                    <span class="badge badge-brand">@AuthLabel</span>
                </li>
                <li class="flex items-center justify-between py-3">
                    <span class="text-sm text-gray-700 dark:text-gray-300">Telemetry</span>
                    <span class="@TelemetryBadgeClass">@TelemetryLabel</span>
                </li>
                <li class="flex items-center justify-between gap-4 py-3">
                    <span class="text-sm text-gray-700 dark:text-gray-300">Version</span>
                    <span class="text-right">
                        <span class="font-mono text-sm font-medium text-gray-900 dark:text-white">@Build.Version</span>
                        @if (Build.SourceRef is { } sourceRef)
                        {
                            @if (Build.CommitUrl is { } commitUrl)
                            {
                                <a href="@commitUrl" target="_blank" rel="noopener noreferrer"
                                   class="ml-2 font-mono text-xs text-gray-500 hover:text-brand-600 dark:hover:text-brand-400">@sourceRef</a>
                            }
                            else
                            {
                                <span class="ml-2 font-mono text-xs text-gray-500">@sourceRef</span>
                            }
                        }
                    </span>
                </li>
                @if (updateStatus.State != UpdateState.Disabled)
                {
                    <li class="flex items-center justify-between gap-4 py-3">
                        <span class="text-sm text-gray-700 dark:text-gray-300">Updates</span>
                        <span class="flex items-center gap-3">
                            @if (updateStatus.CheckedAt is { } checkedAt)
                            {
                                <span class="text-xs text-gray-400" title="@checkedAt.ToLocalTime().ToString("f")">
                                    checked @Relative(checkedAt)
                                </span>
                            }
                            @switch (updateStatus.State)
                            {
                                case UpdateState.UpdateAvailable:
                                    <a href="@updateStatus.ReleaseUrl" target="_blank" rel="noopener noreferrer"
                                       class="badge badge-amber">Update available &rarr; @updateStatus.LatestVersion</a>
                                    break;
                                case UpdateState.UpToDate:
                                    <span class="badge badge-brand">Up to date</span>
                                    break;
                                case UpdateState.CheckFailed:
                                    <span class="badge badge-gray">Check failed</span>
                                    break;
                                default:
                                    <span class="badge badge-gray">Not checked</span>
                                    break;
                            }
                            <EditForm Model="CheckModel" FormName="check-updates" OnValidSubmit="CheckForUpdatesAsync" method="post">
                                <button type="submit" class="btn-secondary btn-sm">Check for updates</button>
                            </EditForm>
                        </span>
                    </li>
                }
            </ul>
        </div>

        <div class="card">
            <h2>Uploads</h2>
            <p class="mt-1 text-sm text-gray-500">
                The largest single file anyone can attach to a project, test case, or defect.
            </p>

            @if (UploadSaved)
            {
                <div class="alert alert-success mt-3">Upload limit saved.</div>
            }

            <EditForm Model="UploadModel" FormName="upload-limit" OnValidSubmit="SaveUploadLimitAsync" method="post" class="mt-4">
                <label class="form-label" for="max-upload-mb">Maximum file size (MB)</label>
                <div class="flex items-center gap-2">
                    <InputNumber id="max-upload-mb" @bind-Value="UploadModel.MaxUploadMb" min="1" max="@uploadCeilingMb"
                                 class="form-control w-32" />
                    <button type="submit" class="btn-primary">Save</button>
                </div>
                <p class="mt-1 text-xs text-gray-400">
                    1–@uploadCeilingMb MB. Raise <code>QATRACKER_MAX_UPLOAD_MB</code> to lift the ceiling.
                </p>
            </EditForm>
        </div>
    </div>

    <div class="space-y-4">
        <div class="card">
            <div class="flex items-center justify-between gap-4">
                <h2>Users</h2>
                <a href="admin/users" class="btn-secondary">Manage users</a>
            </div>
            <p class="mt-1 text-xs text-gray-400">Create, edit, and remove user accounts and their QA/Dev roles.</p>
        </div>

        <div class="card">
            <h2>Developer permissions</h2>
            <p class="mt-1 text-sm text-gray-500">
                QA can always create, edit, and delete this content. These switches decide whether
                developers can too. Purely QA workflow — test results, defect status and assignee —
                stays QA-only regardless.
            </p>

            @if (Saved)
            {
                <div class="alert alert-success mt-3">Developer permissions saved.</div>
            }

            @* Raw checkboxes rather than <InputCheckbox> so an unchecked box simply posts nothing —
               the same pattern UserForm uses for its role checkboxes. *@
            <EditForm Model="Model" FormName="dev-permissions" OnValidSubmit="SavePermissionsAsync" method="post" class="mt-4 space-y-3">
                <label class="flex items-center gap-3 rounded-md border border-gray-200 px-3 py-2 text-sm
                              hover:bg-gray-50 dark:border-gray-800 dark:hover:bg-gray-800">
                    <input type="checkbox" name="Model.Projects" value="true" checked="@Model.Projects" class="form-check-input" />
                    <span class="font-medium">Developers can manage projects</span>
                </label>
                <label class="flex items-center gap-3 rounded-md border border-gray-200 px-3 py-2 text-sm
                              hover:bg-gray-50 dark:border-gray-800 dark:hover:bg-gray-800">
                    <input type="checkbox" name="Model.TestCases" value="true" checked="@Model.TestCases" class="form-check-input" />
                    <span class="font-medium">Developers can manage test cases</span>
                </label>
                <label class="flex items-center gap-3 rounded-md border border-gray-200 px-3 py-2 text-sm
                              hover:bg-gray-50 dark:border-gray-800 dark:hover:bg-gray-800">
                    <input type="checkbox" name="Model.Defects" value="true" checked="@Model.Defects" class="form-check-input" />
                    <span class="font-medium">Developers can manage defects</span>
                </label>

                <button type="submit" class="btn-primary mt-2">Save</button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // [SupplyParameterFromForm] leaves this null except on a matching POST, so it's guarded
    // with `Model ??= new()` at the top of OnParametersSetAsync (before any await / render).
    [SupplyParameterFromForm(FormName = "dev-permissions")]
    private DevPermissionsModel Model { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "upload-limit")]
    private UploadLimitModel UploadModel { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "check-updates")]
    private CheckUpdatesModel CheckModel { get; set; } = default!;

    [SupplyParameterFromQuery]
    private bool Saved { get; set; }

    [SupplyParameterFromQuery]
    private bool UploadSaved { get; set; }

    private SystemStats stats = new(0, 0, 0, 0, 0);
    private int uploadCeilingMb;
    private UpdateStatus updateStatus = UpdateStatus.NotChecked;
    private StorageProvider storageProvider;
    private TelemetryProvider telemetryProvider;
    private AuthProvider authProvider;

    private string AuthLabel => authProvider switch
    {
        AuthProvider.Entra => "Local accounts + Microsoft Entra ID (SSO)",
        AuthProvider.Keycloak => "Local accounts + Keycloak (SSO)",
        _ => "Local accounts only",
    };

    private string StorageLabel => storageProvider switch
    {
        StorageProvider.S3 => "S3",
        StorageProvider.Azure => "Azure Blob Storage",
        _ => "Not configured",
    };

    private string StorageBadgeClass => storageProvider == StorageProvider.None ? "badge badge-gray" : "badge badge-brand";

    private string TelemetryLabel => telemetryProvider switch
    {
        TelemetryProvider.AzureMonitor => $"Azure Monitor · {TelemetryOptions.ResolveServiceName(Configuration)}",
        TelemetryProvider.Otlp => $"OpenTelemetry (OTLP) · {TelemetryOptions.ResolveServiceName(Configuration)}",
        _ => "Not configured",
    };

    private string TelemetryBadgeClass => telemetryProvider == TelemetryProvider.None ? "badge badge-gray" : "badge badge-brand";

    protected override async Task OnParametersSetAsync()
    {
        Model ??= new();
        UploadModel ??= new();
        CheckModel ??= new();

        stats = await Stats.GetAsync();
        uploadCeilingMb = Settings.MaxUploadCeilingMb;
        updateStatus = UpdateCheck.Current;
        storageProvider = StorageOptions.ResolveProvider(Configuration);
        telemetryProvider = TelemetryOptions.ResolveProvider(Configuration);
        authProvider = AuthConfig.ResolveProvider(Configuration);

        // Seed the forms from the stored settings on GET; keep the posted values on POST.
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            var current = await Settings.GetViewAsync();
            Model.Projects = current.DevelopersCanManageProjects;
            Model.TestCases = current.DevelopersCanManageTestCases;
            Model.Defects = current.DevelopersCanManageDefects;
            UploadModel.MaxUploadMb = await Settings.GetMaxUploadMbAsync();
        }
    }

    private async Task SavePermissionsAsync()
    {
        await Settings.UpdateAsync(new SystemSettingsView(
            Model.Projects, Model.TestCases, Model.Defects));
        Nav.NavigateTo("admin?saved=true", forceLoad: true);
    }

    private async Task SaveUploadLimitAsync()
    {
        await Settings.UpdateMaxUploadMbAsync(UploadModel.MaxUploadMb);
        Nav.NavigateTo("admin?uploadSaved=true", forceLoad: true);
    }

    private async Task CheckForUpdatesAsync()
    {
        await UpdateCheck.CheckAsync(HttpContext.RequestAborted);
        Nav.NavigateTo("admin", forceLoad: true);
    }

    private static string Relative(DateTimeOffset when)
    {
        var delta = DateTimeOffset.UtcNow - when;
        return delta switch
        {
            { TotalMinutes: < 1 } => "just now",
            { TotalMinutes: < 60 } => $"{(int)delta.TotalMinutes} min ago",
            { TotalHours: < 24 } => $"{(int)delta.TotalHours} h ago",
            _ => $"{(int)delta.TotalDays} d ago",
        };
    }

    public sealed class DevPermissionsModel
    {
        public bool Projects { get; set; }
        public bool TestCases { get; set; }
        public bool Defects { get; set; }
    }

    public sealed class UploadLimitModel
    {
        public int MaxUploadMb { get; set; } = SystemSettings.DefaultMaxUploadMb;
    }

    public sealed class CheckUpdatesModel;
}
