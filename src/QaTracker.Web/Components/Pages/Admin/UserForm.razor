@page "/admin/users/new"
@page "/admin/users/{UserId}/edit"
@using System.ComponentModel.DataAnnotations
@using Microsoft.Extensions.DependencyInjection
@using QaTracker.Web.Auth
@inject UserService Users
@inject NavigationManager Nav
@inject IServiceProvider Services

<PageTitle>@(IsEdit ? "Edit user" : "New user") · System settings · QA Tracker</PageTitle>

@if (IsEdit && notFound)
{
    <h1>User not found</h1>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        <a href="admin/users">Back to users</a>.
    </p>
}
else
{
    <h1>@(IsEdit ? "Edit user" : "New user")</h1>

    @if (IsEdit)
    {
        <p class="mt-1 text-sm text-gray-500">Last sign-in: <span class="font-medium">@lastLogin</span></p>
    }

    @if (error is not null)
    {
        <div class="alert alert-danger mt-4">@error</div>
    }

    @if (isExternallyManaged)
    {
        <div class="alert mt-4 border border-gray-200 bg-gray-50 text-sm text-gray-600 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-400">
            This account is managed by @providerLabel. Its full name, password and roles are
            controlled by the identity provider. Deleting it here only removes the local
            record &mdash; the user is re-provisioned on their next SSO sign-in unless their
            access is revoked at the provider.
        </div>
    }

    <EditForm Model="Model" FormName="user" OnValidSubmit="SaveAsync" method="post" class="mt-6 max-w-lg space-y-6">
        <DataAnnotationsValidator />

        <div class="card space-y-4">
            <div>
                <label class="form-label" for="email">Email</label>
                <InputText id="email" @bind-Value="Model.Email" class="form-control" readonly="@IsEdit" />
                <ValidationMessage For="() => Model.Email" />
                @if (IsEdit && isExternallyManaged)
                {
                    <button type="button" class="btn-link mt-1 text-xs" data-dialog-open="change-email-modal">
                        Change email address
                    </button>
                }
            </div>

            <div>
                <label class="form-label" for="fullName">Full name</label>
                <InputText id="fullName" @bind-Value="Model.FullName" class="form-control" readonly="@isExternallyManaged" />
            </div>

            @if (!isExternallyManaged)
            {
                <div>
                    <label class="form-label" for="password">@(IsEdit ? "New password" : "Password")</label>
                    <InputText type="password" id="password" @bind-Value="Model.Password" class="form-control" />
                    @if (IsEdit)
                    {
                        <p class="mt-1 text-xs text-gray-400">Leave blank to keep the current password.</p>
                    }
                </div>
            }
        </div>

        <div class="card space-y-3">
            <h2>Role</h2>
            @if (isExternallyManaged)
            {
                <p class="text-xs text-gray-400">
                    Role is managed by @providerLabel — currently <span class="font-medium">@(Model.Role is { Length: > 0 } ? Model.Role : "none")</span>.
                </p>
            }
            else
            {
                <div>
                    <label class="form-label" for="role">Role</label>
                    <InputSelect id="role" @bind-Value="Model.Role" class="form-select">
                        <option value="">— Choose a role —</option>
                        @foreach (var role in Roles.All)
                        {
                            <option value="@role">@role</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Model.Role" />
                    <p class="mt-1 text-xs text-gray-400">A user is either a Developer or a QA — never both.</p>
                </div>
            }
        </div>

        <div class="flex items-center gap-3">
            @if (!isExternallyManaged)
            {
                <button type="submit" class="btn-primary">
                    @(IsEdit ? "Save changes" : "Create user")
                </button>
            }
            <a href="admin/users" class="btn-link">@(isExternallyManaged ? "Back" : "Cancel")</a>
        </div>
    </EditForm>

    @if (IsEdit && isExternallyManaged)
    {
        <dialog id="change-email-modal" data-dialog-autoopen="@reopenEmailModal"
                class="w-full max-w-md rounded-lg border border-gray-200 bg-white p-0 text-gray-900 shadow-xl
                       backdrop:bg-gray-900/40 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-100">
            <EditForm Model="EmailModel" FormName="change-email" OnValidSubmit="ChangeEmailAsync"
                      method="post" class="space-y-4 p-6">
                <DataAnnotationsValidator />

                <h2 class="text-base font-semibold">Change email address</h2>

                @if (emailError is not null)
                {
                    <div class="alert alert-danger">@emailError</div>
                }

                <div class="space-y-2 rounded-md border border-amber-300 bg-amber-50 p-3 text-xs
                            text-amber-900 dark:border-amber-900/60 dark:bg-amber-950/40 dark:text-amber-200">
                    <p>
                        Only do this to match a change <span class="font-semibold">already made in @providerLabel</span>.
                        The sign-in link uses the provider's account ID, not the email, so changing it here
                        does not break sign-in — but it does not update @providerLabel either.
                    </p>
                    <p>
                        If the in-app email stops matching @providerLabel, a future re-provision (for example
                        after the local record is deleted, or the account is re-linked) can create a
                        <span class="font-semibold">duplicate account</span> under the provider's email and
                        lose this user's history. Auto-linking an existing local account by email also relies
                        on the two matching.
                    </p>
                </div>

                <div>
                    <label class="form-label" for="new-email">New email address</label>
                    <InputText id="new-email" @bind-Value="EmailModel.NewEmail" class="form-control"
                               autocomplete="off" />
                    <ValidationMessage For="() => EmailModel.NewEmail" />
                    <p class="mt-1 text-xs text-gray-400">Current: <span class="font-medium">@Model.Email</span></p>
                </div>

                <label class="flex items-start gap-2 text-sm">
                    <InputCheckbox @bind-Value="EmailModel.Acknowledged" class="form-check-input mt-0.5" />
                    <span>I have already changed this user's email in @providerLabel and understand the implications above.</span>
                </label>
                <ValidationMessage For="() => EmailModel.Acknowledged" />

                <div class="flex justify-end gap-2">
                    <button type="button" class="btn-secondary" data-dialog-close>Cancel</button>
                    <button type="submit" class="btn-primary">Change email</button>
                </div>
            </EditForm>
        </dialog>
    }

    @if (IsEdit && !isSelf)
    {
        <details class="mt-4 max-w-lg">
            <summary role="button" class="cursor-pointer list-none text-sm text-red-600 dark:text-red-400 [&::-webkit-details-marker]:hidden">
                Delete user
            </summary>
            <EditForm Model="Model" FormName="delete-user" OnValidSubmit="DeleteAsync" method="post"
                      class="mt-2 flex items-center gap-3">
                <span class="text-sm text-gray-600 dark:text-gray-400">Delete this user?</span>
                <button type="submit" class="btn-danger">Yes, delete</button>
            </EditForm>
        </details>
    }
}

@code {
    [Parameter]
    public string? UserId { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "user")]
    private UserFormModel Model { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "change-email")]
    private ChangeEmailModel EmailModel { get; set; } = default!;

    private bool notFound;
    private bool isSelf;
    private bool isExternallyManaged;
    private bool reopenEmailModal;
    private string providerLabel = "SSO";
    private string lastLogin = "Never";
    private string? error;
    private string? emailError;

    private bool IsEdit => UserId is not null;

    protected override async Task OnParametersSetAsync()
    {
        Model ??= new();
        EmailModel ??= new();

        // Keep the change-email dialog open across a failed post so its validation
        // messages are visible (the re-rendered page would otherwise show it closed).
        reopenEmailModal = HttpMethods.IsPost(HttpContext.Request.Method)
            && HttpContext.Request.Form.TryGetValue("_handler", out var handler)
            && handler == "change-email";

        var currentUserId = (await AuthState).User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        isSelf = IsEdit && UserId == currentUserId;

        if (!IsEdit)
        {
            return;
        }

        var user = await Users.GetAsync(UserId!);
        if (user is null)
        {
            notFound = true;
            return;
        }

        lastLogin = user.LastLoginDisplay;
        isExternallyManaged = user.IsExternallyManaged;
        if (isExternallyManaged)
        {
            providerLabel = Services.GetService<OidcAuthSettings>()?.ProviderLabel
                ?? user.ExternalProvider ?? "SSO";
        }

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            Model.Email = user.Email;
            Model.FullName = user.FullName;
            Model.Role = user.Role ?? "";
        }
        else
        {
            // Email is read-only on edit; keep the stored value regardless of what was posted.
            Model.Email = user.Email;
        }
    }

    private async Task SaveAsync()
    {
        error = null;

        if (!IsEdit && string.IsNullOrEmpty(Model.Password))
        {
            error = "Password is required.";
            return;
        }

        var role = string.IsNullOrEmpty(Model.Role) ? null : Model.Role;
        var result = IsEdit
            ? await Users.UpdateAsync(UserId!, Model.FullName, role, Model.Password)
            : await Users.CreateAsync(Model.Email, Model.FullName, Model.Password!, role);

        if (!result.Succeeded)
        {
            error = string.Join(" ", result.Errors);
            return;
        }

        Nav.NavigateTo("admin/users");
    }

    private async Task DeleteAsync()
    {
        await Users.DeleteAsync(UserId!);
        Nav.NavigateTo("admin/users");
    }

    private async Task ChangeEmailAsync()
    {
        emailError = null;

        // Belt-and-braces: the [Range] validator already blocks an unchecked box.
        if (!EmailModel.Acknowledged)
        {
            emailError = "Confirm you understand before continuing.";
            return;
        }

        var result = await Users.ChangeExternalEmailAsync(UserId!, EmailModel.NewEmail);
        if (!result.Succeeded)
        {
            emailError = string.Join(" ", result.Errors);
            return;
        }

        Nav.NavigateTo("admin/users");
    }

    public sealed class UserFormModel
    {
        [Required]
        [EmailAddress]
        [MaxLength(256)]
        public string Email { get; set; } = "";

        [MaxLength(200)]
        public string? FullName { get; set; }

        public string? Password { get; set; }

        [Required(ErrorMessage = "Choose a role.")]
        public string Role { get; set; } = "";
    }

    public sealed class ChangeEmailModel
    {
        [Required(ErrorMessage = "Enter the new email address.")]
        [EmailAddress]
        [MaxLength(256)]
        public string NewEmail { get; set; } = "";

        [Range(typeof(bool), "true", "true", ErrorMessage = "Confirm you understand before continuing.")]
        public bool Acknowledged { get; set; }
    }
}
