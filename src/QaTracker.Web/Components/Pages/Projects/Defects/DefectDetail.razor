@page "/projects/{ProjectId:guid}/defects/{DefectId:guid}"
@using System.Globalization
@inject ProjectService Projects
@inject DefectService Defects
@inject TestScopeService Scopes
@inject UserDirectory Users
@inject AttachmentService AttachmentFiles
@inject QaTracker.Web.Admin.SystemSettingsService SettingsService

<PageTitle>@(defect is not null ? DefectDisplay.Ref(defect.Number) : "Defect") · QA Tracker</PageTitle>

@if (loaded && defect is null)
{
    <h1>Defect not found</h1>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        <a href="projects/@ProjectId/defects">Back to defects</a>.
    </p>
}
else if (defect is not null)
{
    <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
                <a href="projects/@ProjectId" class="no-underline hover:underline">@projectName</a>
                <span class="px-1">/</span>
                <a href="projects/@ProjectId/defects" class="no-underline hover:underline">Defects</a>
                <span class="px-1">/</span>
                <span class="font-mono">@DefectDisplay.Ref(defect.Number)</span>
            </p>
            <h1 class="whitespace-pre-wrap">@defect.Summary</h1>
        </div>
        <div class="flex shrink-0 gap-2">
            <button type="button" class="btn-secondary" data-dialog-open="history-modal">History</button>
            <AuthorizeView Policy="@Policies.ManageDefects">
                <a href="projects/@ProjectId/defects/@defect.Id/edit" class="btn-secondary">Edit</a>
            </AuthorizeView>
        </div>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-3">
        <AuthorizeView Roles="@Roles.QA">
            <Authorized>
                @* Labelled like the "Assigned to" line below, so the colour chips read as fields. *@
                <span class="inline-flex items-center gap-2" data-field="severity">
                    <span class="text-sm text-gray-500 dark:text-gray-400">Severity</span>
                    <StatusMenu Action="@($"projects/{ProjectId}/defects/{DefectId}/severity")"
                                FieldName="severity"
                                Label="Change severity"
                                Current="@defect.Severity.ToString()"
                                CurrentLabel="@DefectDisplay.SeverityLabel(defect.Severity)"
                                CurrentChipClass="@DefectDisplay.SeverityChipClass(defect.Severity)"
                                Options="severityOptions" />
                </span>
                <span class="inline-flex items-center gap-2" data-field="status">
                    <span class="text-sm text-gray-500 dark:text-gray-400">Status</span>
                    <StatusMenu Action="@($"projects/{ProjectId}/defects/{DefectId}/status")"
                                FieldName="status"
                                Current="@defect.Status.ToString()"
                                CurrentLabel="@DefectDisplay.StatusLabel(defect.Status)"
                                CurrentChipClass="@DefectDisplay.StatusChipClass(defect.Status)"
                                Options="statusOptions" />
                </span>

                @* QA verdict on a fix that's waiting to be checked. *@
                @if (defect.Status == DefectStatus.ToCheck)
                {
                    <form method="post" action="projects/@ProjectId/defects/@DefectId/reject-fix" class="inline">
                        <AntiforgeryToken />
                        <button type="submit" class="btn-secondary btn-sm">Not fixed</button>
                    </form>
                    <form method="post" action="projects/@ProjectId/defects/@DefectId/verify-fixed" class="inline">
                        <AntiforgeryToken />
                        <button type="submit" class="btn-primary btn-sm">Fixed</button>
                    </form>
                }
            </Authorized>
            <NotAuthorized>
                <span class="inline-flex items-center gap-2" data-field="severity">
                    <span class="text-sm text-gray-500 dark:text-gray-400">Severity</span>
                    <span class="@DefectDisplay.SeverityBadgeClass(defect.Severity)">@DefectDisplay.SeverityLabel(defect.Severity)</span>
                </span>
                <span class="inline-flex items-center gap-2" data-field="status">
                    <span class="text-sm text-gray-500 dark:text-gray-400">Status</span>
                    <span class="@DefectDisplay.StatusBadgeClass(defect.Status)">@DefectDisplay.StatusLabel(defect.Status)</span>
                </span>
            </NotAuthorized>
        </AuthorizeView>

        @* Developer fix workflow — same row as the status. Start fixing -> takes the defect
           + moves it to Fixing; Mark as fixed -> records the fixer, moves to To check, hands
           it to a random project QA. *@
        <AuthorizeView Roles="@Roles.Dev">
            @if (defect.Status == DefectStatus.NotFixed)
            {
                <form method="post" action="projects/@ProjectId/defects/@DefectId/start-fixing" class="inline">
                    <AntiforgeryToken />
                    <button type="submit" class="btn-primary btn-sm">Start fixing</button>
                </form>
            }
            else if (defect.Status == DefectStatus.Fixing)
            {
                <form method="post" action="projects/@ProjectId/defects/@DefectId/mark-fixed" class="inline">
                    <AntiforgeryToken />
                    <button type="submit" class="btn-primary btn-sm">Mark as fixed</button>
                </form>
            }
        </AuthorizeView>

        @* Step through your queue: defects assigned to you that are Not fixed, Fixing or To check,
           most severe first (the defects page's order). Mirrors the test-run Previous / Next. *@
        <nav class="ml-auto flex gap-2" aria-label="Assigned defect navigation">
            @if (navigation.Previous is { } previous)
            {
                <a href="projects/@ProjectId/defects/@previous.Id" class="btn-secondary btn-sm"
                   title="@($"{DefectDisplay.Ref(previous.Number)} {previous.Summary}")">&larr; Previous</a>
            }
            else
            {
                <button type="button" class="btn-secondary btn-sm" disabled>&larr; Previous</button>
            }
            <span class="self-center whitespace-nowrap text-xs text-gray-500 dark:text-gray-400" data-assigned-queue>
                @QueueLabel
            </span>
            @if (navigation.Next is { } next)
            {
                <a href="projects/@ProjectId/defects/@next.Id" class="btn-secondary btn-sm"
                   title="@($"{DefectDisplay.Ref(next.Number)} {next.Summary}")">Next &rarr;</a>
            }
            else
            {
                <button type="button" class="btn-secondary btn-sm" disabled>Next &rarr;</button>
            }
        </nav>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
        <span>Assigned to</span>
        @if (assigneeRole is not null)
        {
            <RoleBadge Role="@assigneeRole" />
        }
        <AuthorizeView Roles="@Roles.QA">
            <Authorized>
                <SelectMenu Action="@($"projects/{ProjectId}/defects/{DefectId}/assignee")"
                            FieldName="assigneeId"
                            Label="Change assignee"
                            Current="@(defect.AssignedToId ?? "")"
                            CurrentLabel="@assigneeName"
                            Options="assigneeOptions"
                            Hint="@(users.Count == 0 ? "Add a team member on the project dashboard to assign this defect." : null)" />
            </Authorized>
            <NotAuthorized>
                <span class="font-medium text-gray-700 dark:text-gray-300">@assigneeName</span>
            </NotAuthorized>
        </AuthorizeView>

        @* Self-service pickup / drop — available to any Dev or QA viewing the defect. *@
        @if (!string.IsNullOrEmpty(currentUserId))
        {
            if (defect.AssignedToId == currentUserId)
            {
                <form method="post" action="projects/@ProjectId/defects/@DefectId/assignee/self" class="inline">
                    <AntiforgeryToken />
                    <input type="hidden" name="assign" value="false" />
                    <button type="submit" class="btn-secondary px-2 py-1 text-xs">Unassign from me</button>
                </form>
            }
            else
            {
                <form method="post" action="projects/@ProjectId/defects/@DefectId/assignee/self" class="inline">
                    <AntiforgeryToken />
                    <input type="hidden" name="assign" value="true" />
                    <button type="submit" class="btn-secondary px-2 py-1 text-xs">Assign to me</button>
                </form>
            }
        }

        @if (fixedByName is not null)
        {
            <span>· fixed by <span class="font-medium text-gray-700 dark:text-gray-300">@fixedByName</span></span>
        }
        @if (testedByName is not null)
        {
            <span>· tested by <span class="font-medium text-gray-700 dark:text-gray-300">@testedByName</span></span>
        }
    </div>

    <PageContents Sections="ContentsSections()" />

    <div class="mt-6 space-y-6">
        @foreach (var (heading, body) in TextSections())
        {
            <div id="@PageSection.Slug(heading)" class="card scroll-mt-6">
                <h2>@heading</h2>
                @if (string.IsNullOrWhiteSpace(body))
                {
                    <p class="mt-2 text-sm text-gray-400">None recorded.</p>
                }
                else
                {
                    <p class="mt-2 whitespace-pre-wrap text-sm text-gray-700 dark:text-gray-300">@body</p>
                }
            </div>
        }

        <div id="files" class="card scroll-mt-6">
            <h2>Attachments</h2>
            <p class="text-xs text-gray-400">Screenshots, recordings, or other files showing the problem.</p>
            <div class="mt-3">
                <AttachmentPanel Owner="AttachmentOwner.Defect" OwnerId="defect.Id"
                                  CurrentUserId="@currentUserId" IsQa="isQa" ReturnUrl="@ReturnUrl" />
            </div>
        </div>

        <div id="linked-test-cases" class="card scroll-mt-6">
            <h2>Linked test cases</h2>
            @if (defect.TestCases.Count == 0)
            {
                <p class="mt-2 text-sm text-gray-400">No test cases linked.</p>
            }
            else
            {
                <ul class="mt-3 divide-y divide-gray-100 dark:divide-gray-800">
                    @foreach (var tc in defect.TestCases)
                    {
                        <li class="flex flex-wrap items-center gap-3 py-2" @key="tc.Id">
                            @* The case's current result, as on the test cases list. *@
                            <span class="@TestCaseDisplay.ResultBadgeClass(tc.Result) shrink-0" data-linked-result>
                                @TestCaseDisplay.ResultLabel(tc.Result)
                            </span>
                            <a href="projects/@ProjectId/test-cases/scopes/@tc.TestScopeId/cases/@tc.Id"
                               class="min-w-0 flex-1 truncate no-underline hover:underline">
                                @(tc.TestScope?.Name is { } n ? $"{n} / " : "")@tc.Scenario
                            </a>
                            <AuthorizeView Roles="@Roles.QA">
                                <form method="post" action="projects/@ProjectId/defects/@DefectId/test-cases/unlink" class="shrink-0">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="testCaseId" value="@tc.Id" />
                                    <button type="submit" class="btn-link text-xs">Unlink</button>
                                </form>
                            </AuthorizeView>
                        </li>
                    }
                </ul>
            }

            <AuthorizeView Roles="@Roles.QA">
                <div class="mt-4">
                    <button type="button" class="btn-secondary btn-sm" data-dialog-open="link-test-cases-modal">
                        Link test cases
                    </button>
                </div>
            </AuthorizeView>
        </div>

        <AuthorizeView Roles="@Roles.QA">
            <dialog id="link-test-cases-modal"
                    class="w-full max-w-2xl modal">
                <form method="post" action="projects/@ProjectId/defects/@DefectId/test-cases/link" class="space-y-5 p-6">
                    <AntiforgeryToken />
                    <h3 class="text-base font-semibold">Link test cases</h3>

                    @{
                        var linkable = LinkableCases()
                            .GroupBy(x => x.Scope)
                            .OrderBy(g => g.Key.Name, StringComparer.OrdinalIgnoreCase)
                            .ToList();
                    }
                    <div>
                        <p class="form-label">Existing test cases</p>
                        @if (linkable.Count == 0)
                        {
                            <p class="text-sm text-gray-400">Every test case in this project is already linked.</p>
                        }
                        else
                        {
                            <div class="max-h-72 overflow-y-auto rounded-md border border-gray-200 bg-gray-50 p-1
                                        dark:border-gray-800 dark:bg-gray-950/40">
                                @foreach (var group in linkable)
                                {
                                    <p class="px-2 pb-1 pt-2 text-xs font-semibold uppercase tracking-wide text-gray-400">
                                        @group.Key.Name · @TestCaseDisplay.KindLabel(group.Key.Kind)
                                    </p>
                                    <ul class="space-y-0.5">
                                        @foreach (var item in group.OrderBy(x => x.Case.Scenario, StringComparer.OrdinalIgnoreCase))
                                        {
                                            <li @key="item.Case.Id">
                                                <label class="flex cursor-pointer items-start gap-3 rounded-md px-2 py-1.5 text-sm
                                                              hover:bg-white dark:hover:bg-gray-800">
                                                    <input type="checkbox" name="testCaseIds" value="@item.Case.Id"
                                                           class="form-check-input mt-0.5" />
                                                    <span class="min-w-0 flex-1">@item.Case.Scenario</span>
                                                </label>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </div>

                    <div class="border-t border-gray-200 pt-4 dark:border-gray-800">
                        <a href="projects/@ProjectId/test-cases?fromDefect=@DefectId" class="btn-primary">
                            Create a new test case instead
                        </a>
                        <p class="mt-1.5 text-xs text-gray-400">
                            Opens the test cases list. The case you make there is prefilled with this
                            defect's summary and repro steps, and linked back here on save.
                        </p>
                    </div>

                    <div class="flex justify-end gap-2">
                        <button type="button" class="btn-secondary" data-dialog-close>Cancel</button>
                        @if (linkable.Count > 0)
                        {
                            <button type="submit" class="btn-primary">Link selected</button>
                        }
                    </div>
                </form>
            </dialog>
        </AuthorizeView>

        <div id="comments" class="card scroll-mt-6">
            <h2>Comments</h2>

            @{ var paged = PagedComments; }
            @if (comments.Count == 0)
            {
                <p class="mt-2 text-sm text-gray-400">No comments yet.</p>
            }
            else
            {
                <ul class="mt-3 space-y-3">
                    @foreach (var comment in paged.Items)
                    {
                        <li id="comment-@comment.Id" class="scroll-mt-20 rounded-md border border-gray-200 p-3 dark:border-gray-800" @key="comment.Id">
                            <div class="flex items-center justify-between gap-2 text-xs text-gray-500">
                                <span>
                                    <span class="font-medium text-gray-700 dark:text-gray-300">@comment.AuthorName</span>
                                    · @Format(comment.CreatedUtc)
                                </span>
                                @if (CanDelete(comment))
                                {
                                    <form method="post" action="projects/@ProjectId/defects/@DefectId/comments/@comment.Id/delete">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="commentsPage" value="@paged.ReturnPage" />
                                        <button type="submit" class="btn-link text-xs text-red-600 dark:text-red-400">Delete</button>
                                    </form>
                                }
                            </div>
                            <p class="mt-1 whitespace-pre-wrap text-sm text-gray-700 dark:text-gray-300"><CommentBody Body="@comment.Body" Names="teamNames" /></p>
                            <CommentAttachments Items="comment.Attachments" />
                            <CommentReactions Kind="CommentKind.Defect" CommentId="comment.Id" Reactions="comment.Reactions"
                                              CurrentUserId="@currentUserId" ReturnUrl="@(ReturnUrl + paged.ReturnQuery)" />
                        </li>
                    }
                </ul>
                <Pager ParamName="@CommentPaging.QueryParam" Current="paged.Current" TotalPages="paged.TotalPages"
                       TotalItems="paged.TotalItems" ItemNoun="comment" ItemNounPlural="comments" Label="Comment pages"
                       PreviousLabel="Older" NextLabel="Newer" Fragment="@CommentPaging.Anchor" ClearParams="commentPagerClears" />
            }

            <CommentComposer Action="@($"projects/{ProjectId}/defects/{DefectId}/comments")" MentionUsers="mentionUsers"
                             Placeholder="Progress, questions, verification notes…"
                             Error="@CommentError" ShowFiles="AttachmentFiles.StorageConfigured" MaxMb="commentFileMaxMb" />
        </div>
    </div>

    @* Large, scrollable modal: the header stays put while the timeline scrolls beneath it. The
       timeline is fetched when it opens (dialog.js data-lazy-src), so the page carries no hidden
       history text. *@
    <dialog id="history-modal" class="modal w-full max-w-3xl" aria-labelledby="history-modal-title"
            data-lazy-src="projects/@ProjectId/defects/@DefectId/history">
        <div class="flex max-h-[85vh] flex-col">
            <div class="flex items-start justify-between gap-3 border-b border-gray-200 px-6 py-4 dark:border-gray-800">
                <div class="min-w-0">
                    <h3 id="history-modal-title" class="text-base font-semibold">History</h3>
                    <p class="text-xs text-gray-400">Status changes, assignments, edits and files, and who made them.</p>
                </div>
                <button type="button" class="btn-secondary btn-sm shrink-0" data-dialog-close>Close</button>
            </div>
            <div class="overflow-y-auto px-6 py-4">
                <div data-lazy-content><p class="text-sm text-gray-400">Loading…</p></div>
            </div>
        </div>
    </dialog>
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [Parameter]
    public Guid DefectId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Defect? defect;
    private string projectName = "";
    private string assigneeName = "Unassigned";
    private string? assigneeRole;
    private string? fixedByName;
    private string? testedByName;
    private bool loaded;

    private static readonly IReadOnlyList<StatusMenu.Option> statusOptions =
        Enum.GetValues<DefectStatus>()
            .Select(s => new StatusMenu.Option(s.ToString(), DefectDisplay.StatusLabel(s), DefectDisplay.StatusChipClass(s)))
            .ToList();

    private static readonly IReadOnlyList<StatusMenu.Option> severityOptions =
        Enum.GetValues<DefectSeverity>()
            .Select(s => new StatusMenu.Option(s.ToString(), DefectDisplay.SeverityLabel(s), DefectDisplay.SeverityChipClass(s)))
            .ToList();

    private IReadOnlyList<TestScope> projectScopes = [];
    [SupplyParameterFromQuery(Name = "commentError")]
    private string? CommentError { get; set; }

    // Comment thread paging (CommentPaging): newest page by default, ?commentsPage=N for older ones.
    [SupplyParameterFromQuery(Name = CommentPaging.QueryParam)]
    private string? CommentsPage { get; set; }

    private CommentPage<DefectCommentView> PagedComments => CommentPaging.Slice(comments, CommentsPage);

    // One-off flags the comment pager's links shouldn't carry to the next page.
    private static readonly string[] commentPagerClears = ["commentError"];

    private long commentFileMaxMb;
    private IReadOnlyList<UserOption> mentionUsers = [];
    private IReadOnlyList<string> teamNames = [];
    private IReadOnlyList<DefectCommentView> comments = [];
    private DefectNavigation navigation = DefectNavigation.Empty;

    /// <summary>"2 of 5 assigned to you · 3 to fix · 2 to check" (position only when this defect is in the queue).</summary>
    private string QueueLabel
    {
        get
        {
            if (navigation.Count == 0)
            {
                return "Nothing assigned to you";
            }

            var text = navigation.Position is { } p
                ? $"{p} of {navigation.Count} assigned to you"
                : $"{navigation.Count} assigned to you";
            var toFix = navigation.NotFixed + navigation.Fixing;
            if (toFix > 0) text += $" · {toFix} to fix";
            if (navigation.ToCheck > 0) text += $" · {navigation.ToCheck} to check";
            return text;
        }
    }
    private IReadOnlyList<UserOption> users = [];

    private string currentUserId = "";
    private bool isQa;

    private string ReturnUrl => $"/projects/{ProjectId}/defects/{DefectId}";

    private IReadOnlyList<SelectMenu.Option> assigneeOptions =>
        new[] { new SelectMenu.Option("", "Unassigned") }
            .Concat(users.Select(u => new SelectMenu.Option(u.Id, u.DisplayName, u.Role)))
            .ToList();

    private HashSet<Guid> LinkedCaseIds => defect?.TestCases.Select(tc => tc.Id).ToHashSet() ?? [];

    protected override async Task OnParametersSetAsync()
    {
        var user = (await AuthState).User;
        currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        isQa = user.IsInRole(Roles.QA);

        var project = await Projects.GetAsync(ProjectId);
        if (project is null)
        {
            loaded = true;
            return;
        }
        projectName = project.Name;

        var found = await Defects.GetAsync(DefectId);
        defect = found is not null && found.ProjectId == ProjectId ? found : null;

        if (defect is not null)
        {
            assigneeName = DisplayNameOf(defect.AssignedTo);
            fixedByName = defect.FixedBy is null ? null : DisplayNameOf(defect.FixedBy);
            testedByName = defect.TestedBy is null ? null : DisplayNameOf(defect.TestedBy);
            projectScopes = await Scopes.ListForProjectAsync(ProjectId);
            comments = await Defects.ListCommentsAsync(DefectId);
            navigation = await Defects.GetAssignedNavigationAsync(ProjectId, DefectId, currentUserId);
            commentFileMaxMb = await SettingsService.GetMaxUploadMbAsync();
            var team = await Users.ListForProjectAsync(ProjectId);
            teamNames = team.Select(u => u.DisplayName).ToList();
            mentionUsers = team.Where(u => u.Id != currentUserId).ToList();
            if (isQa)
            {
                users = team;
            }

            if (defect.AssignedToId is not null)
            {
                assigneeRole = users.FirstOrDefault(u => u.Id == defect.AssignedToId)?.Role
                    ?? (await Users.GetAsync(defect.AssignedToId))?.Role;
            }
        }

        loaded = true;
    }

    private IEnumerable<(TestScope Scope, TestCase Case)> LinkableCases() =>
        projectScopes.SelectMany(s => s.Cases
            .Where(c => !LinkedCaseIds.Contains(c.Id))
            .Select(c => (s, c)));

    private bool CanDelete(DefectCommentView comment) => isQa || comment.AuthorId == currentUserId;

    // The "On this page" rail — mirrors the cards below the header, in order.
    private IReadOnlyList<PageSection> ContentsSections() =>
    [
        .. TextSections().Select(t => new PageSection(PageSection.Slug(t.Heading), t.Heading)),
        new PageSection("files", "Attachments"),
        new PageSection("linked-test-cases", "Linked test cases", defect?.TestCases.Count),
        new PageSection("comments", "Comments", comments.Count),
    ];

    // Simple-template defects show one "Description" card (stored as repro steps); expected /
    // actual still appear if they hold text from before the defect was switched to Simple.
    private IEnumerable<(string Heading, string? Body)> TextSections() =>
        defect?.Template == DefectTemplate.Simple
            ? new (string Heading, string? Body)[]
                {
                    ("Description", defect.ReproSteps),
                    ("Expected results", defect.ExpectedResults),
                    ("Actual results", defect.ActualResults),
                }.Where((t, i) => i == 0 || !string.IsNullOrWhiteSpace(t.Body))
            :
            [
                ("Repro steps", defect?.ReproSteps),
                ("Expected results", defect?.ExpectedResults),
                ("Actual results", defect?.ActualResults),
            ];

    private static string DisplayNameOf(ApplicationUser? user)
    {
        if (user is null)
        {
            return "Unassigned";
        }

        return !string.IsNullOrWhiteSpace(user.FullName)
            ? user.FullName!
            : user.UserName ?? "Unassigned";
    }

    private static string Format(DateTimeOffset utc) =>
        utc.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) + " UTC";
}
