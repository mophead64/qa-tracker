@page "/projects/{ProjectId:guid}/defects/new"
@page "/projects/{ProjectId:guid}/defects/{DefectId:guid}/edit"
@using System.ComponentModel.DataAnnotations
@attribute [Authorize(Policy = Policies.ManageDefects)]
@inject ProjectService Projects
@inject DefectService Defects
@inject TestScopeService Scopes
@inject TestCaseService TestCases
@inject UserDirectory Users
@inject NavigationManager Nav

<PageTitle>@(IsEdit ? "Edit defect" : "New defect") · QA Tracker</PageTitle>

@if (notFound)
{
    <h1>Not found</h1>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        <a href="projects/@ProjectId/defects">Back to defects</a>.
    </p>
}
else
{
    <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
        <a href="projects/@ProjectId/defects" class="no-underline hover:underline">Defects</a>
    </p>
    <h1>@(IsEdit ? "Edit defect" : "New defect")</h1>

    @if (linkedScenario is not null)
    {
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
            Will be linked to test case: <span class="font-medium">@linkedScenario</span>
        </p>
    }

    <EditForm Model="Model" FormName="defect" OnValidSubmit="HandleSubmitAsync" method="post"
              class="mt-6 max-w-2xl space-y-6">
        <DataAnnotationsValidator />

        <div class="card space-y-4">
            <div>
                <label class="form-label" for="summary">Summary</label>
                <InputText id="summary" @bind-Value="Model.Summary" class="form-control"
                           placeholder="Short statement of the problem" />
                <ValidationMessage For="() => Model.Summary" />
            </div>

            <div>
                <label class="form-label" for="repro">Repro steps</label>
                <InputTextArea id="repro" @bind-Value="Model.ReproSteps" rows="5" class="form-control"
                               placeholder="One step per line" />
            </div>

            <div>
                <label class="form-label" for="expected">Expected results</label>
                <InputTextArea id="expected" @bind-Value="Model.ExpectedResults" rows="3" class="form-control" />
            </div>

            <div>
                <label class="form-label" for="actual">Actual results</label>
                <InputTextArea id="actual" @bind-Value="Model.ActualResults" rows="3" class="form-control" />
            </div>

            <div>
                <label class="form-label" for="assignee">Assigned to</label>
                @if (users.Count == 0)
                {
                    <InputSelect id="assignee" @bind-Value="Model.AssignedToId" class="form-select" disabled>
                        <option value="">— Unassigned —</option>
                    </InputSelect>
                    <p class="mt-1 text-xs text-gray-400">
                        <a href="projects/@ProjectId">Add a team member to this project</a> to assign the defect.
                    </p>
                }
                else
                {
                    <InputSelect id="assignee" @bind-Value="Model.AssignedToId" class="form-select">
                        <option value="">— Unassigned —</option>
                        @foreach (var user in users)
                        {
                            <option value="@user.Id">@user.Label</option>
                        }
                        @if (staleAssignee is not null)
                        {
                            <option value="@staleAssignee.Id">@staleAssignee.DisplayName (no longer on the team)</option>
                        }
                    </InputSelect>
                }
            </div>
        </div>

        <div class="flex items-center gap-3">
            <button type="submit" class="btn-primary">
                @(IsEdit ? "Save changes" : "Create defect")
            </button>
            <a href="@CancelUrl" class="btn-link">Cancel</a>
        </div>
    </EditForm>

    @if (IsEdit)
    {
        <details class="mt-4 max-w-2xl">
            <summary role="button" class="cursor-pointer list-none text-sm text-red-600 dark:text-red-400 [&::-webkit-details-marker]:hidden">
                Delete defect
            </summary>
            <EditForm Model="Model" FormName="delete-defect" OnValidSubmit="DeleteAsync" method="post"
                      class="mt-2 flex items-center gap-3">
                <span class="text-sm text-gray-600 dark:text-gray-400">Delete this defect?</span>
                <button type="submit" class="btn-danger">Yes, delete</button>
            </EditForm>
        </details>
    }
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [Parameter]
    public Guid? DefectId { get; set; }

    [SupplyParameterFromQuery]
    public Guid? TestCaseId { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "defect")]
    private DefectFormModel Model { get; set; } = default!;

    private IReadOnlyList<UserOption> users = [];

    /// <summary>The current assignee when they've since been removed from the project team —
    /// kept as a picker option so editing the defect doesn't silently drop the assignment.</summary>
    private UserOption? staleAssignee;
    private bool notFound;

    private Guid? linkTestCaseId;
    private string? linkedScenario;

    private bool IsEdit => DefectId is not null;
    private string CancelUrl => IsEdit ? $"projects/{ProjectId}/defects/{DefectId}" : $"projects/{ProjectId}/defects";

    protected override async Task OnParametersSetAsync()
    {
        Model ??= new();

        var project = await Projects.GetAsync(ProjectId);
        if (project is null)
        {
            notFound = true;
            return;
        }

        users = await Users.ListForProjectAsync(ProjectId);

        var isGet = HttpMethods.IsGet(HttpContext.Request.Method);

        if (IsEdit)
        {
            var defect = await Defects.GetAsync(DefectId!.Value);
            if (defect is null || defect.ProjectId != ProjectId)
            {
                notFound = true;
                return;
            }

            if (isGet)
            {
                Model.Summary = defect.Summary;
                Model.ReproSteps = defect.ReproSteps;
                Model.ExpectedResults = defect.ExpectedResults;
                Model.ActualResults = defect.ActualResults;
                Model.AssignedToId = defect.AssignedToId ?? "";
            }

            // Keep an already-assigned user in the picker even if they've left the team.
            if (!string.IsNullOrEmpty(Model.AssignedToId) && users.All(u => u.Id != Model.AssignedToId))
            {
                staleAssignee = await Users.GetAsync(Model.AssignedToId);
            }
            return;
        }

        // New defect raised from a test case: prefill and remember to link on save.
        if (TestCaseId is { } tcId)
        {
            var testCase = await TestCases.GetAsync(tcId);
            if (testCase is not null)
            {
                var scope = await Scopes.GetAsync(testCase.TestScopeId);
                if (scope is not null && scope.ProjectId == ProjectId)
                {
                    linkTestCaseId = tcId;
                    linkedScenario = testCase.Scenario;
                    if (isGet)
                    {
                        Model.Summary = testCase.Scenario;
                        Model.ReproSteps = testCase.Steps;
                    }
                }
            }
        }
    }

    private async Task HandleSubmitAsync()
    {
        var input = new DefectInput(
            Model.Summary,
            Model.ReproSteps,
            Model.ExpectedResults,
            Model.ActualResults,
            string.IsNullOrWhiteSpace(Model.AssignedToId) ? null : Model.AssignedToId);

        var user = await GetUserIdAsync();

        if (IsEdit)
        {
            await Defects.UpdateAsync(DefectId!.Value, input, user);
            Nav.NavigateTo($"projects/{ProjectId}/defects/{DefectId}");
        }
        else
        {
            var created = await Defects.CreateAsync(ProjectId, input, user);
            if (linkTestCaseId is { } tcId)
            {
                await Defects.LinkTestCaseAsync(created.Id, tcId);
            }
            Nav.NavigateTo($"projects/{ProjectId}/defects/{created.Id}");
        }
    }

    private async Task DeleteAsync()
    {
        await Defects.DeleteAsync(DefectId!.Value);
        Nav.NavigateTo($"projects/{ProjectId}/defects");
    }

    private async Task<string> GetUserIdAsync()
    {
        var user = (await AuthState).User;
        return user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? throw new InvalidOperationException("No user id on the current principal.");
    }

    public sealed class DefectFormModel
    {
        [Required]
        public string Summary { get; set; } = string.Empty;

        public string? ReproSteps { get; set; }
        public string? ExpectedResults { get; set; }
        public string? ActualResults { get; set; }
        public string AssignedToId { get; set; } = "";
    }
}
