@page "/projects/{ProjectId:guid}/defects"
@inject ProjectService Projects
@inject DefectService Defects
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@inject IConfiguration Configuration

<PageTitle>Defects · @(project?.Name ?? "Project") · QA Tracker</PageTitle>

@if (loaded && project is null)
{
    <h1>Project not found</h1>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        <a href="projects">Back to all projects</a>.
    </p>
}
else if (project is not null)
{
    @* Live page (live-page.js): the filter posts in place, and defects raised, moved on or
       reassigned by other people appear on their own — polled via /projects/{p}/defects/live. *@
    <div id="live-defects" data-live-page data-live-region
         data-live-version-src="@AppUrls.DefectsLive(project.Id)" data-live-version="@liveVersion"
         data-live-poll-seconds="@LiveVersion.PollSeconds(Configuration)">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="min-w-0">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
                <a href="projects/@project.Id" class="no-underline hover:underline">@project.Name</a>
            </p>
            <h1>Defects</h1>
        </div>
        <AuthorizeView Policy="@Policies.ManageDefects">
            <a href="projects/@project.Id/defects/new" class="btn-primary">New defect</a>
        </AuthorizeView>
    </div>

    @if (defects.Count == 0)
    {
        <div class="card mt-6 text-center">
            <p class="text-sm text-gray-600 dark:text-gray-400">No defects yet.</p>
            <AuthorizeView Policy="@Policies.ManageDefects">
                <Authorized>
                    <p class="mt-1 text-xs text-gray-400">Raise one here, or from a failing test case.</p>
                    <a href="projects/@project.Id/defects/new" class="btn-primary mt-4">Raise the first defect</a>
                </Authorized>
                <NotAuthorized>
                    <p class="mt-1 text-xs text-gray-400">Defects will appear here once they've been raised.</p>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    }
    else
    {
        @* Per-user filter (remembered across projects, like the test cases and All Projects
           dropdowns). It narrows the defects first; the groups below are built from what's left. *@
        <div class="mt-4 flex flex-wrap items-center gap-3" data-defect-filter>
            <SelectMenu Action="@AppUrls.DefectFilterPreference"
                        Large="true"
                        FieldName="filter"
                        Label="Filter defects"
                        Current="@(((int)filter).ToString())"
                        CurrentLabel="@DefectListFilters.Label(filter)"
                        Options="filterOptions"
                        HiddenFields="returnFields" />
            @if (filter != DefectListFilter.All)
            {
                <span class="text-sm text-gray-500 dark:text-gray-400" data-filter-summary>
                    Showing @visible.Count of @defects.Count @(defects.Count == 1 ? "defect" : "defects")
                </span>
            }
        </div>

        @if (visible.Count == 0)
        {
            <div class="card mt-6 text-center">
                <p class="text-sm text-gray-600 dark:text-gray-400">No defects match “@DefectListFilters.Label(filter)”.</p>
                <form method="post" action="@AppUrls.DefectFilterPreference" class="mt-3">
                    <AntiforgeryToken />
                    <input type="hidden" name="filter" value="@((int)DefectListFilter.All)" />
                    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                    <button type="submit" class="btn-secondary">Show all defects</button>
                </form>
            </div>
        }

        var buckets = Sections().ToList();
        <PageContents Sections="@(buckets.Select(b => new PageSection(PageSection.Slug(b.Title), b.Title, b.Rows.Count)).ToList())" />

        <div class="mt-6 space-y-6">
            @foreach (var bucket in buckets)
            {
                <div id="@PageSection.Slug(bucket.Title)"
                     class="scroll-mt-6 overflow-hidden rounded-lg border bg-white shadow-sm dark:bg-gray-900 @bucket.BorderClass"
                     @key="bucket.Title">
                    <div class="flex items-center gap-2 border-b border-gray-200 px-5 py-3 dark:border-gray-800">
                        <h2 class="text-base">@bucket.Title</h2>
                        <span class="badge badge-gray">@bucket.Rows.Count</span>
                        @if (bucket.Hint is not null)
                        {
                            <span class="text-xs text-gray-400">@bucket.Hint</span>
                        }
                    </div>
                    <ul class="divide-y divide-gray-100 dark:divide-gray-800 @(bucket.Muted ? "opacity-60" : "")">
                        @foreach (var defect in bucket.Rows)
                        {
                            @Row(defect)
                        }
                    </ul>
                </div>
            }
        </div>
    }
    </div>
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Project? project;
    private IReadOnlyList<Defect> defects = [];
    private IReadOnlyList<Defect> visible = [];
    private DefectListFilter filter = DefectListFilter.All;

    private static readonly IReadOnlyList<SelectMenu.Option> filterOptions =
        DefectListFilters.Ordered
            .Select(f => new SelectMenu.Option(((int)f).ToString(), DefectListFilters.Label(f),
                Description: DefectListFilters.Hint(f),
                // All / Open / Closed first, then a divider before the single statuses.
                DividerBefore: f == DefectListFilters.FirstStatus))
            .ToList();

    private string ReturnUrl => $"/projects/{ProjectId}/defects";

    private IReadOnlyDictionary<string, string?> returnFields =>
        new Dictionary<string, string?> { ["returnUrl"] = ReturnUrl };
    private string currentUserId = "";
    private bool loaded;

    private string? liveVersion;

    protected override async Task OnParametersSetAsync()
    {
        // Stamp before loading, so a change made meanwhile shows up on the next poll.
        liveVersion = await Defects.GetListLiveVersionAsync(ProjectId);
        currentUserId = (await AuthState).User
            .FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";

        project = await Projects.GetAsync(ProjectId);
        if (project is not null)
        {
            defects = await Defects.ListForProjectAsync(ProjectId);
            filter = (await UserManager.GetUserAsync((await AuthState).User))?.DefectListFilter ?? DefectListFilter.All;
            visible = defects.Where(d => filter.Matches(d.Status)).ToList();
        }
        loaded = true;
    }

    // visible (defects after the filter) keeps the most-severe-first then number order; each section keeps it too.
    private IEnumerable<SectionGroup> Sections()
    {
        bool Open(Defect d) => d.Status is not (DefectStatus.Fixed or DefectStatus.NotADefect);
        bool Mine(Defect d) => d.AssignedToId is not null && d.AssignedToId == currentUserId;

        var toVerify = visible.Where(d => Mine(d) && d.Status == DefectStatus.ToCheck).ToList();
        var toFix = visible.Where(d => Mine(d) && d.Status is DefectStatus.NotFixed or DefectStatus.Fixing).ToList();
        var unassigned = visible.Where(d => d.AssignedToId is null && Open(d)).ToList();
        var mineIds = toVerify.Concat(toFix).Select(d => d.Id).ToHashSet();
        var otherOpen = visible.Where(d => Open(d) && d.AssignedToId is not null && !mineIds.Contains(d.Id)).ToList();
        var closed = visible.Where(d => !Open(d)).ToList();

        var all = new[]
        {
            new SectionGroup("To verify", "assigned to you · to check", toVerify, "border-brand-300 dark:border-brand-800", false),
            new SectionGroup("To fix", "assigned to you · not fixed", toFix, "border-brand-300 dark:border-brand-800", false),
            new SectionGroup("Unassigned", null, unassigned, "border-gray-200 dark:border-gray-800", false),
            new SectionGroup("Other open defects", null, otherOpen, "border-gray-200 dark:border-gray-800", false),
            new SectionGroup("Closed defects", "fixed · not a defect", closed, "border-gray-200 dark:border-gray-800", true),
        };

        return all.Where(s => s.Rows.Count > 0);
    }

    private sealed record SectionGroup(
        string Title, string? Hint, IReadOnlyList<Defect> Rows, string BorderClass, bool Muted);

    private RenderFragment<Defect> Row => defect =>
        @<li class="flex flex-wrap items-center gap-3 px-5 py-3" @key="defect.Id">
            <span class="shrink-0 font-mono text-xs text-gray-400">@DefectDisplay.Ref(defect.Number)</span>
            <span class="@DefectDisplay.SeverityBadgeClass(defect.Severity) shrink-0">
                @DefectDisplay.SeverityLabel(defect.Severity)
            </span>
            <span class="@DefectDisplay.StatusBadgeClass(defect.Status) shrink-0">
                @DefectDisplay.StatusLabel(defect.Status)
            </span>
            <a href="projects/@ProjectId/defects/@defect.Id"
               class="min-w-0 flex-1 truncate font-medium no-underline hover:underline">
                @defect.Summary
            </a>
            @if (defect.TestCases.Count > 0)
            {
                @* The linked test cases' IDs (up to three, then "+n"); the tooltip names them all. *@
                var linked = defect.TestCases.OrderBy(tc => tc.Number).ToList();
                <span class="shrink-0 whitespace-nowrap font-mono text-xs text-gray-400" data-linked-cases
                      title="@($"Linked to {string.Join(", ", linked.Select(TestCaseDisplay.CaseLabel))}")">
                    @string.Join(", ", linked.Take(3).Select(tc => TestCaseDisplay.CaseRef(tc.Number)))@(linked.Count > 3 ? $" +{linked.Count - 3}" : "")
                </span>
            }
            <span class="shrink-0 text-xs text-gray-500 dark:text-gray-400">@AssigneeName(defect)</span>
        </li>;

    private static string AssigneeName(Defect defect)
    {
        if (defect.AssignedTo is null)
        {
            return "Unassigned";
        }

        return !string.IsNullOrWhiteSpace(defect.AssignedTo.FullName)
            ? defect.AssignedTo.FullName!
            : defect.AssignedTo.UserName ?? "Unassigned";
    }
}
