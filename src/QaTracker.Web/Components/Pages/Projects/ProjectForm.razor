@page "/projects/new"
@page "/projects/{ProjectId:guid}/edit"
@using System.ComponentModel.DataAnnotations
@attribute [Authorize(Policy = Policies.ManageProjects)]
@inject ProjectService Projects
@inject UserDirectory Users
@inject NavigationManager Nav

<PageTitle>@(IsEdit ? "Edit project" : "New project") · QA Tracker</PageTitle>

@if (IsEdit && notFound)
{
    <h1>Project not found</h1>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        <a href="projects">Back to all projects</a>.
    </p>
}
else
{
    <h1>@(IsEdit ? "Edit project" : "New project")</h1>

    <EditForm EditContext="editContext" FormName="project" OnSubmit="HandleSubmitAsync" method="post"
              class="mt-6 max-w-2xl space-y-6">
        <DataAnnotationsValidator />

        <div class="card space-y-4">
            <div>
                <label class="form-label" for="name">Name</label>
                <InputText id="name" @bind-Value="Model.Name" class="form-control" />
                <ValidationMessage For="() => Model.Name" />
            </div>

            <div>
                <label class="form-label" for="notes">Notes</label>
                <InputTextArea id="notes" @bind-Value="Model.Notes" rows="6" class="form-control" />
            </div>

            @if (IsEdit)
            {
                <div>
                    <label class="form-label" for="status">Status</label>
                    <InputSelect id="status" @bind-Value="Model.Status" class="form-select">
                        @foreach (var status in Enum.GetValues<ProjectStatus>())
                        {
                            <option value="@status">@ProjectStatusDisplay.Label(status)</option>
                        }
                    </InputSelect>
                    <p class="mt-1 text-xs text-gray-400">
                        "Active" is set automatically once work starts; you can override it here.
                    </p>
                </div>
            }
        </div>

        <div class="card space-y-3">
            <div class="flex items-center justify-between">
                <h2>Custom links</h2>
                <button type="submit" name="Model.Op" value="add-link" formnovalidate class="btn-secondary">Add link</button>
            </div>
            <p class="text-xs text-gray-400">
                Shown as buttons on the project dashboard. Use http(s) or mailto URLs.
            </p>

            @if (Model.Links.Count == 0)
            {
                <p class="text-sm text-gray-400">No links.</p>
            }
            else
            {
                @for (var i = 0; i < Model.Links.Count; i++)
                {
                    var index = i;
                    <div class="flex flex-wrap items-start gap-2 sm:flex-nowrap" @key="index">
                        <InputText class="form-control sm:w-40" placeholder="Label" @bind-Value="Model.Links[index].Label" />
                        <InputText class="form-control flex-1" placeholder="https://…" @bind-Value="Model.Links[index].Url" />
                        <button type="submit" name="Model.Op" value="remove-link-@index" formnovalidate class="btn-secondary">
                            Remove
                        </button>
                    </div>
                }
            }

            @if (linkError is not null)
            {
                <p class="text-sm text-red-600 dark:text-red-400">@linkError</p>
            }
        </div>

        <div class="card space-y-3">
            <h2>Team</h2>
            <p class="text-xs text-gray-400">
                QA and Dev users assigned to this project. Shown on the dashboard and as
                "your projects" on the all-projects page.
            </p>

            @if (Model.MemberIds.Count == 0)
            {
                <p class="text-sm text-gray-400">No team members yet.</p>
            }
            else
            {
                <ul class="space-y-2">
                    @for (var i = 0; i < Model.MemberIds.Count; i++)
                    {
                        var index = i;
                        var memberId = Model.MemberIds[index];
                        <li class="flex items-center justify-between gap-2" @key="memberId">
                            <span class="text-sm text-gray-700 dark:text-gray-300">
                                @(users.FirstOrDefault(u => u.Id == memberId)?.Label ?? memberId)
                            </span>
                            <input type="hidden" name="Model.MemberIds[@index]" value="@memberId" />
                            <button type="submit" name="Model.Op" value="remove-member-@index" formnovalidate class="btn-link text-xs">
                                Remove
                            </button>
                        </li>
                    }
                </ul>
            }

            <div class="flex flex-wrap items-center gap-2">
                <select name="Model.NewMemberId" aria-label="Add a team member" class="form-select sm:w-80">
                    <option value="">— Add a team member —</option>
                    @foreach (var user in users.Where(u => !Model.MemberIds.Contains(u.Id)))
                    {
                        <option value="@user.Id">@user.Label</option>
                    }
                </select>
                <button type="submit" name="Model.Op" value="add-member" formnovalidate class="btn-secondary">
                    Add member
                </button>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <button type="submit" name="Model.Op" value="save" class="btn-primary">
                @(IsEdit ? "Save changes" : "Create project")
            </button>
            <a href="@CancelUrl" class="btn-link">Cancel</a>
        </div>
    </EditForm>

    @if (IsEdit)
    {
        <details class="mt-4 max-w-2xl">
            <summary role="button" class="cursor-pointer list-none text-sm text-red-600 dark:text-red-400 [&::-webkit-details-marker]:hidden">
                Delete project
            </summary>
            <EditForm Model="Model" FormName="delete-project" OnValidSubmit="DeleteAsync" method="post"
                      class="mt-2 flex items-center gap-3">
                <span class="text-sm text-gray-600 dark:text-gray-400">Delete this project?</span>
                <button type="submit" class="btn-danger">Yes, delete</button>
            </EditForm>
        </details>
    }
}

@code {
    [Parameter]
    public Guid? ProjectId { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "project")]
    private ProjectFormModel Model { get; set; } = default!;

    private EditContext editContext = default!;
    private IReadOnlyList<UserOption> users = [];
    private bool notFound;
    private string? linkError;

    private bool IsEdit => ProjectId is not null;
    private string CancelUrl => IsEdit ? $"projects/{ProjectId}" : "projects";

    protected override async Task OnParametersSetAsync()
    {
        Model ??= new();
        Model.Links ??= [];
        Model.MemberIds ??= [];
        editContext = new EditContext(Model);

        users = await Users.ListAssignableAsync();

        if (!IsEdit)
        {
            return;
        }

        var project = await Projects.GetAsync(ProjectId!.Value);
        if (project is null)
        {
            notFound = true;
            return;
        }

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            Model.Name = project.Name;
            Model.Notes = project.Notes;
            Model.Status = project.Status;
            Model.Links = project.Links.Select(l => new LinkRow { Label = l.Label, Url = l.Url }).ToList();
            Model.MemberIds = project.Members.Select(m => m.Id).ToList();
        }
    }

    private async Task HandleSubmitAsync()
    {
        var op = Model.Op;
        Model.Op = null;
        Model.Links ??= [];
        Model.MemberIds ??= [];

        switch (op)
        {
            case "add-link":
                Model.Links.Add(new LinkRow());
                return;
            case "add-member":
                if (!string.IsNullOrEmpty(Model.NewMemberId) && !Model.MemberIds.Contains(Model.NewMemberId))
                {
                    Model.MemberIds.Add(Model.NewMemberId);
                }
                Model.NewMemberId = "";
                return;
            case not null when op.StartsWith("remove-link-", StringComparison.Ordinal):
                RemoveAt(Model.Links, op["remove-link-".Length..]);
                return;
            case not null when op.StartsWith("remove-member-", StringComparison.Ordinal):
                RemoveAt(Model.MemberIds, op["remove-member-".Length..]);
                return;
        }

        if (!editContext.Validate())
        {
            return;
        }

        linkError = null;
        var links = new List<ProjectLinkInput>();
        foreach (var row in Model.Links)
        {
            var label = row.Label?.Trim() ?? "";
            var url = row.Url?.Trim() ?? "";
            if (label.Length == 0 && url.Length == 0)
            {
                continue;
            }

            if (label.Length == 0 || url.Length == 0)
            {
                linkError = "Each link needs both a label and a URL.";
                return;
            }

            if (!IsAllowedUrl(url))
            {
                linkError = $"\"{url}\" is not a valid http(s) or mailto URL.";
                return;
            }

            links.Add(new ProjectLinkInput(label, url));
        }

        if (IsEdit)
        {
            await Projects.UpdateAsync(ProjectId!.Value, Model.Name, Model.Notes, Model.Status, links, Model.MemberIds);
            Nav.NavigateTo($"projects/{ProjectId}");
        }
        else
        {
            var user = await GetUserIdAsync();
            var created = await Projects.CreateAsync(Model.Name, Model.Notes, links, user, Model.MemberIds);
            // Full reload so the switch endpoint makes the new project current before the dashboard renders.
            Nav.NavigateTo($"projects/switch?created={created.Id}", forceLoad: true);
        }
    }

    private async Task DeleteAsync()
    {
        await Projects.DeleteAsync(ProjectId!.Value);
        Nav.NavigateTo("projects");
    }

    private static void RemoveAt<T>(List<T> list, string rawIndex)
    {
        if (int.TryParse(rawIndex, out var i) && i >= 0 && i < list.Count)
        {
            list.RemoveAt(i);
        }
    }

    private async Task<string> GetUserIdAsync()
    {
        var user = (await AuthState).User;
        return user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? throw new InvalidOperationException("No user id on the current principal.");
    }

    private static bool IsAllowedUrl(string url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var uri)
        && uri.Scheme is "http" or "https" or "mailto";

    public sealed class ProjectFormModel
    {
        [Required]
        [MaxLength(200)]
        public string Name { get; set; } = string.Empty;

        public string? Notes { get; set; }

        public ProjectStatus Status { get; set; } = ProjectStatus.NotStarted;

        public List<LinkRow> Links { get; set; } = [];

        public List<string> MemberIds { get; set; } = [];

        public string? NewMemberId { get; set; }

        // Which submit button was pressed: "save", "add-link", "add-member", "remove-link-{i}", "remove-member-{i}".
        public string? Op { get; set; }
    }

    public sealed class LinkRow
    {
        public string? Label { get; set; }
        public string? Url { get; set; }
    }
}
