@page "/projects/new"
@page "/projects/{ProjectId:guid}/edit"
@using System.ComponentModel.DataAnnotations
@attribute [Authorize(Policy = Policies.ManageProjects)]
@inject ProjectService Projects
@inject TestScopeService TestScopes
@inject DefectService Defects
@inject QaTracker.Web.Admin.SystemSettingsService Settings
@inject NavigationManager Nav

<PageTitle>@(IsEdit ? "Edit project" : "New project") · QA Tracker</PageTitle>

@if (IsEdit && notFound)
{
    <h1>Project not found</h1>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        <a href="projects">Back to all projects</a>.
    </p>
}
else
{
    <h1>@(IsEdit ? "Edit project" : "New project")</h1>

    <EditForm EditContext="editContext" FormName="project" OnSubmit="HandleSubmitAsync" method="post"
              class="mt-6 max-w-2xl space-y-6">
        <DataAnnotationsValidator />

        <div class="card space-y-4">
            <div>
                <label class="form-label" for="name">Name</label>
                <InputText id="name" @bind-Value="Model.Name" class="form-control" />
                <ValidationMessage For="() => Model.Name" />
            </div>

            <div>
                <label class="form-label" for="brief">Brief</label>
                <InputText id="brief" @bind-Value="Model.Brief" class="form-control" maxlength="280"
                           placeholder="One-line summary of the project" />
                <p class="mt-1 text-xs text-gray-400">Shown under the project name on the projects list.</p>
                <ValidationMessage For="() => Model.Brief" />
            </div>

            <div>
                <label class="form-label" for="notes">Notes</label>
                <InputTextArea id="notes" @bind-Value="Model.Notes" rows="6" class="form-control" />
                <p class="mt-1 text-xs text-gray-400">Fuller detail shown on the project dashboard.</p>
            </div>

            @if (!IsEdit)
            {
                <FormTip>
                    Once the project is created you can add its team, upload reference files and start adding
                    test scopes from its dashboard. Everything here can be changed later.
                </FormTip>
            }
        </div>

        @* Testing window + effort estimates. Days count weekdays only, in half-day steps; the
           "x days" label beside the project status comes from here (see QaEffort). *@
        <div class="card space-y-4" id="schedule">
            <div>
                <h2>Testing schedule</h2>
                <p class="mt-1 text-xs text-gray-400">
                    Optional. Days count weekdays only. Tick a midday box to count that day as half a day.
                </p>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label class="form-label" for="testing-start">Testing start date</label>
                    <InputDate id="testing-start" @bind-Value="Model.TestingStart" class="form-control" />
                    <label class="mt-2 flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
                        <InputCheckbox @bind-Value="Model.StartsMidday" class="form-check-input" id="testing-starts-midday" />
                        Starts at midday
                    </label>
                </div>
                <div>
                    <label class="form-label" for="testing-end">Testing end date</label>
                    <InputDate id="testing-end" @bind-Value="Model.TestingEnd" class="form-control" />
                    <label class="mt-2 flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
                        <InputCheckbox @bind-Value="Model.EndsMidday" class="form-check-input" id="testing-ends-midday" />
                        Ends at midday
                    </label>
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-3">
                <div>
                    <label class="form-label" for="dev-days">Estimated dev days</label>
                    <InputNumber id="dev-days" @bind-Value="Model.EstimatedDevDays" class="form-control"
                                 min="0.5" max="@QaEffort.MaxDays" step="0.5" />
                </div>
                <div>
                    <label class="form-label" for="qa-percent">QA % of dev</label>
                    <InputNumber id="qa-percent" @bind-Value="Model.QaPercent" class="form-control"
                                 min="@QaEffort.MinPercent" max="@QaEffort.MaxPercent" step="1"
                                 placeholder="@($"{systemPercent} (default)")" />
                </div>
                <div>
                    <label class="form-label" for="qa-days">Estimated QA days</label>
                    <InputNumber id="qa-days" @bind-Value="Model.EstimatedQaDays" class="form-control"
                                 min="0.5" max="@QaEffort.MaxDays" step="0.5" placeholder="From the %" />
                </div>
            </div>
            <p class="text-xs text-gray-400">
                The QA estimate is dev days × the percentage (@systemPercent% unless you set one here),
                rounded to the nearest half day. Type a QA figure to use that instead.
            </p>

            @if (scheduleError is not null)
            {
                <p class="text-sm text-red-600 dark:text-red-400" data-schedule-error>@scheduleError</p>
            }
        </div>

        <div class="card space-y-3" id="defect-template">
            <div>
                <h2>Defect template</h2>
                <p class="mt-1 text-xs text-gray-400">
                    The fields new defects in this project start with. Whoever raises a defect can still switch it.
                </p>
            </div>
            <DefectTemplatePicker Name="Model.DefectTemplate" Current="@Model.DefectTemplate" Label="Project defect template"
                                  InheritLabel="@($"System default ({DefectTemplates.Label(systemTemplate)})")" />
        </div>

        <div class="card space-y-3">
            <div class="flex items-center justify-between">
                <h2>Custom links</h2>
                <button type="submit" name="Model.Op" value="add-link" formnovalidate class="btn-secondary">Add link</button>
            </div>
            <p class="text-xs text-gray-400">
                Shown as buttons on the project dashboard. Use http(s) or mailto URLs.
            </p>

            @if (Model.Links.Count == 0)
            {
                <p class="text-sm text-gray-400">No links.</p>
            }
            else
            {
                @for (var i = 0; i < Model.Links.Count; i++)
                {
                    var index = i;
                    <div class="flex flex-wrap items-start gap-2 sm:flex-nowrap" @key="index">
                        <InputText class="form-control sm:w-40" placeholder="Label" @bind-Value="Model.Links[index].Label" />
                        <InputText class="form-control flex-1" placeholder="https://…" @bind-Value="Model.Links[index].Url" />
                        <button type="submit" name="Model.Op" value="remove-link-@index" formnovalidate class="btn-secondary">
                            Remove
                        </button>
                    </div>
                }
            }

            @if (linkError is not null)
            {
                <p class="text-sm text-red-600 dark:text-red-400">@linkError</p>
            }
        </div>

        @if (IsEdit)
        {
            <p class="text-xs text-gray-400">
                Manage this project's status and team from its dashboard.
            </p>
        }

        @* The form spans several cards, so its footer is a bar of its own (sticky on this long form). *@
        <FormActions Standalone="true" SaveLabel="@(IsEdit ? "Save changes" : "Create project")" SaveName="Model.Op" SaveValue="save"
                     CancelHref="@CancelUrl" DangerZone="true" RequireChanges="IsEdit"
                     StartDirty="@(!HttpMethods.IsGet(HttpContext.Request.Method))" />
    </EditForm>

    @if (IsEdit)
    {
        @* Deleting a project takes everything in it, so it lives apart from the form — and needs the name typed. *@
        <DangerZone DialogId="delete-project-modal" ButtonLabel="Delete project">
            Deleting this project also deletes all of its test scopes, test cases and defects, with every comment and
            file in them. The team's accounts are kept.
        </DangerZone>

        <ConfirmDeleteDialog Id="delete-project-modal" FormName="delete-project" Title="Delete project"
                             ConfirmLabel="Delete project" RequireTypedName="@savedName" Error="@deleteError" OnConfirm="DeleteAsync">
            <p>
                Delete “@savedName”? This will delete
                <span class="font-semibold text-gray-900 dark:text-white">@DeleteSummary</span>,
                along with every comment and file in the project.
            </p>
        </ConfirmDeleteDialog>
    }
}

@code {
    [Parameter]
    public Guid? ProjectId { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "project")]
    private ProjectFormModel Model { get; set; } = default!;

    private EditContext editContext = default!;
    private bool notFound;
    private string? linkError;
    private string? scheduleError;
    private int systemPercent = QaEffort.DefaultPercent;

    // For the delete confirmation: the project's name as saved, and what deleting it takes with it.
    private string savedName = "";
    private int scopeCount;
    private int caseCount;
    private int defectCount;
    private string? deleteError;

    private string DeleteSummary => string.Join(", ", new[]
    {
        Count(caseCount, "test case") + (scopeCount > 0 ? $" in {Count(scopeCount, "scope")}" : ""),
        Count(defectCount, "defect"),
    });

    private static string Count(int n, string noun) => $"{n} {noun}{(n == 1 ? "" : "s")}";
    private DefectTemplate systemTemplate = DefectTemplates.SystemFallback;

    private bool IsEdit => ProjectId is not null;
    private string CancelUrl => IsEdit ? $"projects/{ProjectId}" : "projects";

    protected override async Task OnParametersSetAsync()
    {
        Model ??= new();
        Model.Links ??= [];
        editContext = new EditContext(Model);
        systemPercent = await Settings.GetDefaultQaEffortPercentAsync();
        systemTemplate = await Settings.GetDefaultDefectTemplateAsync();

        if (!IsEdit)
        {
            return;
        }

        var project = await Projects.GetAsync(ProjectId!.Value);
        if (project is null)
        {
            notFound = true;
            return;
        }

        savedName = project.Name;
        var scopes = await TestScopes.ListForProjectAsync(project.Id);
        scopeCount = scopes.Count;
        caseCount = scopes.Sum(s => s.Cases.Count);
        defectCount = (await Defects.ListForProjectAsync(project.Id)).Count;

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            Model.Name = project.Name;
            Model.Brief = project.Brief;
            Model.Notes = project.Notes;
            Model.Links = project.Links.Select(l => new LinkRow { Label = l.Label, Url = l.Url }).ToList();
            Model.TestingStart = project.TestingStartDate;
            Model.TestingEnd = project.TestingEndDate;
            Model.StartsMidday = project.TestingStartsMidday;
            Model.EndsMidday = project.TestingEndsMidday;
            Model.EstimatedDevDays = project.EstimatedDevDays;
            Model.EstimatedQaDays = project.EstimatedQaDays;
            Model.QaPercent = project.QaEffortPercent;
            Model.DefectTemplate = project.DefaultDefectTemplate?.ToString() ?? "";
        }
    }

    private async Task HandleSubmitAsync()
    {
        var op = Model.Op;
        Model.Op = null;
        Model.Links ??= [];

        switch (op)
        {
            case "add-link":
                Model.Links.Add(new LinkRow());
                return;
            case not null when op.StartsWith("remove-link-", StringComparison.Ordinal):
                RemoveAt(Model.Links, op["remove-link-".Length..]);
                return;
        }

        if (!editContext.Validate())
        {
            return;
        }

        linkError = null;
        var links = new List<ProjectLinkInput>();
        foreach (var row in Model.Links)
        {
            var label = row.Label?.Trim() ?? "";
            var url = row.Url?.Trim() ?? "";
            if (label.Length == 0 && url.Length == 0)
            {
                continue;
            }

            linkError = ProjectLink.Validate(label, url);
            if (linkError is not null)
            {
                return;
            }

            links.Add(new ProjectLinkInput(label, url));
        }

        var schedule = new ProjectSchedule(
            Model.TestingStart, Model.TestingEnd, Model.StartsMidday, Model.EndsMidday,
            Model.EstimatedDevDays, Model.EstimatedQaDays, Model.QaPercent);
        scheduleError = QaEffort.Validate(schedule);
        if (scheduleError is not null)
        {
            return;
        }

        if (IsEdit)
        {
            // One history entry for the whole save, naming everything that changed.
            var changed = new List<string>();
            changed.AddRange(await Projects.UpdateAsync(ProjectId!.Value, Model.Name, Model.Brief, Model.Notes, links));
            changed.AddRange(await Projects.UpdateScheduleAsync(ProjectId!.Value, schedule));
            changed.AddRange(await Projects.UpdateDefaultDefectTemplateAsync(ProjectId!.Value, ParsedDefectTemplate));
            await Projects.RecordEditedAsync(ProjectId!.Value, changed, await GetUserIdAsync());
            Nav.NavigateTo($"projects/{ProjectId}");
        }
        else
        {
            var user = await GetUserIdAsync();
            var created = await Projects.CreateAsync(Model.Name, Model.Brief, Model.Notes, links, user);
            if (schedule != ProjectSchedule.Empty)
            {
                await Projects.UpdateScheduleAsync(created.Id, schedule);
            }
            if (ParsedDefectTemplate is { } template)
            {
                await Projects.UpdateDefaultDefectTemplateAsync(created.Id, template);
            }
            // Full reload so the switch endpoint makes the new project current before the dashboard renders.
            Nav.NavigateTo($"projects/switch?created={created.Id}", forceLoad: true);
        }
    }

    /// <summary>The picked template, or null for "System default".</summary>
    private DefectTemplate? ParsedDefectTemplate =>
        Enum.TryParse<DefectTemplate>(Model.DefectTemplate, out var t) ? t : null;

    private async Task DeleteAsync()
    {
        // The confirmation asks for the project's name; check it here too (not just in the browser).
        var typed = HttpContext.Request.Form["confirmName"].ToString().Trim();
        if (!string.Equals(typed, savedName, StringComparison.Ordinal))
        {
            deleteError = "That doesn't match the project's name, so nothing was deleted.";
            return;
        }

        await Projects.DeleteAsync(ProjectId!.Value);
        Nav.NavigateTo("projects");
    }

    private static void RemoveAt<T>(List<T> list, string rawIndex)
    {
        if (int.TryParse(rawIndex, out var i) && i >= 0 && i < list.Count)
        {
            list.RemoveAt(i);
        }
    }

    private async Task<string> GetUserIdAsync()
    {
        var user = (await AuthState).User;
        return user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? throw new InvalidOperationException("No user id on the current principal.");
    }

    public sealed class ProjectFormModel
    {
        [Required]
        [MaxLength(200)]
        public string Name { get; set; } = string.Empty;

        [MaxLength(280)]
        public string? Brief { get; set; }

        public string? Notes { get; set; }

        public List<LinkRow> Links { get; set; } = [];

        public DateOnly? TestingStart { get; set; }

        public DateOnly? TestingEnd { get; set; }

        public bool StartsMidday { get; set; }

        public bool EndsMidday { get; set; }

        public decimal? EstimatedDevDays { get; set; }

        public decimal? EstimatedQaDays { get; set; }

        public int? QaPercent { get; set; }

        /// <summary>A <see cref="DefectTemplate"/> name, or "" to use the system default.</summary>
        public string? DefectTemplate { get; set; } = "";

        // Which submit button was pressed: "save", "add-link", or "remove-link-{i}".
        public string? Op { get; set; }
    }

    public sealed class LinkRow
    {
        public string? Label { get; set; }
        public string? Url { get; set; }
    }
}
