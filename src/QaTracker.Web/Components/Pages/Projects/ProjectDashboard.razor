@page "/projects/{ProjectId:guid}"
@inject ProjectService Projects
@inject TestScopeService TestScopes
@inject DefectService Defects
@inject ProjectActionsService Actions
@inject UserDirectory Users

<PageTitle>@(project?.Name ?? "Project") · QA Tracker</PageTitle>

@if (loaded && project is null)
{
    <h1>Project not found</h1>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        This project may have been deleted. <a href="projects">Back to all projects</a>.
    </p>
}
else if (project is not null)
{
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="min-w-0">
            <h1 class="truncate">@project.Name</h1>
            <span class="@ProjectStatusDisplay.BadgeClass(project.Status) mt-2 inline-block">
                @ProjectStatusDisplay.Label(project.Status)
            </span>
        </div>
        <div class="flex items-center gap-2">
            @if (currentProjectId != project.Id)
            {
                <form method="post" action="projects/switch">
                    <AntiforgeryToken />
                    <input type="hidden" name="projectId" value="@project.Id" />
                    <button type="submit" class="btn-secondary">Make current</button>
                </form>
            }
            <AuthorizeView Roles="@Roles.QA">
                <a href="projects/@project.Id/edit" class="btn-secondary">Edit</a>
            </AuthorizeView>
        </div>
    </div>

    @if (project.Links.Count > 0)
    {
        <div class="mt-6 flex flex-wrap gap-2">
            @foreach (var link in project.Links)
            {
                <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="btn-secondary">
                    @link.Label
                </a>
            }
        </div>
    }

    <div class="mt-6 grid gap-6 lg:grid-cols-3">
        <div class="card lg:col-span-2">
            <h2>Notes</h2>
            @if (string.IsNullOrWhiteSpace(project.Notes))
            {
                <p class="mt-2 text-sm text-gray-400">No notes yet.</p>
            }
            else
            {
                <p class="mt-2 whitespace-pre-wrap text-sm text-gray-700 dark:text-gray-300">@project.Notes</p>
            }
        </div>

        <div class="grid gap-4">
            <a href="projects/@project.Id/test-cases" class="card no-underline hover:border-brand-400">
                <p class="text-sm font-medium text-gray-500">Test cases</p>
                <p class="mt-1 text-2xl font-semibold text-gray-900 dark:text-white">@summary.Cases</p>
                @if (summary.Cases > 0)
                {
                    <p class="mt-1 text-xs text-gray-400">
                        @summary.Passed passed · @summary.Failed failed · @summary.NotRun not run
                    </p>
                    <p class="mt-0.5 text-xs text-gray-400">
                        across @summary.Scopes @(summary.Scopes == 1 ? "scope" : "scopes")
                    </p>
                }
                else if (summary.Scopes > 0)
                {
                    <p class="mt-1 text-xs text-gray-400">
                        @summary.Scopes @(summary.Scopes == 1 ? "scope" : "scopes"), no cases yet
                    </p>
                }
                else
                {
                    <p class="mt-1 text-xs text-gray-400">None yet</p>
                }
            </a>
            <a href="projects/@project.Id/defects" class="card no-underline hover:border-brand-400">
                <p class="text-sm font-medium text-gray-500">Open defects</p>
                <p class="mt-1 text-2xl font-semibold text-gray-900 dark:text-white">@defects.Open</p>
                <p class="mt-1 text-xs text-gray-400">
                    @if (defects.Total > 0)
                    {
                        @($"{defects.Total} total")
                    }
                    else
                    {
                        <text>None yet</text>
                    }
                </p>
            </a>
        </div>
    </div>

    <div class="card mt-6">
        <h2>Team</h2>
        @if (project.Members.Count == 0)
        {
            <p class="mt-2 text-sm text-gray-400">No team members assigned yet.</p>
        }
        else
        {
            <ul class="mt-2 flex flex-wrap gap-2">
                @foreach (var member in project.Members)
                {
                    <li class="badge badge-gray" @key="member.Id">
                        @(users.FirstOrDefault(u => u.Id == member.Id)?.Label
                            ?? member.FullName ?? member.UserName)
                    </li>
                }
            </ul>
        }
    </div>

    <div class="card mt-6">
        <h2>Resources</h2>
        <p class="text-xs text-gray-400">Files for reference on this project — specs, designs, sample data, etc.</p>
        <div class="mt-3">
            <AttachmentPanel @rendermode="InteractiveServer"
                              Owner="AttachmentOwner.Project" OwnerId="project.Id"
                              CurrentUserId="@currentUserId" IsQa="isQa" />
        </div>
    </div>

    @if (actions.Count > 0)
    {
        <div class="mt-6">
            <h2>Actions needed</h2>
            <div class="mt-3 space-y-4">
                @if (actions.DefectsToVerify.Count > 0)
                {
                    <div class="rounded-lg border border-brand-300 bg-white shadow-sm
                                dark:border-brand-800 dark:bg-gray-900">
                        <div class="flex items-center gap-2 border-b border-gray-200 px-5 py-3 dark:border-gray-800">
                            <Tooltip Text="Defects assigned to you that are marked To check — fixed, and waiting on you to confirm before it's closed out." />
                            <h3 class="text-base font-semibold text-gray-900 dark:text-white">Defects to verify</h3>
                            <span class="badge badge-gray">@actions.DefectsToVerify.Count</span>
                        </div>
                        <ul class="divide-y divide-gray-100 dark:divide-gray-800">
                            @foreach (var defect in actions.DefectsToVerify)
                            {
                                <li class="flex flex-wrap items-center gap-3 px-5 py-3" @key="defect.Id">
                                    <span class="@DefectDisplay.SeverityBadgeClass(defect.Severity) shrink-0">
                                        @DefectDisplay.SeverityLabel(defect.Severity)
                                    </span>
                                    <span class="@DefectDisplay.StatusBadgeClass(defect.Status) shrink-0">
                                        @DefectDisplay.StatusLabel(defect.Status)
                                    </span>
                                    <a href="projects/@project.Id/defects/@defect.Id"
                                       class="min-w-0 flex-1 truncate font-medium no-underline hover:underline">
                                        @defect.Summary
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }

                @if (actions.DefectsToFix.Count > 0)
                {
                    <div class="rounded-lg border border-brand-300 bg-white shadow-sm
                                dark:border-brand-800 dark:bg-gray-900">
                        <div class="flex items-center gap-2 border-b border-gray-200 px-5 py-3 dark:border-gray-800">
                            <Tooltip Text="Defects assigned to you that are marked Not fixed or Fixing — work still needed before they can move to To check." />
                            <h3 class="text-base font-semibold text-gray-900 dark:text-white">Defects to fix</h3>
                            <span class="badge badge-gray">@actions.DefectsToFix.Count</span>
                        </div>
                        <ul class="divide-y divide-gray-100 dark:divide-gray-800">
                            @foreach (var defect in actions.DefectsToFix)
                            {
                                <li class="flex flex-wrap items-center gap-3 px-5 py-3" @key="defect.Id">
                                    <span class="@DefectDisplay.SeverityBadgeClass(defect.Severity) shrink-0">
                                        @DefectDisplay.SeverityLabel(defect.Severity)
                                    </span>
                                    <span class="@DefectDisplay.StatusBadgeClass(defect.Status) shrink-0">
                                        @DefectDisplay.StatusLabel(defect.Status)
                                    </span>
                                    <a href="projects/@project.Id/defects/@defect.Id"
                                       class="min-w-0 flex-1 truncate font-medium no-underline hover:underline">
                                        @defect.Summary
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }

                @if (actions.TestCaseFollowUps.Count > 0)
                {
                    <div class="rounded-lg border border-brand-300 bg-white shadow-sm
                                dark:border-brand-800 dark:bg-gray-900">
                        <div class="flex items-center gap-2 border-b border-gray-200 px-5 py-3 dark:border-gray-800">
                            <Tooltip Text="Test cases whose result looks inconsistent with their linked defects: passed but still has an open defect, failed with nothing raised for it, or failed with every linked defect now resolved." />
                            <h3 class="text-base font-semibold text-gray-900 dark:text-white">Test case follow-ups</h3>
                            <span class="badge badge-gray">@actions.TestCaseFollowUps.Count</span>
                        </div>
                        <ul class="divide-y divide-gray-100 dark:divide-gray-800">
                            @foreach (var followUp in actions.TestCaseFollowUps)
                            {
                                <li class="flex flex-wrap items-center gap-3 px-5 py-3" @key="followUp.Case.Id">
                                    <span class="@TestCaseFollowUpDisplay.BadgeClass(followUp.Reason) shrink-0">
                                        @TestCaseFollowUpDisplay.Label(followUp.Reason)
                                    </span>
                                    <a href="projects/@project.Id/test-cases/scopes/@followUp.Scope.Id/cases/@followUp.Case.Id"
                                       class="min-w-0 flex-1 truncate no-underline hover:underline">
                                        @followUp.Scope.Name / @followUp.Case.Scenario
                                    </a>
                                    @if (followUp.RelatedDefects.Count > 0)
                                    {
                                        <span class="flex shrink-0 flex-wrap gap-1">
                                            @foreach (var d in followUp.RelatedDefects)
                                            {
                                                <a href="projects/@project.Id/defects/@d.Id"
                                                   class="font-mono text-xs text-gray-400 hover:underline" @key="d.Id">
                                                    @DefectDisplay.Ref(d.Number)
                                                </a>
                                            }
                                        </span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Project? project;
    private bool loaded;
    private Guid? currentProjectId;
    private TestPlanSummary summary = new(0, 0, 0, 0, 0);
    private DefectSummary defects = new(0, 0);
    private ProjectActions actions = new([], [], []);
    private IReadOnlyList<UserOption> users = [];
    private string currentUserId = "";
    private bool isQa;

    protected override async Task OnParametersSetAsync()
    {
        var user = (await AuthState).User;
        var claim = user.FindFirst(AdditionalUserClaimsPrincipalFactory.CurrentProjectClaimType)?.Value;
        currentProjectId = Guid.TryParse(claim, out var id) ? id : null;

        currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        isQa = user.IsInRole(Roles.QA);

        project = await Projects.GetAsync(ProjectId);
        if (project is not null)
        {
            summary = await TestScopes.SummariseProjectAsync(ProjectId);
            defects = await Defects.SummariseProjectAsync(ProjectId);
            actions = await Actions.GetAsync(ProjectId, currentUserId);
            if (project.Members.Count > 0)
            {
                users = await Users.ListAssignableAsync();
            }
        }
        loaded = true;
    }
}
