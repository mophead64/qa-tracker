@page "/projects/{ProjectId:guid}"
@using System.Globalization
@inject ProjectService Projects
@inject TestScopeService TestScopes
@inject DefectService Defects
@inject ProjectActionsService Actions
@inject UserDirectory Users
@inject AttachmentService AttachmentFiles
@inject QaTracker.Web.Admin.SystemSettingsService SettingsService
@inject IAuthorizationService Authorization

<PageTitle>@(project?.Name ?? "Project") · QA Tracker</PageTitle>

@if (loaded && project is null)
{
    <h1>Project not found</h1>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        This project may have been deleted. <a href="projects">Back to all projects</a>.
    </p>
}
else if (project is not null)
{
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="min-w-0">
            <h1 class="truncate" title="@project.Name" data-tip-truncated>@project.Name</h1>
            @if (!string.IsNullOrWhiteSpace(project.Brief))
            {
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">@project.Brief</p>
            }
            <div class="mt-2">
                <AuthorizeView Policy="@Policies.ManageProjects">
                    <Authorized>
                        <StatusMenu Action="@($"projects/{project.Id}/status")"
                                    FieldName="status"
                                    Label="Change project status"
                                    Current="@project.Status.ToString()"
                                    CurrentLabel="@ProjectStatusDisplay.Label(project.Status)"
                                    CurrentChipClass="@ProjectStatusDisplay.ChipClass(project.Status)"
                                    Options="statusOptions" />
                    </Authorized>
                    <NotAuthorized>
                        <span class="@ProjectStatusDisplay.BadgeClass(project.Status) inline-block">
                            @ProjectStatusDisplay.Label(project.Status)
                        </span>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
        <div class="flex items-center gap-2">
            @if (currentProjectId != project.Id)
            {
                <form method="post" action="projects/switch">
                    <AntiforgeryToken />
                    <input type="hidden" name="projectId" value="@project.Id" />
                    <button type="submit" class="btn-secondary">Make current</button>
                </form>
            }
            <AuthorizeView Policy="@Policies.ManageProjects">
                <a href="projects/@project.Id/edit" class="btn-secondary">Edit</a>
            </AuthorizeView>
        </div>
    </div>

    @* The link bar, ending in a quick "Add link" for anyone who can edit the project — so the
       bar shows for them even before the first link exists. *@
    @if (project.Links.Count > 0 || canManageProject)
    {
        <div class="mt-6 flex flex-wrap gap-2">
            @foreach (var link in project.Links)
            {
                <div class="link-group" @key="link.Id">
                    <span class="group relative flex min-w-0">
                        <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="link-group-open">
                            <span class="truncate">@link.Label</span>
                            <svg class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="none" stroke="currentColor"
                                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M7 13 13 7" />
                                <path d="M7.5 7H13v5.5" />
                            </svg>
                        </a>
                        <span class="link-group-tip left-0">
                            Open in new tab:<br /><span class="break-all">@link.Url</span>
                            <span class="absolute bottom-full left-3 -mb-px h-2 w-2 rotate-45 bg-gray-900 dark:bg-gray-700"></span>
                        </span>
                    </span>
                    <span class="group relative inline-flex">
                        <button type="button" class="link-group-copy" data-copy-link="@link.Url"
                                aria-label="@($"Copy link: {link.Url}")">
                            <svg class="link-group-copy-icon h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor"
                                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="7" y="7" width="9" height="9" rx="1.5" />
                                <path d="M13 7V5.5A1.5 1.5 0 0 0 11.5 4h-6A1.5 1.5 0 0 0 4 5.5v6A1.5 1.5 0 0 0 5.5 13H7" />
                            </svg>
                            <svg class="link-group-copied-icon h-4 w-4 text-brand-600 dark:text-brand-400" viewBox="0 0 20 20"
                                 fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                                 stroke-linejoin="round" aria-hidden="true">
                                <path d="m5 10.5 3.5 3.5L15 6.5" />
                            </svg>
                        </button>
                        <span class="link-group-tip right-0">
                            Copy link:<br /><span class="break-all">@link.Url</span>
                            <span class="absolute bottom-full right-3 -mb-px h-2 w-2 rotate-45 bg-gray-900 dark:bg-gray-700"></span>
                        </span>
                    </span>
                </div>
            }
            @if (canManageProject)
            {
                @* Just the "+" once there are links beside it (still named "Add link" for screen
                   readers, with a tooltip); spelled out while the bar is otherwise empty. *@
                var iconOnly = project.Links.Count > 0;
                <button type="button" data-dialog-open="add-link-modal"
                        class="btn-secondary shadow-sm @(iconOnly ? "px-2.5" : "px-3")"
                        aria-label="@(iconOnly ? "Add link" : null)" title="@(iconOnly ? "Add link" : null)">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    @if (!iconOnly)
                    {
                        <span>Add link</span>
                    }
                </button>
            }
        </div>
    }

    <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <a href="projects/@project.Id/test-cases" class="card no-underline hover:border-brand-400">
            <p class="text-sm font-medium text-gray-500">Test cases</p>
            <p class="mt-1 text-2xl font-semibold text-gray-900 dark:text-white">@summary.Cases</p>
            @if (summary.Cases > 0)
            {
                <p class="mt-1 text-xs text-gray-400">
                    @summary.Passed passed · @summary.Failed failed · @summary.NotRun not run
                    @if (summary.Blocked > 0)
                    {
                        <text> · @summary.Blocked blocked</text>
                    }
                    @if (summary.Inconclusive > 0)
                    {
                        <text> · @summary.Inconclusive inconclusive</text>
                    }
                </p>
                <p class="mt-0.5 text-xs text-gray-400">
                    across @summary.Scopes @(summary.Scopes == 1 ? "scope" : "scopes")
                </p>
            }
            else if (summary.Scopes > 0)
            {
                <p class="mt-1 text-xs text-gray-400">
                    @summary.Scopes @(summary.Scopes == 1 ? "scope" : "scopes"), no cases yet
                </p>
            }
            else
            {
                <p class="mt-1 text-xs text-gray-400">None yet</p>
            }
        </a>
        <a href="projects/@project.Id/defects" class="card no-underline hover:border-brand-400">
            <p class="text-sm font-medium text-gray-500">Open defects</p>
            <p class="mt-1 text-2xl font-semibold text-gray-900 dark:text-white">@defects.Open</p>
            <p class="mt-1 text-xs text-gray-400">
                @if (defects.Total > 0)
                {
                    @($"{defects.Total} total")
                }
                else
                {
                    <text>None yet</text>
                }
            </p>
        </a>
    </div>

    <div class="card mt-6">
        <h2>Notes</h2>
        @if (string.IsNullOrWhiteSpace(project.Notes))
        {
            <p class="mt-2 text-sm text-gray-400">No notes yet.</p>
        }
        else if (NotesAreLong)
        {
            <div class="relative mt-2 max-h-40 overflow-hidden">
                <p class="whitespace-pre-wrap text-sm text-gray-700 dark:text-gray-300">@project.Notes</p>
                <div class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t
                            from-white to-transparent dark:from-gray-900"></div>
            </div>
            <button type="button" class="btn-link mt-3 inline-block text-sm" data-dialog-open="notes-modal">
                Read more
            </button>
        }
        else
        {
            <p class="mt-2 whitespace-pre-wrap text-sm text-gray-700 dark:text-gray-300">@project.Notes</p>
        }
    </div>

    @if (NotesAreLong)
    {
        <dialog id="notes-modal"
                class="w-full max-w-4xl modal">
            <div class="flex max-h-[80vh] flex-col">
                <div class="flex items-center justify-between gap-3 border-b border-gray-200 px-6 py-4 dark:border-gray-800">
                    <h3 class="text-base font-semibold">Notes · @project.Name</h3>
                    <button type="button" data-dialog-close aria-label="Close"
                            class="btn-link shrink-0 text-sm text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
                        Close
                    </button>
                </div>
                <div class="overflow-y-auto px-6 py-4">
                    <p class="whitespace-pre-wrap text-sm text-gray-700 dark:text-gray-300">@project.Notes</p>
                </div>
            </div>
        </dialog>
    }

    @if (actions.Count > 0)
    {
        <div class="mt-6">
            <h2>Actions needed</h2>
            <div class="mt-3 space-y-4">
                @if (actions.DefectsToVerify.Count > 0)
                {
                    <div class="rounded-lg border border-brand-300 bg-white shadow-sm
                                dark:border-brand-800 dark:bg-gray-900">
                        <div class="flex items-center gap-2 border-b border-gray-200 px-5 py-3 dark:border-gray-800">
                            <Tooltip Text="Defects assigned to you that are marked To check — fixed, and waiting on you to confirm before it's closed out." />
                            <h3 class="text-base font-semibold text-gray-900 dark:text-white">Defects to verify</h3>
                            <span class="badge badge-gray">@actions.DefectsToVerify.Count</span>
                        </div>
                        <ul class="divide-y divide-gray-100 dark:divide-gray-800">
                            @foreach (var defect in actions.DefectsToVerify)
                            {
                                <li class="flex flex-wrap items-center gap-3 px-5 py-3" @key="defect.Id">
                                    <span class="@DefectDisplay.SeverityBadgeClass(defect.Severity) shrink-0">
                                        @DefectDisplay.SeverityLabel(defect.Severity)
                                    </span>
                                    <span class="@DefectDisplay.StatusBadgeClass(defect.Status) shrink-0">
                                        @DefectDisplay.StatusLabel(defect.Status)
                                    </span>
                                    <a href="projects/@project.Id/defects/@defect.Id"
                                       class="min-w-0 flex-1 truncate font-medium no-underline hover:underline">
                                        @defect.Summary
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }

                @if (actions.DefectsToFix.Count > 0)
                {
                    <div class="rounded-lg border border-brand-300 bg-white shadow-sm
                                dark:border-brand-800 dark:bg-gray-900">
                        <div class="flex items-center gap-2 border-b border-gray-200 px-5 py-3 dark:border-gray-800">
                            <Tooltip Text="Defects assigned to you that are marked Not fixed or Fixing — work still needed before they can move to To check." />
                            <h3 class="text-base font-semibold text-gray-900 dark:text-white">Defects to fix</h3>
                            <span class="badge badge-gray">@actions.DefectsToFix.Count</span>
                        </div>
                        <ul class="divide-y divide-gray-100 dark:divide-gray-800">
                            @foreach (var defect in actions.DefectsToFix)
                            {
                                <li class="flex flex-wrap items-center gap-3 px-5 py-3" @key="defect.Id">
                                    <span class="@DefectDisplay.SeverityBadgeClass(defect.Severity) shrink-0">
                                        @DefectDisplay.SeverityLabel(defect.Severity)
                                    </span>
                                    <span class="@DefectDisplay.StatusBadgeClass(defect.Status) shrink-0">
                                        @DefectDisplay.StatusLabel(defect.Status)
                                    </span>
                                    <a href="projects/@project.Id/defects/@defect.Id"
                                       class="min-w-0 flex-1 truncate font-medium no-underline hover:underline">
                                        @defect.Summary
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }

                @if (actions.TestCaseFollowUps.Count > 0)
                {
                    <div class="rounded-lg border border-brand-300 bg-white shadow-sm
                                dark:border-brand-800 dark:bg-gray-900">
                        <div class="flex items-center gap-2 border-b border-gray-200 px-5 py-3 dark:border-gray-800">
                            <Tooltip Text="Test cases whose result looks inconsistent with their linked defects: passed but still has an open defect, failed with nothing raised for it, or failed with every linked defect now resolved." />
                            <h3 class="text-base font-semibold text-gray-900 dark:text-white">Test case follow-ups</h3>
                            <span class="badge badge-gray">@actions.TestCaseFollowUps.Count</span>
                        </div>
                        <ul class="divide-y divide-gray-100 dark:divide-gray-800">
                            @foreach (var followUp in actions.TestCaseFollowUps)
                            {
                                <li class="flex flex-wrap items-center gap-3 px-5 py-3" @key="followUp.Case.Id">
                                    <span class="@TestCaseFollowUpDisplay.BadgeClass(followUp.Reason) shrink-0">
                                        @TestCaseFollowUpDisplay.Label(followUp.Reason)
                                    </span>
                                    <a href="projects/@project.Id/test-cases/scopes/@followUp.Scope.Id/cases/@followUp.Case.Id"
                                       class="min-w-0 flex-1 truncate no-underline hover:underline">
                                        @followUp.Scope.Name / @followUp.Case.Scenario
                                    </a>
                                    @if (followUp.RelatedDefects.Count > 0)
                                    {
                                        <span class="flex shrink-0 flex-wrap gap-1">
                                            @foreach (var d in followUp.RelatedDefects)
                                            {
                                                <a href="projects/@project.Id/defects/@d.Id"
                                                   class="font-mono text-xs text-gray-400 hover:underline" @key="d.Id">
                                                    @DefectDisplay.Ref(d.Number)
                                                </a>
                                            }
                                        </span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    }

    <div class="card mt-6">
        <div class="flex items-center justify-between gap-3">
            <h2>Team</h2>
            <AuthorizeView Policy="@Policies.ManageProjects">
                <button type="button" class="btn-secondary btn-sm" data-dialog-open="team-modal"
                        disabled="@(addableUsers.Count == 0)">
                    Add
                </button>
            </AuthorizeView>
        </div>

        @if (project.Members.Count == 0)
        {
            <p class="mt-2 text-sm text-gray-400">No team members assigned yet.</p>
        }
        else
        {
            <div class="mt-3 grid gap-x-10 gap-y-5 sm:grid-cols-2">
                @foreach (var group in MemberGroups())
                {
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">@group.Title</p>
                        <ul class="mt-2 space-y-2">
                            @foreach (var member in group.Members)
                            {
                                <li class="flex items-center gap-2.5" @key="member.Id">
                                    <Avatar Name="@MemberName(member)" Size="xs" />
                                    <span class="min-w-0 flex-1 truncate text-sm text-gray-800 dark:text-gray-200">
                                        @MemberName(member)
                                    </span>
                                    <AuthorizeView Policy="@Policies.ManageProjects">
                                        <form method="post" action="projects/@project.Id/team/remove">
                                            <AntiforgeryToken />
                                            <input type="hidden" name="userId" value="@member.Id" />
                                            <button type="submit" aria-label="@($"Remove {MemberName(member)}")"
                                                    class="btn-link shrink-0 text-xs text-gray-400 hover:text-red-600 dark:hover:text-red-400">
                                                Remove
                                            </button>
                                        </form>
                                    </AuthorizeView>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </div>

    <AuthorizeView Policy="@Policies.ManageProjects">
        @* Quick add for one link; the full list is edited on the project form. Reopens with the
           error and what was typed when the endpoint rejects it. *@
        <dialog id="add-link-modal" data-dialog-autoopen="@(LinkError is not null ? "true" : "false")"
                class="w-full max-w-md modal">
            <form method="post" action="projects/@project.Id/links" class="space-y-4 p-6">
                <AntiforgeryToken />
                <h3 class="text-base font-semibold">Add a link</h3>
                @if (LinkError is not null)
                {
                    <div class="alert alert-danger">@LinkError</div>
                }
                <div>
                    <label class="form-label" for="quick-link-label">Link label</label>
                    <input id="quick-link-label" name="label" class="form-control" required autofocus
                           maxlength="@ProjectLink.MaxLabelLength" value="@LinkLabel" placeholder="e.g. Repo, Staging, Spec" />
                </div>
                <div>
                    <label class="form-label" for="quick-link-url">Link URL</label>
                    <input id="quick-link-url" name="url" type="url" class="form-control" required
                           maxlength="@ProjectLink.MaxUrlLength" value="@LinkUrl" placeholder="https://…" />
                    <p class="mt-1 text-xs text-gray-400">An http(s) or mailto URL.</p>
                </div>
                <div class="flex justify-end gap-2">
                    <button type="button" class="btn-secondary" data-dialog-close>Cancel</button>
                    <button type="submit" class="btn-primary">Add link</button>
                </div>
            </form>
        </dialog>

        @if (ShowCompleteWarning)
        {
            <dialog id="complete-project-modal" data-dialog-autoopen class="w-full max-w-lg modal">
                <form method="post" action="projects/@project.Id/status" class="space-y-4 p-6">
                    <AntiforgeryToken />
                    <input type="hidden" name="status" value="@ProjectStatus.Complete" />
                    <input type="hidden" name="confirmed" value="true" />
                    <h3 class="text-base font-semibold">Mark this project as completed?</h3>
                    <p class="text-sm text-gray-600 dark:text-gray-400">It still has outstanding work.</p>

                    @if (TestsNotPassed > 0)
                    {
                        <div data-outstanding-tests>
                            <p class="text-sm font-medium text-gray-900 dark:text-white">
                                @TestsNotPassed of @summary.Cases test @(summary.Cases == 1 ? "case hasn't" : "cases haven't") passed
                            </p>
                            <div class="mt-1.5 flex flex-wrap gap-1">
                                @foreach (var (result, count) in new[]
                                {
                                    (TestResult.Failed, summary.Failed),
                                    (TestResult.NotRun, summary.NotRun),
                                    (TestResult.Blocked, summary.Blocked),
                                    (TestResult.Inconclusive, summary.Inconclusive),
                                })
                                {
                                    @if (count > 0)
                                    {
                                        <span class="@TestCaseDisplay.ResultBadgeClass(result)">
                                            @count @TestCaseDisplay.ResultLabel(result).ToLowerInvariant()
                                        </span>
                                    }
                                }
                            </div>
                            <a href="projects/@project.Id/test-cases" class="mt-1.5 inline-block text-xs">Review test cases</a>
                        </div>
                    }

                    @if (openDefects.Count > 0)
                    {
                        <div data-outstanding-defects>
                            <p class="text-sm font-medium text-gray-900 dark:text-white">
                                @openDefects.Count @(openDefects.Count == 1 ? "defect hasn't" : "defects haven't") been closed off
                            </p>
                            <ul class="mt-1.5 max-h-56 divide-y divide-gray-100 overflow-y-auto rounded-md border border-gray-200
                                       dark:divide-gray-800 dark:border-gray-800">
                                @foreach (var defect in openDefects)
                                {
                                    <li class="flex items-center gap-2 px-3 py-2 text-sm" @key="defect.Id">
                                        <span class="shrink-0 font-mono text-xs text-gray-400">@DefectDisplay.Ref(defect.Number)</span>
                                        <a href="projects/@project.Id/defects/@defect.Id"
                                           class="min-w-0 flex-1 truncate no-underline hover:underline">@defect.Summary</a>
                                        <span class="@DefectDisplay.StatusBadgeClass(defect.Status) shrink-0">
                                            @DefectDisplay.StatusLabel(defect.Status)
                                        </span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="flex justify-end gap-2 pt-2">
                        @* A link, not a dialog close, so it also drops ?confirmComplete from the URL —
                           and a full load, not enhanced navigation: patching the open modal out of the
                           DOM in place leaves the browser treating the page as blocked. *@
                        <a href="projects/@project.Id" data-enhance-nav="false" class="btn-secondary no-underline">Cancel</a>
                        <button type="submit" class="btn-primary">Mark as completed anyway</button>
                    </div>
                </form>
            </dialog>
        }

        <dialog id="team-modal"
                class="w-full max-w-md modal">
            <form method="post" action="projects/@project.Id/team/add" class="space-y-4 p-6">
                <AntiforgeryToken />
                <h3 class="text-base font-semibold">Add team members</h3>

                @if (addableUsers.Count == 0)
                {
                    <p class="text-sm text-gray-400">Everyone is already on the team.</p>
                }
                else
                {
                    <div class="max-h-64 overflow-y-auto rounded-md border border-gray-200 bg-gray-50 p-1
                                dark:border-gray-800 dark:bg-gray-950/40">
                        <ul class="space-y-0.5">
                            @foreach (var user in addableUsers)
                            {
                                <li @key="user.Id">
                                    <label class="flex cursor-pointer items-center gap-3 rounded-md px-2 py-1.5 text-sm
                                                  hover:bg-white dark:hover:bg-gray-800">
                                        <input type="checkbox" name="userIds" value="@user.Id" class="form-check-input" />
                                        <span class="min-w-0 flex-1 truncate">@user.DisplayName</span>
                                        <RoleBadge Role="@user.Role" />
                                    </label>
                                </li>
                            }
                        </ul>
                    </div>
                    @if (addableUsers.Count > 6)
                    {
                        <p class="text-xs text-gray-400">Scroll for more · @addableUsers.Count people</p>
                    }
                }

                <div class="flex justify-end gap-2">
                    <button type="button" class="btn-secondary" data-dialog-close>Cancel</button>
                    <button type="submit" class="btn-primary" disabled="@(addableUsers.Count == 0)">Add</button>
                </div>
            </form>
        </dialog>
    </AuthorizeView>

    <div class="card mt-6">
        <h2>Attachments</h2>
        <p class="text-xs text-gray-400">Reference material for this project — specs, designs, sample data, etc.</p>
        <div class="mt-3">
            <AttachmentPanel Owner="AttachmentOwner.Project" OwnerId="project.Id"
                              CurrentUserId="@currentUserId" IsQa="isQa"
                              ReturnUrl="@($"/projects/{project.Id}")" />
        </div>
    </div>

    @* Project-wide discussion. Comment forms post to ProjectEndpoints, which redirect back to
       #comments so the page lands here rather than at the top. *@
    <div id="comments" class="card mt-6 scroll-mt-20">
        <h2>Comments</h2>

        @if (comments.Count == 0)
        {
            <p class="mt-2 text-sm text-gray-400">No comments yet.</p>
        }
        else
        {
            <ul class="mt-3 space-y-3">
                @foreach (var comment in comments)
                {
                    <li id="comment-@comment.Id" class="scroll-mt-20 rounded-md border border-gray-200 p-3 dark:border-gray-800" @key="comment.Id">
                        <div class="flex items-center justify-between gap-2 text-xs text-gray-500">
                            <span>
                                <span class="font-medium text-gray-700 dark:text-gray-300">@comment.AuthorName</span>
                                · @Format(comment.CreatedUtc)
                            </span>
                            @if (CanDelete(comment))
                            {
                                <form method="post" action="projects/@project.Id/comments/@comment.Id/delete">
                                    <AntiforgeryToken />
                                    <button type="submit" class="btn-link text-xs text-red-600 dark:text-red-400">Delete</button>
                                </form>
                            }
                        </div>
                        <p class="mt-1 whitespace-pre-wrap text-sm text-gray-700 dark:text-gray-300"><CommentBody Body="@comment.Body" Names="teamNames" /></p>
                        <CommentAttachments Items="comment.Attachments" />
                        <CommentReactions Kind="CommentKind.Project" CommentId="comment.Id" Reactions="comment.Reactions"
                                          CurrentUserId="@currentUserId" ReturnUrl="@($"/projects/{project.Id}")" />
                    </li>
                }
            </ul>
        }

        <form method="post" action="projects/@project.Id/comments"
              enctype="multipart/form-data" class="mt-4">
            <AntiforgeryToken />
            <label class="form-label" for="new-comment">Add a comment</label>
            <MentionTextarea Users="mentionUsers" Placeholder="Updates, questions, anything the whole team should see…" />
            @if (!string.IsNullOrEmpty(CommentError))
            {
                <p class="mt-2 text-sm text-red-600 dark:text-red-400">@CommentError</p>
            }
            @if (AttachmentFiles.StorageConfigured)
            {
                <CommentFileField MaxMb="commentFileMaxMb" />
            }
            <button type="submit" class="btn-primary mt-2">Add comment</button>
        </form>
    </div>
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "commentError")]
    private string? CommentError { get; set; }

    private static readonly IReadOnlyList<StatusMenu.Option> statusOptions =
        Enum.GetValues<ProjectStatus>()
            .Select(s => new StatusMenu.Option(s.ToString(), ProjectStatusDisplay.Label(s), ProjectStatusDisplay.ChipClass(s)))
            .ToList();

    // Set by the status endpoint when someone picks Completed while work is still
    // outstanding: show the warning dialog listing it.
    [SupplyParameterFromQuery(Name = "confirmComplete")]
    private bool ConfirmComplete { get; set; }

    // Set by the quick "Add link" endpoint when it rejects the input.
    [SupplyParameterFromQuery(Name = "linkError")]
    private string? LinkError { get; set; }

    [SupplyParameterFromQuery(Name = "linkLabel")]
    private string? LinkLabel { get; set; }

    [SupplyParameterFromQuery(Name = "linkUrl")]
    private string? LinkUrl { get; set; }

    private IReadOnlyList<Defect> openDefects = [];

    private int TestsNotPassed => summary.Cases - summary.Passed;

    private bool ShowCompleteWarning =>
        ConfirmComplete && project?.Status != ProjectStatus.Complete && (TestsNotPassed > 0 || openDefects.Count > 0);

    private Project? project;
    private bool loaded;
    private Guid? currentProjectId;
    private TestPlanSummary summary = new(0, 0, 0, 0, 0);
    private DefectSummary defects = new(0, 0);
    private ProjectActions actions = new([], [], []);
    private IReadOnlyList<UserOption> users = [];
    private IReadOnlyList<UserOption> addableUsers = [];
    private string currentUserId = "";
    private bool isQa;
    private bool canManageProject;
    private IReadOnlyList<ProjectCommentView> comments = [];
    private IReadOnlyList<UserOption> mentionUsers = [];
    private IReadOnlyList<string> teamNames = [];
    private long commentFileMaxMb;

    // Past roughly a card's worth of text — a long paragraph or many lines — the notes are
    // clamped on the dashboard and shown in full via the "Read more" modal.
    private bool NotesAreLong =>
        project?.Notes is { } notes
        && (notes.Length > 320 || notes.Count(c => c == '\n') >= 6);

    private string MemberName(ApplicationUser member) =>
        users.FirstOrDefault(u => u.Id == member.Id)?.DisplayName
        ?? (!string.IsNullOrWhiteSpace(member.FullName) ? member.FullName! : member.UserName ?? "Unknown");

    private string? MemberRole(ApplicationUser member) => users.FirstOrDefault(u => u.Id == member.Id)?.Role;

    private IEnumerable<(string Title, IReadOnlyList<ApplicationUser> Members)> MemberGroups()
    {
        (string Title, string? Role)[] buckets =
        [
            ("Developer", Roles.Dev),
            ("QA", Roles.QA),
            ("No role assigned", null),
        ];

        foreach (var (title, role) in buckets)
        {
            var members = project!.Members.Where(m => MemberRole(m) == role).ToList();
            if (members.Count > 0)
            {
                yield return (title, members);
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var user = (await AuthState).User;
        var claim = user.FindFirst(AdditionalUserClaimsPrincipalFactory.CurrentProjectClaimType)?.Value;
        currentProjectId = Guid.TryParse(claim, out var id) ? id : null;

        currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        isQa = user.IsInRole(Roles.QA);
        canManageProject = (await Authorization.AuthorizeAsync(user, Policies.ManageProjects)).Succeeded;

        project = await Projects.GetAsync(ProjectId);
        if (project is not null)
        {
            summary = await TestScopes.SummariseProjectAsync(ProjectId);
            defects = await Defects.SummariseProjectAsync(ProjectId);
            if (ConfirmComplete)
            {
                openDefects = await Defects.ListOpenForProjectAsync(ProjectId);
            }
            actions = await Actions.GetAsync(ProjectId, currentUserId);

            users = await Users.ListAssignableAsync();
            var memberIds = project.Members.Select(m => m.Id).ToHashSet();
            addableUsers = users.Where(u => !memberIds.Contains(u.Id)).ToList();

            comments = await Projects.ListCommentsAsync(ProjectId);
            commentFileMaxMb = await SettingsService.GetMaxUploadMbAsync();
            var team = await Users.ListForProjectAsync(ProjectId);
            teamNames = team.Select(u => u.DisplayName).ToList();
            mentionUsers = team.Where(u => u.Id != currentUserId).ToList();
        }
        loaded = true;
    }

    private bool CanDelete(ProjectCommentView comment) => isQa || comment.AuthorId == currentUserId;

    private static string Format(DateTimeOffset utc) =>
        utc.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) + " UTC";
}
