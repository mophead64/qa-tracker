@page "/projects/{ProjectId:guid}/scopes/new"
@page "/projects/{ProjectId:guid}/scopes/{ScopeId:guid}/edit"
@using System.ComponentModel.DataAnnotations
@attribute [Authorize(Policy = Policies.ManageTestCases)]
@inject ProjectService Projects
@inject TestScopeService TestScopes
@inject NavigationManager Nav

<PageTitle>@(IsEdit ? "Edit scope" : "New scope") · QA Tracker</PageTitle>

@if (notFound)
{
    <h1>Not found</h1>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        <a href="projects/@ProjectId/test-cases">Back to test cases</a>.
    </p>
}
else
{
    <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
        <a href="@CancelUrl" class="no-underline hover:underline">Test cases</a>
    </p>
    <h1>@(IsEdit ? "Edit scope" : "New scope")</h1>

    <EditForm Model="Model" FormName="scope" OnValidSubmit="SaveAsync" method="post" class="mt-6 max-w-2xl space-y-6">
        <DataAnnotationsValidator />

        <div class="card space-y-4">
            <div>
                <label class="form-label">Type</label>
                <FormSelect Name="Model.Kind" Label="Type" Current="@Model.Kind.ToString()" Options="kindOptions" />
            </div>

            <div>
                <label class="form-label" for="name">Name</label>
                <InputText id="name" @bind-Value="Model.Name" class="form-control"
                           placeholder="Area of testing, e.g. &quot;Authentication&quot; or &quot;Checkout&quot;" />
                <ValidationMessage For="() => Model.Name" />
            </div>

            @if (!IsEdit)
            {
                <FormTip>
                    A scope groups related test cases — one area of the product, such as "Checkout". Once it's
                    created, add its test cases with the <span class="font-medium">New test case</span> button
                    on its panel.
                </FormTip>
            }

            <FormActions SaveLabel="@(IsEdit ? "Save changes" : "Create scope")" CancelHref="@CancelUrl"
                         DangerZone="true" RequireChanges="IsEdit" StartDirty="@(!HttpMethods.IsGet(HttpContext.Request.Method))" />
        </div>

    </EditForm>

    @if (IsEdit)
    {
        @* Deleting a scope takes its test cases with it, so it lives apart from the form. *@
        <DangerZone DialogId="delete-scope-modal" ButtonLabel="Delete scope">
            Deleting this scope also deletes every test case in it, with their comments, files and history.
        </DangerZone>

        <ConfirmDeleteDialog Id="delete-scope-modal" FormName="delete-scope" Title="Delete scope"
                             ConfirmLabel="Delete scope" OnConfirm="DeleteAsync">
            <p>
                Delete “@savedName”? This will delete
                <span class="font-semibold text-gray-900 dark:text-white">@caseCount @(caseCount == 1 ? "test case" : "test cases")</span>,
                with their comments, files and history. Defects linked to them are kept, just unlinked.
            </p>
        </ConfirmDeleteDialog>
    }
}

@code {
    private static readonly IReadOnlyList<SelectMenu.Option> kindOptions =
        Enum.GetValues<TestCaseKind>()
            .Select(k => new SelectMenu.Option(k.ToString(), TestCaseDisplay.KindLabel(k)))
            .ToList();

    [Parameter]
    public Guid ProjectId { get; set; }

    [Parameter]
    public Guid? ScopeId { get; set; }

    /// <summary>Carried from the defect "Create a new test case" flow: on create, jump
    /// straight to the new-test-case form for the scope, keeping the defect link.</summary>
    [SupplyParameterFromQuery]
    public Guid? FromDefect { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "scope")]
    private ScopeFormModel Model { get; set; } = default!;

    private bool notFound;
    private string savedName = "";
    private int caseCount;

    private bool IsEdit => ScopeId is not null;
    private string FromDefectQuery => !IsEdit && FromDefect is { } d ? $"?fromDefect={d}" : "";
    private string CancelUrl => AppUrls.TestPlan(ProjectId) + FromDefectQuery;

    protected override async Task OnParametersSetAsync()
    {
        Model ??= new();

        if (IsEdit)
        {
            var scope = await TestScopes.GetAsync(ScopeId!.Value);
            if (scope is null || scope.ProjectId != ProjectId)
            {
                notFound = true;
                return;
            }

            savedName = scope.Name;
            caseCount = scope.Cases.Count;
            if (HttpMethods.IsGet(HttpContext.Request.Method))
            {
                Model.Kind = scope.Kind;
                Model.Name = scope.Name;
            }
        }
        else if (!await Projects.ExistsAsync(ProjectId))
        {
            notFound = true;
        }
    }

    private async Task SaveAsync()
    {
        if (IsEdit)
        {
            await TestScopes.UpdateAsync(ScopeId!.Value, Model.Kind, Model.Name);
            Nav.NavigateTo(AppUrls.TestPlan(ProjectId));
            return;
        }

        var user = await GetUserIdAsync();
        var scope = await TestScopes.CreateAsync(ProjectId, Model.Kind, Model.Name, user);

        Nav.NavigateTo(FromDefect is { } d
            ? $"{AppUrls.NewTestCase(ProjectId, scope.Id)}?fromDefect={d}"
            : AppUrls.TestPlan(ProjectId));
    }

    private async Task DeleteAsync()
    {
        await TestScopes.DeleteAsync(ScopeId!.Value);
        Nav.NavigateTo(AppUrls.TestPlan(ProjectId));
    }

    private async Task<string> GetUserIdAsync()
    {
        var user = (await AuthState).User;
        return user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? throw new InvalidOperationException("No user id on the current principal.");
    }

    public sealed class ScopeFormModel
    {
        public TestCaseKind Kind { get; set; } = TestCaseKind.Functional;

        [Required]
        [MaxLength(200)]
        public string Name { get; set; } = string.Empty;
    }
}
