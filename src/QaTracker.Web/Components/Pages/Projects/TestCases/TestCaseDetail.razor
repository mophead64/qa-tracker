@page "/projects/{ProjectId:guid}/test-cases/scopes/{ScopeId:guid}/cases/{TestCaseId:guid}"
@rendermode InteractiveServer
@using System.Globalization
@inject TestScopeService TestScopes
@inject TestCaseService TestCases
@inject DefectService Defects

<PageTitle>Test case · QA Tracker</PageTitle>

@if (loaded && testCase is null)
{
    <h1>Test case not found</h1>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        <a href="projects/@ProjectId/test-cases">Back to test cases</a>.
    </p>
}
else if (testCase is not null)
{
    <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
                <a href="projects/@ProjectId/test-cases" class="no-underline hover:underline">Test cases</a>
                <span class="px-1">/</span>
                <span>@scopeName</span>
            </p>
            <h1 class="whitespace-pre-wrap">@testCase.Scenario</h1>
        </div>
        <AuthorizeView Roles="@Roles.QA">
            <a href="projects/@ProjectId/test-cases/scopes/@ScopeId/cases/@testCase.Id/edit" class="btn-secondary">Edit</a>
        </AuthorizeView>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-3">
        <span class="@TestCaseDisplay.ResultBadgeClass(testCase.Result)">
            @TestCaseDisplay.ResultLabel(testCase.Result)
        </span>
        <AuthorizeView Roles="@Roles.QA">
            <div class="flex items-center gap-1">
                <button type="button" class="btn-secondary px-2 py-1 text-xs" disabled="@settingResult"
                        @onclick="() => SetResult(TestResult.Passed)">Mark passed</button>
                <button type="button" class="btn-secondary px-2 py-1 text-xs" disabled="@settingResult"
                        @onclick="() => SetResult(TestResult.Failed)">Mark failed</button>
                <button type="button" class="btn-link px-2 py-1 text-xs" disabled="@settingResult"
                        @onclick="() => SetResult(TestResult.NotRun)">Reset</button>
            </div>
        </AuthorizeView>
    </div>

    <div class="mt-6 space-y-6">
        <div class="card">
            <h2>Steps</h2>
            @if (string.IsNullOrWhiteSpace(testCase.Steps))
            {
                <p class="mt-2 text-sm text-gray-400">No steps recorded.</p>
            }
            else
            {
                <p class="mt-2 whitespace-pre-wrap text-sm text-gray-700 dark:text-gray-300">@testCase.Steps</p>
            }
        </div>

        <div class="card">
            <h2>Resources</h2>
            <p class="text-xs text-gray-400">Files for reference on this case — sample data, mockups, etc.</p>
            <div class="mt-3">
                <AttachmentPanel Owner="AttachmentOwner.TestCase" OwnerId="testCase.Id"
                                  CurrentUserId="@currentUserId" IsQa="isQa" />
            </div>
        </div>

        <div class="card">
            <h2>Linked defects</h2>
            @if (linkedDefects.Count == 0)
            {
                <p class="mt-2 text-sm text-gray-400">No defects linked to this test case.</p>
            }
            else
            {
                <ul class="mt-3 divide-y divide-gray-100 dark:divide-gray-800">
                    @foreach (var d in linkedDefects)
                    {
                        <li class="flex flex-wrap items-center gap-3 py-2" @key="d.Id">
                            <span class="shrink-0 font-mono text-xs text-gray-400">@DefectDisplay.Ref(d.Number)</span>
                            <span class="@DefectDisplay.SeverityBadgeClass(d.Severity) shrink-0">
                                @DefectDisplay.SeverityLabel(d.Severity)
                            </span>
                            <span class="@DefectDisplay.StatusBadgeClass(d.Status) shrink-0">
                                @DefectDisplay.StatusLabel(d.Status)
                            </span>
                            <a href="projects/@ProjectId/defects/@d.Id"
                               class="min-w-0 flex-1 truncate no-underline hover:underline">@d.Summary</a>
                            @if (isQa)
                            {
                                <button type="button" class="btn-link shrink-0 text-xs" disabled="@linkingDefect"
                                        @onclick="() => UnlinkDefect(d.Id)">Unlink</button>
                            }
                        </li>
                    }
                </ul>
            }

            @if (isQa)
            {
                <div class="mt-4 space-y-2">
                    <div class="flex flex-wrap items-center gap-2">
                        <select class="form-select sm:w-96" @bind="selectedDefectId">
                            <option value="">— Link an existing defect —</option>
                            @foreach (var d in linkableDefects)
                            {
                                <option value="@d.Id">@DefectDisplay.Ref(d.Number) — @d.Summary</option>
                            }
                        </select>
                        <button type="button" class="btn-secondary"
                                disabled="@(linkingDefect || string.IsNullOrEmpty(selectedDefectId))"
                                @onclick="LinkDefect">Link</button>
                    </div>
                    <div>
                        <a href="projects/@ProjectId/defects/new?testCaseId=@TestCaseId" class="btn-primary">
                            Create new defect
                        </a>
                    </div>
                </div>
            }
        </div>

        <div class="card">
            <h2>Comments</h2>

            @if (comments.Count == 0)
            {
                <p class="mt-2 text-sm text-gray-400">No comments yet.</p>
            }
            else
            {
                <ul class="mt-3 space-y-3">
                    @foreach (var comment in comments)
                    {
                        <li class="rounded-md border border-gray-200 p-3 dark:border-gray-800" @key="comment.Id">
                            <div class="flex items-center justify-between gap-2 text-xs text-gray-500">
                                <span>
                                    <span class="font-medium text-gray-700 dark:text-gray-300">@comment.AuthorName</span>
                                    · @Format(comment.CreatedUtc)
                                </span>
                                @if (CanDelete(comment))
                                {
                                    <button type="button" class="btn-link text-xs text-red-600 dark:text-red-400"
                                            disabled="@(deletingId == comment.Id)"
                                            @onclick="() => DeleteComment(comment.Id)">Delete</button>
                                }
                            </div>
                            <p class="mt-1 whitespace-pre-wrap text-sm text-gray-700 dark:text-gray-300">@comment.Body</p>
                        </li>
                    }
                </ul>
            }

            <div class="mt-4">
                <label class="form-label" for="new-comment">Add a comment</label>
                <textarea id="new-comment" rows="3" class="form-control" @bind="draft" @bind:event="oninput"
                          placeholder="Notes, repro detail, why it failed…"></textarea>
                <button type="button" class="btn-primary mt-2"
                        disabled="@(addingComment || string.IsNullOrWhiteSpace(draft))"
                        @onclick="AddComment">Add comment</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [Parameter]
    public Guid ScopeId { get; set; }

    [Parameter]
    public Guid TestCaseId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private TestCase? testCase;
    private string scopeName = "";
    private bool loaded;

    private IReadOnlyList<TestCaseCommentView> comments = [];
    private IReadOnlyList<Defect> linkedDefects = [];
    private IReadOnlyList<Defect> linkableDefects = [];
    private string selectedDefectId = "";
    private bool linkingDefect;
    private string draft = "";
    private bool addingComment;
    private bool settingResult;
    private Guid? deletingId;

    private string currentUserId = "";
    private bool isQa;

    protected override async Task OnParametersSetAsync()
    {
        var user = (await AuthState).User;
        currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        isQa = user.IsInRole(Roles.QA);

        var scope = await TestScopes.GetAsync(ScopeId);
        if (scope is not null && scope.ProjectId == ProjectId)
        {
            scopeName = scope.Name;
            var found = await TestCases.GetAsync(TestCaseId);
            testCase = found is not null && found.TestScopeId == ScopeId ? found : null;
        }

        if (testCase is not null)
        {
            comments = await TestCases.ListCommentsAsync(TestCaseId);
            await RefreshDefects();
        }

        loaded = true;
    }

    private async Task RefreshDefects()
    {
        linkedDefects = await Defects.ListForTestCaseAsync(TestCaseId);
        if (isQa)
        {
            var linkedIds = linkedDefects.Select(d => d.Id).ToHashSet();
            var all = await Defects.ListForProjectAsync(ProjectId);
            linkableDefects = all.Where(d => !linkedIds.Contains(d.Id)).ToList();
        }
    }

    private async Task LinkDefect()
    {
        if (!Guid.TryParse(selectedDefectId, out var defectId))
        {
            return;
        }

        linkingDefect = true;
        try
        {
            await Defects.LinkTestCaseAsync(defectId, TestCaseId);
            selectedDefectId = "";
            await RefreshDefects();
        }
        finally
        {
            linkingDefect = false;
        }
    }

    private async Task UnlinkDefect(Guid defectId)
    {
        linkingDefect = true;
        try
        {
            await Defects.UnlinkTestCaseAsync(defectId, TestCaseId);
            await RefreshDefects();
        }
        finally
        {
            linkingDefect = false;
        }
    }

    private async Task SetResult(TestResult result)
    {
        if (testCase is null || testCase.Result == result)
        {
            return;
        }

        settingResult = true;
        try
        {
            await TestCases.SetResultAsync(testCase.Id, result);
            testCase.Result = result;
        }
        finally
        {
            settingResult = false;
        }
    }

    private async Task AddComment()
    {
        if (testCase is null || string.IsNullOrWhiteSpace(draft))
        {
            return;
        }

        addingComment = true;
        try
        {
            await TestCases.AddCommentAsync(TestCaseId, currentUserId, draft);
            draft = "";
            comments = await TestCases.ListCommentsAsync(TestCaseId);
        }
        finally
        {
            addingComment = false;
        }
    }

    private async Task DeleteComment(Guid commentId)
    {
        deletingId = commentId;
        try
        {
            await TestCases.DeleteCommentAsync(commentId);
            comments = await TestCases.ListCommentsAsync(TestCaseId);
        }
        finally
        {
            deletingId = null;
        }
    }

    private bool CanDelete(TestCaseCommentView comment) => isQa || comment.AuthorId == currentUserId;

    private static string Format(DateTimeOffset utc) =>
        utc.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) + " UTC";
}
