@page "/projects/{ProjectId:guid}/test-cases/{TestCaseId:guid}"
@using System.Globalization
@inject ProjectService Projects
@inject TestScopeService TestScopes
@inject TestCaseService TestCases
@inject DefectService Defects
@inject UserDirectory Users
@inject AttachmentService AttachmentFiles
@inject QaTracker.Web.Admin.SystemSettingsService SettingsService
@inject NavigationManager Nav
@inject IConfiguration Configuration

<PageTitle>Test case · QA Tracker</PageTitle>

@if (loaded && testCase is null)
{
    <h1>Test case not found</h1>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        <a href="projects/@ProjectId/test-cases">Back to test cases</a>.
    </p>
}
else if (testCase is not null)
{
    @* Live page (live-page.js): result changes, comments, reactions, links and deletes post in
       place, and other people's changes appear on their own — polled via …/live, which returns
       this stamp as it is now. The comment box (data-live-keep) survives every update. *@
    <div id="live-test-case" data-live-page data-live-region
         data-live-version-src="@Action("live")" data-live-version="@liveVersion"
         data-live-poll-seconds="@LiveVersion.PollSeconds(Configuration)">
    @* No wrap: the title takes the remaining width, so a long scenario wraps its own text
       instead of pushing the Edit button down underneath it. *@
    <div class="flex items-start justify-between gap-3">
        <div class="min-w-0 flex-1">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
                <a href="projects/@ProjectId" class="no-underline hover:underline">@projectName</a>
                <span class="px-1">/</span>
                <a href="projects/@ProjectId/test-cases" class="no-underline hover:underline">Test cases</a>
                <span class="px-1">/</span>
                <a href="@AppUrls.Scope(ProjectId, ScopeId)" class="no-underline hover:underline">@scopeName</a>
            </p>
            @* One line: the heading keeps whitespace (pre-wrap), so any line break here would show. *@
            <h1 class="whitespace-pre-wrap break-words"><span class="mr-1.5 font-mono text-base font-normal text-gray-400" title="Test case ID" data-case-ref>@TestCaseDisplay.CaseRef(testCase.Number)</span>@testCase.Scenario</h1>
        </div>
        <div class="flex shrink-0 gap-2">
            <button type="button" class="btn-secondary" data-dialog-open="history-modal">History</button>
            <AuthorizeView Policy="@Policies.ManageTestCases">
                <a href="@AppUrls.EditTestCase(ProjectId, testCase.Id)" class="btn-secondary">Edit</a>
            </AuthorizeView>
        </div>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-3">
        <AuthorizeView Roles="@Roles.QA">
            <Authorized>
                <StatusMenu Action="@Action("result")"
                            FieldName="result"
                            Label="Change result"
                            Current="@testCase.Result.ToString()"
                            CurrentLabel="@TestCaseDisplay.ResultLabel(testCase.Result)"
                            CurrentChipClass="@TestCaseDisplay.ResultChipClass(testCase.Result)"
                            Options="resultOptions"
                            HiddenFields="returnField" />
                @* Quick results: before a run, [Mark as running] [Mark as passed] [Mark as failed]; while
                   it's running, just pass / fail to finish it. *@
                @if (testCase.Result == TestResult.NotRun)
                {
                    <form method="post" action="@Action("result")" class="inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                        <input type="hidden" name="result" value="@TestResult.Running" />
                        <button type="submit" class="btn-purple btn-sm">Mark as running</button>
                    </form>
                }
                @if (testCase.Result is TestResult.NotRun or TestResult.Running)
                {
                    <form method="post" action="@Action("result")" class="inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                        <input type="hidden" name="result" value="@TestResult.Passed" />
                        <button type="submit" class="btn-primary btn-sm">Mark as passed</button>
                    </form>
                    <form method="post" action="@Action("result")" class="inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                        <input type="hidden" name="result" value="@TestResult.Failed" />
                        <button type="submit" class="btn-danger btn-sm">Mark as failed</button>
                    </form>
                }
            </Authorized>
            <NotAuthorized>
                <span class="@TestCaseDisplay.ResultBadgeClass(testCase.Result)">
                    @TestCaseDisplay.ResultLabel(testCase.Result)
                </span>
            </NotAuthorized>
        </AuthorizeView>
        @if (testCase.Result != TestResult.NotRun && testCase.TestedBy is { } tester)
        {
            <span class="text-sm text-gray-500" data-tested-by>
                @(testCase.Result == TestResult.Running ? "Being tested by" : "Tested by") <span class="font-medium text-gray-700 dark:text-gray-300">@(string.IsNullOrWhiteSpace(tester.FullName) ? tester.UserName : tester.FullName)</span>
                @if (testCase.TestedUtc is { } testedUtc)
                {
                    <text> · @Format(testedUtc)</text>
                }
            </span>
        }
        @* Step through a test run: jumps to the nearest case not yet passed (blocked and inconclusive cases are skipped). *@
        <nav class="ml-auto flex gap-2" aria-label="Test run navigation">
            @if (navigation.Previous is { } previous)
            {
                <a href="@CaseUrl(previous)" class="btn-secondary btn-sm" title="@TestCaseDisplay.CaseLabel(previous)">&larr; Previous</a>
            }
            else
            {
                <button type="button" class="btn-secondary btn-sm" disabled>&larr; Previous</button>
            }
            <span class="self-center whitespace-nowrap text-xs text-gray-500 dark:text-gray-400">
                @if (navigation.ToAction == 0)
                {
                    <text>@(navigation.Blocked + navigation.Inconclusive == 0 ? "All test cases passed" : "Nothing left to action")</text>
                }
                else
                {
                    <text>@navigation.ToAction @(navigation.ToAction == 1 ? "case" : "cases") to action</text>
                }
                @if (navigation.Blocked > 0)
                {
                    <text> · @navigation.Blocked blocked</text>
                }
                @if (navigation.Inconclusive > 0)
                {
                    <text> · @navigation.Inconclusive inconclusive</text>
                }
            </span>
            @if (navigation.Next is { } next)
            {
                <a href="@CaseUrl(next)" class="btn-secondary btn-sm" title="@TestCaseDisplay.CaseLabel(next)">Next &rarr;</a>
            }
            else
            {
                <button type="button" class="btn-secondary btn-sm" disabled>Next &rarr;</button>
            }
        </nav>
    </div>

    <PageContents Sections="contentsSections" />

    <div class="mt-6 space-y-6">
        <div id="steps" class="card scroll-mt-6">
            <h2>Steps</h2>
            @if (string.IsNullOrWhiteSpace(testCase.Steps))
            {
                <p class="mt-2 text-sm text-gray-400">No steps recorded.</p>
            }
            else
            {
                <p class="mt-2 whitespace-pre-wrap text-sm text-gray-700 dark:text-gray-300">@testCase.Steps</p>
            }
        </div>

        <div id="files" class="card scroll-mt-6">
            <h2>Attachments</h2>
            <p class="text-xs text-gray-400">Reference material for this case — sample data, mockups, etc.</p>
            <div class="mt-3">
                <AttachmentPanel MentionNames="teamNames" Owner="AttachmentOwner.TestCase" OwnerId="testCase.Id"
                                  CurrentUserId="@currentUserId" IsQa="isQa" ReturnUrl="@ReturnUrl" />
            </div>
        </div>

        <div id="linked-defects" class="card scroll-mt-6">
            <h2>Linked defects</h2>
            @if (linkedDefects.Count == 0)
            {
                <p class="mt-2 text-sm text-gray-400">No defects linked to this test case.</p>
            }
            else
            {
                <ul class="mt-3 divide-y divide-gray-100 dark:divide-gray-800">
                    @foreach (var d in linkedDefects)
                    {
                        <li class="flex flex-wrap items-center gap-3 py-2" @key="d.Id">
                            <span class="shrink-0 font-mono text-xs text-gray-400">@DefectDisplay.Ref(d.Number)</span>
                            <span class="@DefectDisplay.SeverityBadgeClass(d.Severity) shrink-0">
                                @DefectDisplay.SeverityLabel(d.Severity)
                            </span>
                            <span class="@DefectDisplay.StatusBadgeClass(d.Status) shrink-0">
                                @DefectDisplay.StatusLabel(d.Status)
                            </span>
                            <a href="projects/@ProjectId/defects/@d.Id"
                               class="min-w-0 flex-1 truncate no-underline hover:underline">@d.Summary</a>
                            @if (isQa)
                            {
                                <form method="post" action="@Action("defects/unlink")" class="shrink-0">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="defectId" value="@d.Id" />
                                    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                                    <button type="submit" class="btn-link text-xs">Unlink</button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            }

            @if (isQa)
            {
                <div class="mt-4">
                    <button type="button" class="btn-secondary btn-sm" data-dialog-open="link-defects-modal">
                        Link or create defect
                    </button>
                </div>
            }
        </div>

        @if (isQa)
        {
            @* overflow-visible: a modal <dialog> is a scroll container, so the status filter's open
               list would otherwise make the dialog scroll and be cut off at its bottom edge. Visible
               overflow lets the list hang over the edge, on top of everything (the dialog is in the
               top layer). The defect list keeps its own scroller, so the modal's height stays bounded. *@
            <dialog id="link-defects-modal"
                    class="w-full max-w-2xl modal overflow-visible">
                <form method="post" action="@Action("defects/link")" class="space-y-5 p-6">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                    <h3 class="text-base font-semibold">Link or create defect</h3>

                    @* Newest defect first; the status filter (filter-list.js) shows and hides rows in
                       place, so ticks survive changing it — hidden ticked rows still get linked. *@
                    <div data-filter-list>
                        <div class="flex flex-wrap items-end justify-between gap-2">
                            <p class="form-label mb-0">Existing defects</p>
                            @if (linkableDefects.Count > 0)
                            {
                                <div class="w-56">
                                    <FormSelect Name="linkFilter" Label="Show defects" Current="@nameof(DefectListFilter.Open)"
                                                Options="linkFilterOptions" Scroll="false" />
                                </div>
                            }
                        </div>
                        @if (linkableDefects.Count == 0)
                        {
                            <p class="mt-2 text-sm text-gray-400">Every defect in this project is already linked.</p>
                        }
                        else
                        {
                            <p class="mt-2 text-sm text-gray-400" data-filter-empty
                               hidden="@(linkableDefects.Any(d => DefectListFilter.Open.Matches(d.Status)))">
                                No defects match — try another filter.
                            </p>
                            <div class="mt-2 max-h-72 overflow-y-auto rounded-md border border-gray-200 bg-gray-50 p-1
                                        dark:border-gray-800 dark:bg-gray-950/40" data-filter-scroller>
                                <ul class="space-y-0.5">
                                    @foreach (var d in linkableDefects)
                                    {
                                        <li @key="d.Id" data-filter-tags="@LinkFilterTags(d)"
                                            hidden="@(!DefectListFilter.Open.Matches(d.Status))">
                                            <label class="flex cursor-pointer items-start gap-2.5 rounded-md px-2 py-1.5 text-sm
                                                          hover:bg-white dark:hover:bg-gray-800">
                                                <input type="checkbox" name="defectIds" value="@d.Id" class="form-check-input mt-0.5" />
                                                <span class="shrink-0 font-mono text-xs text-gray-400">@DefectDisplay.Ref(d.Number)</span>
                                                <span class="@DefectDisplay.SeverityBadgeClass(d.Severity) shrink-0">
                                                    @DefectDisplay.SeverityLabel(d.Severity)
                                                </span>
                                                <span class="@DefectDisplay.StatusBadgeClass(d.Status) shrink-0">
                                                    @DefectDisplay.StatusLabel(d.Status)
                                                </span>
                                                <span class="min-w-0 flex-1">@d.Summary</span>
                                            </label>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>

                    <div class="border-t border-gray-200 pt-4 dark:border-gray-800">
                        <a href="projects/@ProjectId/defects/new?testCaseId=@TestCaseId" class="btn-primary">
                            Create a new defect instead
                        </a>
                        <p class="mt-1.5 text-xs text-gray-400">
                            Opens the new-defect form, prefilled from this case's scenario and steps and
                            linked to it on save.
                        </p>
                    </div>

                    <div class="flex flex-wrap items-center gap-2">
                        @if (linkableDefects.Count > 0)
                        {
                            <button type="submit" class="btn-primary">Link selected</button>
                        }
                        <button type="button" class="btn-secondary" data-dialog-close>Cancel</button>
                    </div>
                </form>
            </dialog>
        }

        <div id="comments" class="card scroll-mt-6">
            <h2>Comments</h2>

            @{ var paged = PagedComments; }
            @if (comments.Count == 0)
            {
                <p class="mt-2 text-sm text-gray-400">No comments yet.</p>
            }
            else
            {
                <ul class="mt-3 space-y-3">
                    @foreach (var comment in paged.Items)
                    {
                        <li id="comment-@comment.Id" class="@($"scroll-mt-20 rounded-md border border-gray-200 p-3 dark:border-gray-800 {(comment.Id == HighlightComment ? CommentPaging.HighlightClass : "")}")" @key="comment.Id">
                            <div class="flex items-center justify-between gap-2 text-xs text-gray-500">
                                <span>
                                    <span class="font-medium text-gray-700 dark:text-gray-300">@comment.AuthorName</span>
                                    · @Format(comment.CreatedUtc)
                                </span>
                                @if (CanDelete(comment))
                                {
                                    <ConfirmDelete Action="@Action($"comments/{comment.Id}/delete")"
                                                   Prompt="Delete this comment?" Label="Delete comment"
                                                   HiddenFields="@(new Dictionary<string, string?> { ["returnUrl"] = ReturnUrl + paged.ReturnQuery })" />
                                }
                            </div>
                            <p class="mt-1 whitespace-pre-wrap text-sm text-gray-700 dark:text-gray-300"><CommentBody Body="@comment.Body" Names="teamNames" /></p>
                            <CommentAttachments Items="comment.Attachments" CommentId="comment.Id" AuthorName="@comment.AuthorName"
                                    CreatedUtc="comment.CreatedUtc" Body="@comment.Body" MentionNames="teamNames" />
                            <CommentReactions Kind="CommentKind.TestCase" CommentId="comment.Id" Reactions="comment.Reactions"
                                              CurrentUserId="@currentUserId" ReturnUrl="@(ReturnUrl + paged.ReturnQuery)" />
                        </li>
                    }
                </ul>
                <Pager ParamName="@CommentPaging.QueryParam" Current="paged.Current" TotalPages="paged.TotalPages"
                       TotalItems="paged.TotalItems" ItemNoun="comment" ItemNounPlural="comments" Label="Comment pages"
                       PreviousLabel="Older" NextLabel="Newer" Fragment="@CommentPaging.Anchor" ClearParams="commentPagerClears" />
            }

            <CommentComposer Action="@Action("comments")" ReturnUrl="@ReturnUrl" MentionUsers="mentionUsers"
                             Placeholder="Notes, repro detail, why it failed…"
                             Error="@CommentError" ShowFiles="AttachmentFiles.StorageConfigured" MaxMb="commentFileMaxMb" />
        </div>
    </div>

    @* Large, scrollable modal: the header stays put while the timeline scrolls beneath it. The
       timeline is fetched when it opens (dialog.js data-lazy-src → GET …/test-cases/{id}/history),
       so the page carries no hidden history text for selectors to trip over. *@
    <dialog id="history-modal" class="modal w-full max-w-3xl" aria-labelledby="history-modal-title"
            data-lazy-src="@Action("history")">
        <div class="flex max-h-[85vh] flex-col">
            <div class="flex items-start justify-between gap-3 border-b border-gray-200 px-6 py-4 dark:border-gray-800">
                <div class="min-w-0">
                    <h3 id="history-modal-title" class="text-base font-semibold">History</h3>
                    <p class="text-xs text-gray-400">Who created, edited and ran this case, and when.</p>
                </div>
                <button type="button" class="btn-secondary btn-sm shrink-0" data-dialog-close>Close</button>
            </div>
            <div class="overflow-y-auto px-6 py-4">
                <div data-lazy-content><p class="text-sm text-gray-400">Loading…</p></div>
            </div>
        </div>
    </dialog>
    </div>
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [Parameter]
    public Guid TestCaseId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private TestCase? testCase;
    private string? liveVersion;
    private string projectName = "";
    private string scopeName = "";

    /// <summary>The case's scope (from the case — it isn't part of the address).</summary>
    private Guid ScopeId => testCase?.TestScopeId ?? Guid.Empty;
    private bool loaded;

    private static readonly IReadOnlyList<StatusMenu.Option> resultOptions =
        new[] { TestResult.NotRun, TestResult.Running, TestResult.Passed, TestResult.Failed, TestResult.Blocked, TestResult.Inconclusive }
            .Select(r => new StatusMenu.Option(r.ToString(), TestCaseDisplay.ResultLabel(r), TestCaseDisplay.ResultChipClass(r)))
            .ToList();

    private IReadOnlyDictionary<string, string?> returnField =>
        new Dictionary<string, string?> { ["returnUrl"] = ReturnUrl };

    [SupplyParameterFromQuery(Name = "commentError")]
    private string? CommentError { get; set; }

    // Comment thread paging (CommentPaging): newest page by default, ?commentsPage=N for older ones.
    /// <summary>A comment to outline — where the attachment preview's "Go to comment" lands.</summary>
    [SupplyParameterFromQuery(Name = CommentPaging.HighlightParam)]
    private Guid? HighlightComment { get; set; }

    [SupplyParameterFromQuery(Name = CommentPaging.QueryParam)]
    private string? CommentsPage { get; set; }

    private CommentPage<TestCaseCommentView> PagedComments => CommentPaging.Slice(comments, CommentsPage);

    // One-off flags the comment pager's links shouldn't carry to the next page.
    private static readonly string[] commentPagerClears = ["commentError"];

    private long commentFileMaxMb;
    private IReadOnlyList<UserOption> mentionUsers = [];
    private IReadOnlyList<string> teamNames = [];
    private IReadOnlyList<TestCaseCommentView> comments = [];
    private IReadOnlyList<Defect> linkedDefects = [];
    private IReadOnlyList<Defect> linkableDefects = [];

    private string currentUserId = "";
    private bool isQa;

    private string ReturnUrl => AppUrls.Absolute(AppUrls.TestCase(ProjectId, TestCaseId));

    private string Action(string action) => AppUrls.TestCaseAction(ProjectId, TestCaseId, action);

    private TestRunNavigation navigation = new(null, null, 0);

    private string CaseUrl(TestCase target) => AppUrls.TestCase(ProjectId, target.Id);

    protected override async Task OnParametersSetAsync()
    {
        var user = (await AuthState).User;
        currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        isQa = user.IsInRole(Roles.QA);

        // Stamp first: if something changes while the page loads, the next poll sees a newer
        // stamp and refreshes, rather than this page claiming a version it doesn't show.
        liveVersion = await TestCases.GetLiveVersionAsync(TestCaseId);

        // The address is the case's own id — its scope comes from the case (so moving it between
        // scopes doesn't change where it lives). It must belong to this project.
        var found = await TestCases.GetAsync(TestCaseId);
        var scope = found is null ? null : await TestScopes.GetAsync(found.TestScopeId);
        if (scope is not null && scope.ProjectId == ProjectId)
        {
            scopeName = TestCaseDisplay.ScopeLabel(scope);
            projectName = (await Projects.GetAsync(ProjectId))?.Name ?? "";
            testCase = found;
        }

        if (testCase is not null)
        {
            navigation = await TestScopes.GetRunNavigationAsync(ProjectId, TestCaseId);
            comments = await TestCases.ListCommentsAsync(TestCaseId);
            commentFileMaxMb = await SettingsService.GetMaxUploadMbAsync();
            // The team, plus Viewers — they're never on a team but can always be @-mentioned.
            var mentionable = await Users.ListMentionableAsync(ProjectId);
            teamNames = mentionable.Select(u => u.DisplayName).ToList();
            mentionUsers = mentionable.Where(u => u.Id != currentUserId).ToList();
            linkedDefects = await Defects.ListForTestCaseAsync(TestCaseId);
            if (isQa)
            {
                var linkedIds = linkedDefects.Select(d => d.Id).ToHashSet();
                var all = await Defects.ListForProjectAsync(ProjectId);
                linkableDefects = all.Where(d => !linkedIds.Contains(d.Id)).OrderByDescending(d => d.Number).ToList();
                linkFilterOptions = LinkFilters
                    .Select(f => (Filter: f, Count: linkableDefects.Count(d => f.Matches(d.Status))))
                    .Where(x => x.Count > 0 || x.Filter is DefectListFilter.Open or DefectListFilter.All or DefectListFilter.Closed)
                    .Select(x => new SelectMenu.Option(x.Filter.ToString(), $"{DefectListFilters.Label(x.Filter)} ({x.Count})"))
                    .ToList();
            }
        }

        loaded = true;
    }

    // The link modal's status filter: open defects first (the usual choice), then everything,
    // closed, and each status. Single statuses with nothing in them are left out.
    private static readonly DefectListFilter[] LinkFilters =
    [
        DefectListFilter.Open,
        DefectListFilter.All,
        DefectListFilter.Closed,
        DefectListFilter.NotFixed,
        DefectListFilter.Fixing,
        DefectListFilter.ToCheck,
        DefectListFilter.Fixed,
        DefectListFilter.NotADefect,
    ];

    private IReadOnlyList<SelectMenu.Option> linkFilterOptions = [];

    /// <summary>Every filter a defect matches, for filter-list.js ("All Open NotFixed").</summary>
    private static string LinkFilterTags(Defect d) =>
        string.Join(' ', LinkFilters.Where(f => f.Matches(d.Status)));

    private bool CanDelete(TestCaseCommentView comment) => isQa || comment.AuthorId == currentUserId;

    // The "On this page" rail — mirrors the cards below the header, in order.
    private IReadOnlyList<PageSection> contentsSections =>
    [
        new("steps", "Steps"),
        new("files", "Attachments"),
        new("linked-defects", "Linked defects", linkedDefects.Count),
        new("comments", "Comments", comments.Count),
    ];

    private static string Format(DateTimeOffset utc) =>
        utc.UtcDateTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) + " UTC";
}
