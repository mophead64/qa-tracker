@page "/projects/{ProjectId:guid}/test-cases"
@inject ProjectService Projects
@inject TestScopeService TestScopes
@inject DefectService Defects
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager

<PageTitle>Test cases · @(project?.Name ?? "Project") · QA Tracker</PageTitle>

@if (loaded && project is null)
{
    <h1>Project not found</h1>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        <a href="projects">Back to all projects</a>.
    </p>
}
else if (project is not null)
{
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="min-w-0">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
                <a href="projects/@project.Id" class="no-underline hover:underline">@project.Name</a>
            </p>
            <h1>Test cases</h1>
        </div>
        <div class="flex items-center gap-2">
            @if (scopes.Any(s => s.Cases.Count > 0))
            {
                <a href="projects/@project.Id/test-cases.csv" download class="btn-secondary">Export CSV</a>
            }
            <AuthorizeView Policy="@Policies.ManageTestCases">
                @if (scopes.Count > 1)
                {
                    <button type="button" class="btn-secondary" data-dialog-open="reorder-scopes-modal">Reorder scopes</button>
                }
                <a href="projects/@project.Id/test-cases/import" class="btn-secondary">Import CSV</a>
                <a href="@ScopeNewUrl" class="btn-primary">New scope</a>
            </AuthorizeView>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Imported))
    {
        <div class="alert alert-success mt-4">@Imported</div>
    }

    @if (fromDefect is not null)
    {
        <div class="alert alert-success mt-4 flex flex-wrap items-center justify-between gap-2">
            <span>
                Pick a scope's <span class="font-medium">New test case</span> (or add a scope) to create a
                case for defect <span class="font-mono font-semibold">@DefectDisplay.Ref(fromDefect.Number)</span> —
                it'll be prefilled and linked back automatically.
            </span>
            <a href="projects/@project.Id/defects/@fromDefect.Id" class="shrink-0 font-medium no-underline hover:underline">
                Cancel
            </a>
        </div>
    }

    @if (scopes.Count == 0)
    {
        <div class="card mt-6 text-center">
            <p class="text-sm text-gray-600 dark:text-gray-400">No test scopes yet.</p>
            <p class="mt-1 text-xs text-gray-400">
                A scope groups related test cases, e.g. "Authentication" or "Checkout".
            </p>
            <AuthorizeView Policy="@Policies.ManageTestCases">
                <Authorized>
                    <a href="@ScopeNewUrl" class="btn-primary mt-4">Add the first scope</a>
                </Authorized>
                <NotAuthorized>
                    <p class="mt-2 text-xs text-gray-400">Test scopes will appear here once they've been added.</p>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    }
    else
    {
        @* Per-user filter (remembered across projects, like the All Projects dropdown). A filtered
           view hides scopes whose cases all fall outside it (empty scopes stay); each scope's tally
           still counts all its cases. *@
        <div class="mt-4 flex flex-wrap items-center gap-3" data-test-case-filter>
            <SelectMenu Action="test-cases/filter"
                        Large="true"
                        FieldName="filter"
                        Label="Filter test cases"
                        Current="@(((int)filter).ToString())"
                        CurrentLabel="@TestCaseListFilters.Label(filter)"
                        Options="filterOptions"
                        HiddenFields="filterReturn" />
            @if (filter != TestCaseListFilter.All)
            {
                <span class="text-sm text-gray-500 dark:text-gray-400" data-filter-summary>
                    Showing @matchingCount of @totalCount @(totalCount == 1 ? "test case" : "test cases")
                </span>
            }
        </div>

        @if (visibleScopes.Count == 0)
        {
            <div class="card mt-6 text-center">
                <p class="text-sm text-gray-600 dark:text-gray-400">
                    No test cases match “@TestCaseListFilters.Label(filter)”.
                </p>
                <form method="post" action="test-cases/filter" class="mt-3">
                    <AntiforgeryToken />
                    <input type="hidden" name="filter" value="@((int)TestCaseListFilter.All)" />
                    <input type="hidden" name="returnUrl" value="@FilterReturnUrl" />
                    <button type="submit" class="btn-secondary">Show all test cases</button>
                </form>
            </div>
        }

        <PageContents Sections="@(visibleScopes.Select(s => new PageSection($"scope-{s.Id}", s.Name, Visible(s).Count)).ToList())" />

        <div class="mt-6 space-y-6">
            @foreach (var scope in visibleScopes)
            {
                var tally = Tally(scope);

                <section id="scope-@scope.Id" class="scroll-mt-6 overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm
                                dark:border-gray-800 dark:bg-gray-900" @key="scope.Id">
                    <header class="border-b border-gray-200 px-5 py-4 dark:border-gray-800">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                            <h2 class="flex min-w-0 items-center gap-2">
                                <span class="truncate">@scope.Name</span>
                                <span class="badge badge-gray shrink-0">@TestCaseDisplay.KindLabel(scope.Kind)</span>
                            </h2>
                            <AuthorizeView Policy="@Policies.ManageTestCases">
                                <a href="projects/@project.Id/test-cases/scopes/@scope.Id/edit"
                                   class="btn-secondary shrink-0">Edit scope</a>
                            </AuthorizeView>
                        </div>
                        <p class="mt-1 text-xs text-gray-400">
                            @if (scope.Cases.Count > 0)
                            {
                                @($"{tally.passed} passed · {tally.failed} failed · {tally.notRun} not run")
                                @if (tally.blocked > 0)
                                {
                                    @($" · {tally.blocked} blocked")
                                }
                                @if (tally.inconclusive > 0)
                                {
                                    @($" · {tally.inconclusive} inconclusive")
                                }
                            }
                            else
                            {
                                <text>No test cases</text>
                            }
                        </p>
                    </header>

                    @if (scope.Cases.Count == 0)
                    {
                        <AuthorizeView Policy="@Policies.ManageTestCases">
                            <Authorized>
                                <p class="px-5 py-6 text-center text-sm text-gray-500">No test cases yet.</p>
                            </Authorized>
                            <NotAuthorized>
                                <p class="px-5 py-6 text-center text-sm text-gray-500">
                                    No test cases yet — they'll appear here once added.
                                </p>
                            </NotAuthorized>
                        </AuthorizeView>
                    }
                    else
                    {
                        <ul class="divide-y divide-gray-100 dark:divide-gray-800">
                            @foreach (var tc in Visible(scope))
                            {
                                <li class="flex flex-wrap items-center gap-3 px-5 py-3" @key="tc.Id">
                                    <span class="@TestCaseDisplay.ResultBadgeClass(tc.Result) shrink-0">
                                        @TestCaseDisplay.ResultLabel(tc.Result)
                                    </span>
                                    <a href="projects/@project.Id/test-cases/scopes/@scope.Id/cases/@tc.Id"
                                       class="min-w-0 flex-1 truncate font-medium no-underline hover:underline">
                                        @tc.Scenario
                                    </a>
                                    <AuthorizeView Roles="@Roles.QA">
                                        <form method="post" action="test-cases/@tc.Id/result" class="flex items-center gap-1">
                                            <AntiforgeryToken />
                                            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                                            <button type="submit" name="result" value="@nameof(TestResult.Passed)"
                                                    class="btn-secondary px-2 py-1 text-xs"
                                                    disabled="@(tc.Result == TestResult.Passed)">Pass</button>
                                            <button type="submit" name="result" value="@nameof(TestResult.Failed)"
                                                    class="btn-secondary px-2 py-1 text-xs"
                                                    disabled="@(tc.Result == TestResult.Failed)">Fail</button>
                                            <button type="submit" name="result" value="@nameof(TestResult.NotRun)"
                                                    class="btn-link px-2 py-1 text-xs"
                                                    disabled="@(tc.Result == TestResult.NotRun)">Reset</button>
                                        </form>
                                    </AuthorizeView>
                                </li>
                            }
                        </ul>
                    }

                    <AuthorizeView Policy="@Policies.ManageTestCases">
                        <div class="flex justify-center border-t border-gray-200 px-5 py-3 dark:border-gray-800">
                            <a href="@CaseNewUrl(scope.Id)"
                               class="btn-primary">New test case</a>
                        </div>
                    </AuthorizeView>
                </section>
            }
        </div>

        @if (scopes.Count > 1)
        {
            <AuthorizeView Policy="@Policies.ManageTestCases">
                @* Drag a row (or use its arrows) to rearrange, then Save — scope-reorder.js moves the
                   rows, and each row's hidden scopeIds input posts in the new DOM order. Closing
                   without saving puts the rows back. *@
                <dialog id="reorder-scopes-modal" class="modal w-full max-w-lg" aria-labelledby="reorder-scopes-title">
                    <form method="post" action="projects/@project.Id/test-cases/scopes/order" class="flex max-h-[85vh] flex-col">
                        <AntiforgeryToken />
                        <div class="border-b border-gray-200 px-6 py-4 dark:border-gray-800">
                            <h3 id="reorder-scopes-title" class="text-base font-semibold">Reorder scopes</h3>
                            <p class="text-xs text-gray-400">Drag scopes into the order you want them on this page, then save.</p>
                        </div>
                        <ol class="space-y-1.5 overflow-y-auto px-6 py-4" data-reorder-list>
                            @foreach (var (scope, index) in scopes.Select((s, i) => (s, i)))
                            {
                                <li class="reorder-item" data-reorder-item data-original-index="@index" @key="scope.Id">
                                    <input type="hidden" name="scopeIds" value="@scope.Id" />
                                    <span class="reorder-handle" data-reorder-handle aria-hidden="true">
                                        <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
                                            <circle cx="7" cy="5" r="1.5" /><circle cx="13" cy="5" r="1.5" />
                                            <circle cx="7" cy="10" r="1.5" /><circle cx="13" cy="10" r="1.5" />
                                            <circle cx="7" cy="15" r="1.5" /><circle cx="13" cy="15" r="1.5" />
                                        </svg>
                                    </span>
                                    <span class="min-w-0 flex-1 truncate font-medium" data-reorder-name>@scope.Name</span>
                                    <span class="badge badge-gray shrink-0">@TestCaseDisplay.KindLabel(scope.Kind)</span>
                                    <span class="flex shrink-0 gap-0.5">
                                        <button type="button" class="reorder-move" data-reorder-move="up"
                                                aria-label="Move @scope.Name up">&uarr;</button>
                                        <button type="button" class="reorder-move" data-reorder-move="down"
                                                aria-label="Move @scope.Name down">&darr;</button>
                                    </span>
                                </li>
                            }
                        </ol>
                        <div class="flex justify-end gap-2 border-t border-gray-200 px-6 py-4 dark:border-gray-800">
                            <button type="button" class="btn-secondary" data-dialog-close>Cancel</button>
                            <button type="submit" class="btn-primary">Save order</button>
                        </div>
                    </form>
                </dialog>
            </AuthorizeView>
        }
    }
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    /// <summary>Set when the user came here from a defect's "Create a new test case" button —
    /// carried onto the New scope / New test case links so the new case links back.</summary>
    [SupplyParameterFromQuery]
    public Guid? FromDefect { get; set; }

    /// <summary>Success summary shown after returning from the CSV importer.</summary>
    [SupplyParameterFromQuery]
    public string? Imported { get; set; }

    private Project? project;
    private IReadOnlyList<TestScope> scopes = [];
    private Defect? fromDefect;
    private bool loaded;

    private TestCaseListFilter filter = TestCaseListFilter.All;
    private IReadOnlyList<TestScope> visibleScopes = [];
    private int matchingCount;
    private int totalCount;

    private static readonly IReadOnlyList<SelectMenu.Option> filterOptions =
        TestCaseListFilters.Ordered
            .Select(f => new SelectMenu.Option(((int)f).ToString(), TestCaseListFilters.Label(f),
                Description: TestCaseListFilters.Hint(f),
                // All and Outstanding first, then a divider before the single results.
                DividerBefore: f == TestCaseListFilter.Passed))
            .ToList();

    // Back to this page as it was (keeping the defect hand-off, dropping the one-off import banner).
    private string FilterReturnUrl => ReturnUrl + FromDefectQuery;

    private IReadOnlyDictionary<string, string?> filterReturn =>
        new Dictionary<string, string?> { ["returnUrl"] = FilterReturnUrl };

    private IReadOnlyList<TestCase> Visible(TestScope scope) =>
        filter == TestCaseListFilter.All ? scope.Cases : scope.Cases.Where(c => filter.Matches(c.Result)).ToList();

    private string ReturnUrl => $"/projects/{ProjectId}/test-cases";
    private string FromDefectQuery => fromDefect is not null ? $"?fromDefect={fromDefect.Id}" : "";
    private string ScopeNewUrl => $"projects/{ProjectId}/test-cases/scopes/new{FromDefectQuery}";
    private string CaseNewUrl(Guid scopeId) =>
        $"projects/{ProjectId}/test-cases/scopes/{scopeId}/cases/new{FromDefectQuery}";

    protected override async Task OnParametersSetAsync()
    {
        project = await Projects.GetAsync(ProjectId);
        if (project is not null)
        {
            scopes = await TestScopes.ListForProjectAsync(ProjectId);
            filter = (await UserManager.GetUserAsync((await AuthState).User))?.TestCaseListFilter ?? TestCaseListFilter.All;
            // Empty scopes stay visible (a just-created scope mustn't vanish); only scopes whose
            // cases all fall outside the filter are hidden.
            visibleScopes = filter == TestCaseListFilter.All
                ? scopes
                : scopes.Where(s => s.Cases.Count == 0 || Visible(s).Count > 0).ToList();
            totalCount = scopes.Sum(s => s.Cases.Count);
            matchingCount = scopes.Sum(s => Visible(s).Count);

            if (FromDefect is { } defectId)
            {
                var defect = await Defects.GetAsync(defectId);
                fromDefect = defect is not null && defect.ProjectId == ProjectId ? defect : null;
            }
        }
        loaded = true;
    }

    private static (int passed, int failed, int notRun, int blocked, int inconclusive) Tally(TestScope scope) => (
        scope.Cases.Count(c => c.Result == TestResult.Passed),
        scope.Cases.Count(c => c.Result == TestResult.Failed),
        scope.Cases.Count(c => c.Result == TestResult.NotRun),
        scope.Cases.Count(c => c.Result == TestResult.Blocked),
        scope.Cases.Count(c => c.Result == TestResult.Inconclusive));
}
