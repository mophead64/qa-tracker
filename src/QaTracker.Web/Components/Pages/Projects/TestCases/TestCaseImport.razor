@page "/projects/{ProjectId:guid}/test-cases/import"
@using System.Security.Claims
@using System.Text
@attribute [Authorize(Policy = Policies.ManageTestCases)]
@inject ProjectService Projects
@inject TestCaseImportService Import
@inject NavigationManager Nav

<PageTitle>Import test cases · @(project?.Name ?? "Project") · QA Tracker</PageTitle>

@if (notFound)
{
    <h1>Project not found</h1>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        <a href="projects">Back to all projects</a>.
    </p>
}
else if (project is not null)
{
    <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
        <a href="projects/@project.Id/test-cases" class="no-underline hover:underline">Test cases</a>
    </p>
    <h1>Import test cases</h1>

    <div class="card mt-6 max-w-2xl space-y-4">
        @if (plan is null)
        {
            <p class="text-sm text-gray-600 dark:text-gray-400">
                Upload a CSV to create test scopes, test cases and their steps in one go, and link
                them to defects that already exist in this project. Nothing is created until you
                review the result and confirm — and the file itself is never stored.
            </p>
            <p class="text-sm text-gray-600 dark:text-gray-400">
                Not sure of the format?
                <a href="@AppUrls.ImportTemplate(project.Id)" download>Download the template</a>.
                Already have test cases here? <a href="@AppUrls.ExportTestCases(project.Id)" download>Export them</a>,
                edit in a spreadsheet, and re-import — existing scopes and cases are updated in place.
            </p>
            <details class="rounded-md border border-gray-200 px-3 py-2 text-sm dark:border-gray-800" data-import-help>
                <summary class="cursor-pointer font-medium text-gray-700 dark:text-gray-300">How rows are matched</summary>
                <ul class="mt-2 list-disc space-y-1 pl-5 text-gray-600 dark:text-gray-400">
                    <li>
                        <strong>By ID first.</strong> Exports carry each scope's and test case's ID
                        (<span class="font-mono">S-3</span>, <span class="font-mono">T-12</span>). Keep them, and you can rename a
                        scope or test case — or move a case to another scope — right in the spreadsheet.
                    </li>
                    <li><strong>Then by name.</strong> Without IDs, scopes match by name, and test cases by name within their scope.</li>
                    <li>Leave the ID columns empty for new scopes and test cases — they get IDs when imported.</li>
                    <li>A missing <em>Test Case Type</em> keeps an existing scope's type; a new scope without one is imported as Functional.</li>
                </ul>
            </details>
        }
        else
        {
            <p class="text-sm font-medium text-gray-700 dark:text-gray-300">Import a different file</p>
        }

        @if (uploadError is not null)
        {
            <div class="alert alert-danger">@uploadError</div>
        }

        <EditForm FormName="upload" Model="Upload" OnValidSubmit="HandleUploadAsync"
                  method="post" enctype="multipart/form-data" class="space-y-4">
            <div>
                <label class="form-label" for="file">CSV file</label>
                <div data-file-picker class="flex flex-wrap items-center gap-3">
                    <input type="file" id="file" name="Upload.File" accept=".csv,text/csv" required class="sr-only" />
                    <label for="file" class="btn-secondary cursor-pointer">Choose file</label>
                    <span data-file-chosen hidden class="text-sm text-gray-700 dark:text-gray-300">
                        <span class="inline-flex items-center gap-2 align-middle">
                            <span data-file-name class="break-all font-medium"></span>
                            <button type="button" data-file-remove
                                    class="font-medium text-red-600 hover:underline dark:text-red-400">Remove</button>
                        </span>
                    </span>
                </div>
            </div>
            @* Hidden by CSS until a file is chosen (app.css: the required file input is :invalid
               while empty) — from first paint, after enhanced navigation, and without JS. *@
            <button type="submit" data-file-submit class="btn-primary">Validate</button>
        </EditForm>
    </div>

    @if (plan is not null)
    {
        var errors = plan.Errors.ToList();
        var warnings = plan.Warnings.ToList();
        var infos = plan.Infos.ToList();
        <div class="mt-6 space-y-6" data-import-preview>
            @* At a glance: can it go, and what will it do. *@
            <div class="card flex flex-wrap items-center gap-x-6 gap-y-3" data-import-summary>
                @if (!plan.CanImport)
                {
                    <span class="badge badge-red" data-import-status>@Plural(errors.Count, "error") to fix</span>
                }
                else if (!plan.HasChanges)
                {
                    <span class="badge badge-gray" data-import-status>Nothing to change</span>
                }
                else
                {
                    <span class="badge badge-brand" data-import-status>Ready to import</span>
                }
                @if (warnings.Count > 0)
                {
                    <span class="badge badge-amber">@Plural(warnings.Count, "warning")</span>
                }
                <dl class="flex flex-wrap gap-x-5 gap-y-1 text-sm" data-import-counts>
                    @foreach (var (label, count) in SummaryCounts(plan))
                    {
                        <div class="flex items-baseline gap-1.5">
                            <dt class="text-gray-500 dark:text-gray-400">@label</dt>
                            <dd class="font-semibold tabular-nums text-gray-900 dark:text-white">@count</dd>
                        </div>
                    }
                </dl>
            </div>

            @if (errors.Count > 0)
            {
                <div class="alert alert-danger" data-import-errors>
                    <p class="font-medium">This file can't be imported yet — fix these in the file and upload it again:</p>
                    <ul class="mt-2 space-y-1.5">
                        @foreach (var issue in errors)
                        {
                            <li class="flex gap-2">@RowTag(issue)<span>@issue.Message</span></li>
                        }
                    </ul>
                </div>
            }

            @if (warnings.Count > 0)
            {
                <div class="alert alert-warning" data-import-warnings>
                    <p class="font-medium">Check these before importing — they won't stop the import:</p>
                    <ul class="mt-2 space-y-1.5">
                        @foreach (var issue in warnings)
                        {
                            <li class="flex gap-2">@RowTag(issue)<span>@issue.Message</span></li>
                        }
                    </ul>
                </div>
            }

            @if (infos.Count > 0)
            {
                <details class="rounded-md border border-gray-200 bg-white px-4 py-3 text-sm dark:border-gray-800 dark:bg-gray-900" data-import-infos>
                    <summary class="cursor-pointer font-medium text-gray-700 dark:text-gray-300">
                        @(plan.CanImport ? "What will happen" : "What would happen once the errors are fixed")
                        <span class="font-normal text-gray-400">· @infos.Count @(infos.Count == 1 ? "note" : "notes")</span>
                    </summary>
                    <ul class="mt-2 list-disc space-y-1 pl-5 text-gray-600 dark:text-gray-400">
                        @foreach (var issue in infos)
                        {
                            <li>@issue.Message</li>
                        }
                    </ul>
                </details>
            }

            @* Only what the import will change: new scopes / cases, renamed scopes, moved and updated cases
               (with a line diff of their steps), and new defect links. Cases the file already matches are
               hidden and counted. Each case's own warnings / errors sit under it. *@
            @if (plan.CanImport && !plan.HasChanges)
            {
                <div class="card text-center" data-import-nothing>
                    <p class="text-sm text-gray-700 dark:text-gray-300">Nothing to change — this project already matches the file.</p>
                    <p class="mt-1 text-xs text-gray-400">@Plural(plan.CasesUnchanged, "test case") checked.</p>
                </div>
            }
            else if (plan.CasesUnchanged > 0)
            {
                <p class="text-sm text-gray-500 dark:text-gray-400" data-import-unchanged>
                    @Plural(plan.CasesUnchanged, "test case") already @(plan.CasesUnchanged == 1 ? "matches" : "match") the file and won't be touched — not shown below.
                </p>
            }

            @foreach (var scope in plan.Scopes.Where(s => s.HasChanges))
            {
                <section class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm
                                dark:border-gray-800 dark:bg-gray-900" data-import-scope="@scope.Name">
                    <header class="flex flex-wrap items-center gap-2 border-b border-gray-200 px-5 py-3 dark:border-gray-800">
                        <span class="whitespace-nowrap font-mono text-xs text-gray-400" data-scope-ref>@(scope.Number is { } n ? TestCaseDisplay.ScopeRef(n) : "new")</span>
                        <h2 class="min-w-0 truncate">
                            @if (scope.Renamed)
                            {
                                <span class="text-red-700 line-through dark:text-red-400" data-old-name>@scope.ExistingName</span>
                                <span class="text-gray-400" aria-hidden="true">→</span>
                            }
                            @scope.Name
                        </h2>
                        <span class="badge badge-gray">@TestCaseDisplay.KindLabel(scope.Kind)</span>
                        @if (scope.KindAssumed)
                        {
                            <span class="badge badge-amber" title="No type in the file — imported as Functional" data-kind-assumed>Type assumed</span>
                        }
                        <span class="badge @(scope.Exists ? "badge-blue" : "badge-brand")">
                            @(scope.Exists ? "Existing scope" : "New scope")
                        </span>
                        @if (scope.Renamed)
                        {
                            <span class="badge badge-amber">Renamed</span>
                        }
                        @if (scope.UnchangedCount > 0)
                        {
                            <span class="ml-auto text-xs text-gray-400">@scope.UnchangedCount unchanged not shown</span>
                        }
                    </header>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm">
                            <thead class="border-b border-gray-200 text-xs uppercase tracking-wide text-gray-400 dark:border-gray-800">
                                <tr>
                                    <th class="w-16 px-5 py-2 font-semibold">ID</th>
                                    <th class="px-5 py-2 font-semibold">Scenario</th>
                                    <th class="px-5 py-2 font-semibold">Steps</th>
                                    <th class="px-5 py-2 font-semibold">New defect links</th>
                                    <th class="px-5 py-2 font-semibold">Change</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                                @foreach (var c in scope.Cases.Where(c => c.HasChanges))
                                {
                                    var caseIssues = plan.IssuesFor(scope, c).ToList();
                                    var hasError = caseIssues.Any(i => i.Severity == ImportSeverity.Error);
                                    <tr data-import-case="@c.Scenario"
                                        class="@(hasError ? "bg-red-50/60 dark:bg-red-950/30" : caseIssues.Count > 0 ? "bg-amber-50/60 dark:bg-amber-950/20" : "")">
                                        <td class="whitespace-nowrap px-5 py-3 align-top font-mono text-xs text-gray-400" data-case-ref>
                                            @(c.Number is { } caseNumber ? TestCaseDisplay.CaseRef(caseNumber) : "new")
                                        </td>
                                        <td class="px-5 py-3 align-top font-medium">
                                            @if (c.ScenarioChanged)
                                            {
                                                <span class="block text-red-700 line-through dark:text-red-400">@c.ExistingScenario</span>
                                                <span class="block text-brand-700 dark:text-brand-400">@c.Scenario</span>
                                            }
                                            else
                                            {
                                                @c.Scenario
                                            }
                                            @if (c.MovedFrom is not null)
                                            {
                                                <span class="mt-0.5 block text-xs font-normal text-amber-700 dark:text-amber-400" data-moved-from>
                                                    Moving from “@c.MovedFrom”
                                                </span>
                                            }
                                            @foreach (var issue in caseIssues)
                                            {
                                                <span class="mt-1 block text-xs font-normal @(issue.Severity == ImportSeverity.Error ? "text-red-700 dark:text-red-400" : "text-amber-700 dark:text-amber-400")"
                                                      data-case-issue="@issue.Severity">
                                                    @(issue.Severity == ImportSeverity.Error ? "Error" : "Check"): @issue.Message
                                                </span>
                                            }
                                        </td>
                                        <td class="px-5 py-3 align-top text-gray-600 dark:text-gray-400">
                                            @if (c.Action == ImportAction.Create)
                                            {
                                                <span class="whitespace-pre-line">@(c.Steps ?? "—")</span>
                                            }
                                            else if (c.StepsChanged)
                                            {
                                                @* - removed (red), + added (green), unchanged lines muted. *@
                                                <ul class="space-y-0.5 font-mono text-xs" data-steps-diff>
                                                    @foreach (var line in c.StepsDiff)
                                                    {
                                                        <li class="@DiffClass(line.Change) rounded px-1.5 py-0.5" data-diff="@line.Change">
                                                            <span aria-hidden="true">@DiffMark(line.Change)</span> @line.Text
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <span class="text-xs text-gray-400">Unchanged</span>
                                            }
                                        </td>
                                        <td class="px-5 py-3 align-top text-gray-600 dark:text-gray-400">
                                            @(c.NewLinks.Count == 0 ? "—" : string.Join(", ", c.NewLinks.Select(l => DefectDisplay.Ref(l.Number))))
                                        </td>
                                        <td class="px-5 py-3 align-top">
                                            <span class="flex flex-wrap gap-1">
                                                @foreach (var (label, badge) in ChangeBadges(c))
                                                {
                                                    <span class="badge @badge">@label</span>
                                                }
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }

            <div class="flex flex-wrap items-center gap-3">
                <EditForm FormName="import" Model="Confirm" OnValidSubmit="HandleImportAsync" method="post">
                    <textarea name="Confirm.Csv" hidden>@rawCsv</textarea>
                    @if (plan.CanImport && plan.HasChanges)
                    {
                        <button type="submit" class="btn-primary">Import @Describe(plan)</button>
                    }
                </EditForm>
                <a href="projects/@project.Id/test-cases" class="btn-outline">Cancel</a>
                @if (!plan.CanImport)
                {
                    <span class="text-sm text-gray-500 dark:text-gray-400">Fix the errors above in your file, then choose it again.</span>
                }
            </div>
        </div>
    }
}

@code {
    private const long MaxBytes = 512 * 1024;

    [Parameter]
    public Guid ProjectId { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "upload")]
    private UploadModel Upload { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "import")]
    private ConfirmModel Confirm { get; set; } = default!;

    private Project? project;
    private bool notFound;
    private string? uploadError;
    private string? rawCsv;
    private ImportPlan? plan;

    protected override async Task OnParametersSetAsync()
    {
        Upload ??= new();
        Confirm ??= new();

        project = await Projects.GetAsync(ProjectId);
        if (project is null)
        {
            notFound = true;
            return;
        }

        // On the confirm POST, rebuild the plan up front so the "import" form is in the
        // render tree for Blazor's form mapping. The apply itself runs in HandleImportAsync.
        if (HttpMethods.IsPost(HttpContext.Request.Method) && !string.IsNullOrEmpty(Confirm.Csv))
        {
            rawCsv = Confirm.Csv;
            plan = await Import.BuildPlanAsync(ProjectId, TestCaseImportParser.Parse(rawCsv));
        }
    }

    private async Task HandleUploadAsync()
    {
        var file = Upload.File;
        if (file is null || file.Length == 0)
        {
            uploadError = "Choose a CSV file to import.";
            return;
        }

        if (!string.Equals(Path.GetExtension(file.FileName), ".csv", StringComparison.OrdinalIgnoreCase))
        {
            uploadError = "Only .csv files can be imported.";
            return;
        }

        if (file.Length > MaxBytes)
        {
            uploadError = $"The file is larger than the {MaxBytes / 1024} KB import limit — split it into smaller files.";
            return;
        }

        using var reader = new StreamReader(file.OpenReadStream(), Encoding.UTF8);
        rawCsv = await reader.ReadToEndAsync();

        plan = await Import.BuildPlanAsync(ProjectId, TestCaseImportParser.Parse(rawCsv));
    }

    private async Task HandleImportAsync()
    {
        if (string.IsNullOrEmpty(rawCsv))
        {
            return;
        }

        var parsed = TestCaseImportParser.Parse(rawCsv);
        plan = await Import.BuildPlanAsync(ProjectId, parsed);
        if (!plan.CanImport)
        {
            return;
        }

        var userId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier)
            ?? throw new InvalidOperationException("No user id on the current principal.");

        var result = await Import.ApplyAsync(ProjectId, parsed, userId);
        if (!result.Committed)
        {
            return;
        }

        var parts = new List<string>
        {
            Plural(result.ScopesCreated, "new scope"),
            Plural(result.CasesCreated, "new test case"),
            Plural(result.CasesUpdated, "updated test case"),
        };
        if (result.ScopesRenamed > 0) parts.Add(Plural(result.ScopesRenamed, "renamed scope"));
        if (result.CasesMoved > 0) parts.Add(Plural(result.CasesMoved, "moved test case"));
        parts.Add(Plural(result.DefectsLinked, "defect link"));
        var summary = $"Imported {string.Join(", ", parts.Take(parts.Count - 1))} and {parts[^1]}.";

        Nav.NavigateTo($"projects/{ProjectId}/test-cases?imported={Uri.EscapeDataString(summary)}");
    }

    private static string Describe(ImportPlan plan)
    {
        var parts = new List<string>();
        if (plan.ScopesToCreate > 0) parts.Add(Plural(plan.ScopesToCreate, "scope"));
        if (plan.CasesToCreate > 0) parts.Add(Plural(plan.CasesToCreate, "new case"));
        if (plan.CasesToUpdate > 0) parts.Add(Plural(plan.CasesToUpdate, "update"));
        if (plan.CasesToMove > 0) parts.Add(Plural(plan.CasesToMove, "move"));
        if (plan.ScopesToRename > 0) parts.Add(Plural(plan.ScopesToRename, "scope rename"));
        if (plan.LinksToAdd > 0) parts.Add(Plural(plan.LinksToAdd, "defect link"));
        return parts.Count > 0 ? string.Join(" · ", parts) : "changes";
    }

    /// <summary>What happens to a case, as badges: New / Update / Moved / New links.</summary>
    private static IEnumerable<(string Label, string Badge)> ChangeBadges(CasePlan c)
    {
        if (c.Action == ImportAction.Create) yield return ("New", "badge-brand");
        if (c.Action == ImportAction.Update) yield return (c.ScenarioChanged && !c.StepsChanged ? "Renamed" : "Update", "badge-amber");
        if (c.MovedFrom is not null) yield return ("Moved", "badge-orange");
        if (c.NewLinks.Count > 0 && c.Action != ImportAction.Create) yield return ("New links", "badge-blue");
    }

    /// <summary>The summary bar's counts — only the non-zero ones.</summary>
    private static IEnumerable<(string Label, int Count)> SummaryCounts(ImportPlan plan) =>
        new (string, int)[]
        {
            ("New scopes", plan.ScopesToCreate),
            ("Renamed scopes", plan.ScopesToRename),
            ("New test cases", plan.CasesToCreate),
            ("Updated", plan.CasesToUpdate),
            ("Moved", plan.CasesToMove),
            ("Defect links", plan.LinksToAdd),
            ("Unchanged", plan.CasesUnchanged),
        }.Where(x => x.Item2 > 0);

    /// <summary>"Row 4" chip in front of a message tied to a row of the file.</summary>
    private static RenderFragment RowTag(ImportIssue issue) => issue.Row is { } row
        ? @<span class="shrink-0 rounded bg-black/5 px-1.5 py-0.5 font-mono text-xs dark:bg-white/10" data-issue-row>Row @row</span>
        : @<span class="hidden"></span>;

    private static string DiffClass(LineChange change) => change switch
    {
        LineChange.Removed => "bg-red-50 text-red-800 line-through dark:bg-red-950 dark:text-red-300",
        LineChange.Added => "bg-brand-50 text-brand-800 dark:bg-brand-950 dark:text-brand-300",
        _ => "text-gray-500 dark:text-gray-400",
    };

    private static string DiffMark(LineChange change) => change switch
    {
        LineChange.Removed => "−",
        LineChange.Added => "+",
        _ => "\u00a0",
    };

    private static string Plural(int n, string noun) => $"{n} {noun}{(n == 1 ? string.Empty : "s")}";

    public sealed class UploadModel
    {
        public IFormFile? File { get; set; }
    }

    public sealed class ConfirmModel
    {
        public string? Csv { get; set; }
    }
}
