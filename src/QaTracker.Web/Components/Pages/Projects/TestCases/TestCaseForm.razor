@page "/projects/{ProjectId:guid}/test-cases/scopes/{ScopeId:guid}/cases/new"
@page "/projects/{ProjectId:guid}/test-cases/scopes/{ScopeId:guid}/cases/{TestCaseId:guid}/edit"
@using System.ComponentModel.DataAnnotations
@attribute [Authorize(Policy = Policies.ManageTestCases)]
@inject TestScopeService TestScopes
@inject TestCaseService TestCases
@inject DefectService Defects
@inject NavigationManager Nav

<PageTitle>@(IsEdit ? "Edit test case" : "New test case") · QA Tracker</PageTitle>

@if (notFound)
{
    <h1>Not found</h1>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        <a href="projects/@ProjectId/test-cases">Back to test cases</a>.
    </p>
}
else
{
    <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
        <a href="projects/@ProjectId/test-cases" class="no-underline hover:underline">Test cases</a>
        <span class="px-1">/</span>
        <span>@scopeName</span>
    </p>
    <h1>@(IsEdit ? "Edit test case" : "New test case")</h1>

    @if (fromDefectRef is not null)
    {
        <div class="alert alert-success mt-4 max-w-2xl">
            Prefilled from defect <span class="font-mono font-semibold">@fromDefectRef</span>. Saving creates
            the case and links it back to that defect.
        </div>
    }

    <EditForm Model="Model" FormName="test-case" OnValidSubmit="SaveAsync" method="post" class="mt-6 max-w-2xl space-y-6">
        <DataAnnotationsValidator />

        <div class="card space-y-4">
            <div>
                <label class="form-label" for="scenario">Scenario</label>
                <InputText id="scenario" @bind-Value="Model.Scenario" class="form-control"
                           placeholder="The situation under test, e.g. &quot;When a user enters a correct email and password&quot;" />
                <ValidationMessage For="() => Model.Scenario" />
            </div>

            <div>
                <label class="form-label" for="steps">Steps</label>
                <InputTextArea id="steps" @bind-Value="Model.Steps" rows="6" class="form-control"
                               placeholder="One step per line, e.g.&#10;1. Open the login page&#10;2. Enter valid credentials&#10;3. Click Sign in&#10;4. Expect the dashboard to load" />
            </div>
        </div>

        <div class="flex items-center gap-3">
            <button type="submit" class="btn-primary">
                @(IsEdit ? "Save changes" : "Create test case")
            </button>
            <a href="@CancelUrl" class="btn-link">Cancel</a>
        </div>
    </EditForm>

    @if (IsEdit)
    {
        <details class="mt-4 max-w-2xl">
            <summary role="button" class="cursor-pointer list-none text-sm text-red-600 dark:text-red-400 [&::-webkit-details-marker]:hidden">
                Delete test case
            </summary>
            <EditForm Model="Model" FormName="delete-test-case" OnValidSubmit="DeleteAsync" method="post"
                      class="mt-2 flex items-center gap-3">
                <span class="text-sm text-gray-600 dark:text-gray-400">Delete this test case?</span>
                <button type="submit" class="btn-danger">Yes, delete</button>
            </EditForm>
        </details>
    }
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [Parameter]
    public Guid ScopeId { get; set; }

    [Parameter]
    public Guid? TestCaseId { get; set; }

    /// <summary>Set when creating a case from a defect's "Create a new test case" button:
    /// prefill scenario/steps from that defect and link the new case back to it on save.</summary>
    [SupplyParameterFromQuery]
    public Guid? FromDefect { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "test-case")]
    private TestCaseFormModel Model { get; set; } = default!;

    private string scopeName = "";
    private bool notFound;
    private Guid? linkDefectId;
    private string? fromDefectRef;

    private bool IsEdit => TestCaseId is not null;
    private string CancelUrl => IsEdit
        ? $"projects/{ProjectId}/test-cases/scopes/{ScopeId}/cases/{TestCaseId}"
        : linkDefectId is { } d ? $"projects/{ProjectId}/defects/{d}"
        : $"projects/{ProjectId}/test-cases";

    protected override async Task OnParametersSetAsync()
    {
        Model ??= new();

        var scope = await TestScopes.GetAsync(ScopeId);
        if (scope is null || scope.ProjectId != ProjectId)
        {
            notFound = true;
            return;
        }
        scopeName = scope.Name;

        if (IsEdit)
        {
            var testCase = await TestCases.GetAsync(TestCaseId!.Value);
            if (testCase is null || testCase.TestScopeId != ScopeId)
            {
                notFound = true;
                return;
            }

            if (HttpMethods.IsGet(HttpContext.Request.Method))
            {
                Model.Scenario = testCase.Scenario;
                Model.Steps = testCase.Steps;
            }
        }
        else if (FromDefect is { } defectId && (await AuthState).User.IsInRole(Roles.QA))
        {
            // Created from a defect's "Create a new test case" button: prefill from the
            // defect and remember to link the new case back to it on save.
            var defect = await Defects.GetAsync(defectId);
            if (defect is not null && defect.ProjectId == ProjectId)
            {
                linkDefectId = defect.Id;
                fromDefectRef = DefectDisplay.Ref(defect.Number);
                if (HttpMethods.IsGet(HttpContext.Request.Method))
                {
                    Model.Scenario = defect.Summary;
                    Model.Steps = defect.ReproSteps;
                }
            }
        }
    }

    private async Task SaveAsync()
    {
        var input = new TestCaseInput(Model.Scenario, Model.Steps);
        if (IsEdit)
        {
            await TestCases.UpdateAsync(TestCaseId!.Value, input);
            Nav.NavigateTo($"projects/{ProjectId}/test-cases/scopes/{ScopeId}/cases/{TestCaseId}");
        }
        else
        {
            var user = await GetUserIdAsync();
            var created = await TestCases.CreateAsync(ScopeId, input, user);

            if (linkDefectId is { } defectId)
            {
                await Defects.LinkTestCaseAsync(defectId, created.Id);
                Nav.NavigateTo($"projects/{ProjectId}/defects/{defectId}");
                return;
            }

            Nav.NavigateTo($"projects/{ProjectId}/test-cases/scopes/{ScopeId}/cases/{created.Id}");
        }
    }

    private async Task DeleteAsync()
    {
        await TestCases.DeleteAsync(TestCaseId!.Value);
        Nav.NavigateTo($"projects/{ProjectId}/test-cases");
    }

    private async Task<string> GetUserIdAsync()
    {
        var user = (await AuthState).User;
        return user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? throw new InvalidOperationException("No user id on the current principal.");
    }

    public sealed class TestCaseFormModel
    {
        [Required]
        public string Scenario { get; set; } = string.Empty;

        public string? Steps { get; set; }
    }
}
