@page "/projects/{ProjectId:guid}/scopes/{ScopeId:guid}/test-cases/new"
@page "/projects/{ProjectId:guid}/test-cases/{TestCaseId:guid}/edit"
@using System.ComponentModel.DataAnnotations
@attribute [Authorize(Policy = Policies.ManageTestCases)]
@inject TestScopeService TestScopes
@inject TestCaseService TestCases
@inject DefectService Defects
@inject NavigationManager Nav

<PageTitle>@(IsEdit ? "Edit test case" : "New test case") · QA Tracker</PageTitle>

@if (notFound)
{
    <h1>Not found</h1>
    <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        <a href="projects/@ProjectId/test-cases">Back to test cases</a>.
    </p>
}
else
{
    <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
        <a href="projects/@ProjectId/test-cases" class="no-underline hover:underline">Test cases</a>
        <span class="px-1">/</span>
        <span>@scopeName</span>
    </p>
    <h1>@(IsEdit ? "Edit test case" : "New test case")</h1>

    @if (fromDefectRef is not null)
    {
        <div class="alert alert-success mt-4 max-w-2xl">
            Prefilled from defect <span class="font-mono font-semibold">@fromDefectRef</span>. Saving creates
            the case and links it back to that defect.
        </div>
    }

    <EditForm Model="Model" FormName="test-case" OnValidSubmit="SaveAsync" method="post" class="mt-6 max-w-2xl space-y-6">
        <DataAnnotationsValidator />

        <div class="card space-y-4">
            <div>
                <label class="form-label" for="scenario">Scenario</label>
                <InputText id="scenario" @bind-Value="Model.Scenario" class="form-control"
                           placeholder="The situation under test, e.g. &quot;When a user enters a correct email and password&quot;" />
                <ValidationMessage For="() => Model.Scenario" />
            </div>

            <div>
                <label class="form-label" for="steps">Steps</label>
                <InputTextArea id="steps" @bind-Value="Model.Steps" rows="6" class="form-control"
                               placeholder="One step per line, e.g.&#10;1. Open the login page&#10;2. Enter valid credentials&#10;3. Click Sign in&#10;4. Expect the dashboard to load" />
            </div>

            @* Moving keeps the case's result, tester, comments, files and linked defects. *@
            @if (IsEdit && scopeOptions.Count > 1)
            {
                <div>
                    <label class="form-label">Scope</label>
                    <FormSelect Name="Model.ScopeId" Label="Scope" Current="@Model.ScopeId.ToString()" Options="scopeOptions" />
                    <p class="mt-1 text-xs text-gray-400">Pick another scope to move this test case into it.</p>
                </div>
            }

            @if (!IsEdit)
            {
                <FormTip>
                    Once the test case is created you can record its result, attach reference files, and
                    link or raise defects from its page.
                </FormTip>
            }

            <FormActions SaveLabel="@(IsEdit ? "Save changes" : "Create test case")" CancelHref="@CancelUrl"
                         DeleteDialogId="@(IsEdit ? "delete-test-case-modal" : null)" DeleteLabel="Delete test case"
                         RequireChanges="IsEdit" StartDirty="@(!HttpMethods.IsGet(HttpContext.Request.Method))" />
        </div>
    </EditForm>

    @if (IsEdit)
    {
        <ConfirmDeleteDialog Id="delete-test-case-modal" FormName="delete-test-case" Title="Delete test case"
                             ConfirmLabel="Delete test case" OnConfirm="DeleteAsync">
            <p>Delete “@savedScenario”? Its comments, files and history go with it; linked defects are kept.</p>
        </ConfirmDeleteDialog>
    }
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    /// <summary>The scope a new case goes into (create route only — on edit the scope comes from the case).</summary>
    [Parameter]
    public Guid ScopeId { get; set; }

    /// <summary>The scope this form is about: the route's on create, the case's own on edit.</summary>
    private Guid currentScopeId;

    [Parameter]
    public Guid? TestCaseId { get; set; }

    /// <summary>Set when creating a case from a defect's "Create a new test case" button:
    /// prefill scenario/steps from that defect and link the new case back to it on save.</summary>
    [SupplyParameterFromQuery]
    public Guid? FromDefect { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "test-case")]
    private TestCaseFormModel Model { get; set; } = default!;

    private string scopeName = "";
    private string savedScenario = "";
    private IReadOnlyList<SelectMenu.Option> scopeOptions = [];
    private bool notFound;
    private Guid? linkDefectId;
    private string? fromDefectRef;

    private bool IsEdit => TestCaseId is not null;
    private string CancelUrl => IsEdit
        ? AppUrls.TestCase(ProjectId, TestCaseId!.Value)
        : linkDefectId is { } d ? AppUrls.Defect(ProjectId, d)
        : AppUrls.TestPlan(ProjectId);

    protected override async Task OnParametersSetAsync()
    {
        Model ??= new();

        // On edit the case decides its scope (it isn't in the URL); on create the route does.
        var testCase = IsEdit ? await TestCases.GetAsync(TestCaseId!.Value) : null;
        currentScopeId = testCase?.TestScopeId ?? ScopeId;

        var scope = await TestScopes.GetAsync(currentScopeId);
        if (scope is null || scope.ProjectId != ProjectId || (IsEdit && testCase is null))
        {
            notFound = true;
            return;
        }
        scopeName = scope.Name;

        if (IsEdit)
        {
            savedScenario = testCase!.Scenario;
            if (HttpMethods.IsGet(HttpContext.Request.Method))
            {
                Model.Scenario = testCase!.Scenario;
                Model.Steps = testCase.Steps;
                Model.ScopeId = currentScopeId;
            }

            // Every scope in the project, in test-cases-page order; a name used by both a
            // functional and a non-functional scope gets its kind added to tell them apart.
            var scopes = await TestScopes.ListForProjectAsync(ProjectId);
            var duplicateNames = scopes
                .GroupBy(s => s.Name, StringComparer.OrdinalIgnoreCase)
                .Where(g => g.Count() > 1)
                .Select(g => g.Key)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            scopeOptions = scopes
                .Select(s => new SelectMenu.Option(
                    s.Id.ToString(),
                    duplicateNames.Contains(s.Name) ? $"{s.Name} ({TestCaseDisplay.KindLabel(s.Kind)})" : s.Name))
                .ToList();
        }
        else if (FromDefect is { } defectId && (await AuthState).User.IsInRole(Roles.QA))
        {
            // Created from a defect's "Create a new test case" button: prefill from the
            // defect and remember to link the new case back to it on save.
            var defect = await Defects.GetAsync(defectId);
            if (defect is not null && defect.ProjectId == ProjectId)
            {
                linkDefectId = defect.Id;
                fromDefectRef = DefectDisplay.Ref(defect.Number);
                if (HttpMethods.IsGet(HttpContext.Request.Method))
                {
                    Model.Scenario = defect.Summary;
                    Model.Steps = defect.ReproSteps;
                }
            }
        }
    }

    private async Task SaveAsync()
    {
        var input = new TestCaseInput(Model.Scenario, Model.Steps);
        if (IsEdit)
        {
            var editor = await GetUserIdAsync();
            await TestCases.UpdateAsync(TestCaseId!.Value, input, editor);

            // Moving doesn't change the case's address (the scope isn't part of it).
            if (Model.ScopeId != Guid.Empty && Model.ScopeId != currentScopeId)
            {
                await TestCases.MoveAsync(TestCaseId.Value, Model.ScopeId, editor);
            }

            Nav.NavigateTo(AppUrls.TestCase(ProjectId, TestCaseId.Value));
        }
        else
        {
            var user = await GetUserIdAsync();
            var created = await TestCases.CreateAsync(currentScopeId, input, user);

            if (linkDefectId is { } defectId)
            {
                await Defects.LinkTestCaseAsync(defectId, created.Id, user);
                Nav.NavigateTo(AppUrls.Defect(ProjectId, defectId));
                return;
            }

            Nav.NavigateTo(AppUrls.TestCase(ProjectId, created.Id));
        }
    }

    private async Task DeleteAsync()
    {
        await TestCases.DeleteAsync(TestCaseId!.Value, await GetUserIdAsync());
        Nav.NavigateTo(AppUrls.TestPlan(ProjectId));
    }

    private async Task<string> GetUserIdAsync()
    {
        var user = (await AuthState).User;
        return user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? throw new InvalidOperationException("No user id on the current principal.");
    }

    public sealed class TestCaseFormModel
    {
        [Required]
        public string Scenario { get; set; } = string.Empty;

        public string? Steps { get; set; }

        /// <summary>Edit only: the scope to keep the case in, or move it to. Empty when the
        /// picker isn't shown (the project has a single scope).</summary>
        public Guid ScopeId { get; set; }
    }
}
