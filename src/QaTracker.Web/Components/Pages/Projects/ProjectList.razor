@using Microsoft.AspNetCore.Identity
@page "/projects"
@inject ProjectService Projects
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Projects · QA Tracker</PageTitle>

<div class="flex items-center justify-between gap-4">
    <h1>Projects</h1>
    <AuthorizeView Policy="@Policies.ManageProjects">
        <a href="projects/new" class="btn-primary">New project</a>
    </AuthorizeView>
</div>

@if (projects is null)
{
    <p class="mt-6 text-sm text-gray-500">Loading…</p>
}
else if (projects.Count == 0)
{
    <div class="card mt-6 text-center">
        <p class="text-sm text-gray-600 dark:text-gray-400">No projects yet.</p>
        <AuthorizeView Policy="@Policies.ManageProjects">
            <ChildContent>
                <a href="projects/new" class="btn-primary mt-4">Create the first project</a>
            </ChildContent>
            <NotAuthorized>
                <p class="mt-2 text-xs text-gray-400">Projects will appear here once they've been created.</p>
            </NotAuthorized>
        </AuthorizeView>
    </div>
}
else
{
    <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
        Select a project to make it your current one.
    </p>

    <div class="flex flex-wrap items-start gap-3">
        <SearchBox Action="projects" Value="@Q" Placeholder="Search projects" />
        <div class="mt-4"><SelectMenu Action="projects/filter"
                    Large="true"
                    FieldName="filter"
                    Label="Filter projects"
                    Current="@(((int)filter).ToString())"
                    CurrentLabel="@FilterLabel(filter)"
                    Options="filterOptions" /></div>
    </div>

    @if (myProjects.Count == 0 && active.Count == 0 && inactive.Count == 0 && completed.Count == 0)
    {
        <p class="mt-6 text-sm text-gray-500">No projects match “@Q”.</p>
    }
    else
    {
        @if (myProjects.Count > 0)
        {
            @ProjectSection("Your projects", myProjects, "yp", YoursPage)
        }
        @ProjectSection("Active", active, "ap", ActivePage)
        @ProjectSection("Inactive", inactive, "ip", InactivePage)
        @ProjectSection("Completed", completed, "cp", CompletedPage)
    }
}

@code {
    private const int PageSize = 10;

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "q")]
    private string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "yp")]
    private int? YoursPage { get; set; }

    [SupplyParameterFromQuery(Name = "ap")]
    private int? ActivePage { get; set; }

    [SupplyParameterFromQuery(Name = "ip")]
    private int? InactivePage { get; set; }

    [SupplyParameterFromQuery(Name = "cp")]
    private int? CompletedPage { get; set; }

    private IReadOnlyList<Project>? projects;
    private IReadOnlyList<Project> myProjects = [];
    private IReadOnlyList<Project> active = [];
    private IReadOnlyList<Project> inactive = [];
    private IReadOnlyList<Project> completed = [];
    private ProjectListFilter filter = ProjectListFilter.ActiveAndUpcoming;

    private static string FilterLabel(ProjectListFilter f) => f switch
    {
        ProjectListFilter.All => "All projects",
        ProjectListFilter.Active => "Active",
        _ => "Active & Upcoming",
    };

    private static readonly IReadOnlyList<SelectMenu.Option> filterOptions =
        new[] { ProjectListFilter.All, ProjectListFilter.ActiveAndUpcoming, ProjectListFilter.Active }
            .Select(f => new SelectMenu.Option(((int)f).ToString(), FilterLabel(f)))
            .ToList();

    protected override async Task OnParametersSetAsync()
    {
        var all = await Projects.ListAsync();
        projects = all;

        var principal = (await AuthState).User;
        var userId = principal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        IReadOnlyList<Project> mine = string.IsNullOrEmpty(userId) ? [] : await Projects.ListForUserAsync(userId);
        filter = (await UserManager.GetUserAsync(principal))?.ProjectListFilter ?? ProjectListFilter.ActiveAndUpcoming;

        var term = Q?.Trim();

        List<Project> Filter(IEnumerable<Project> source) => string.IsNullOrEmpty(term)
            ? source.ToList()
            : source.Where(p => Matches(p, term)).ToList();

        // "Your projects" only ever lists active work, whatever the filter.
        myProjects = Filter(mine.Where(p => p.Status == ProjectStatus.InFlight));
        // Projects already listed under "Your projects" aren't repeated under Active.
        var mineIds = myProjects.Select(p => p.Id).ToHashSet();
        active = Filter(all.Where(p => p.Status == ProjectStatus.InFlight && !mineIds.Contains(p.Id)));
        inactive = filter == ProjectListFilter.Active ? [] : Filter(all.Where(p => p.Status == ProjectStatus.NotStarted));
        completed = filter == ProjectListFilter.All ? Filter(all.Where(p => p.Status == ProjectStatus.Complete)) : [];
    }

    private static bool Matches(Project p, string term) =>
        p.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
        || (p.Brief?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
        || (p.Notes?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);

    private RenderFragment ProjectSection(
        string title, IReadOnlyList<Project> list, string pageParam, int? requestedPage) => @<text>
        @if (list.Count > 0)
        {
            var totalPages = Math.Max(1, (int)Math.Ceiling(list.Count / (double)PageSize));
            var page = Math.Clamp(requestedPage ?? 1, 1, totalPages);
            var pageItems = list.Skip((page - 1) * PageSize).Take(PageSize).ToList();

            <h2 class="mt-8 flex items-baseline gap-2">
                @title
                <span class="text-sm font-normal text-gray-400">@list.Count</span>
            </h2>
            @* No overflow-hidden here (it would clip the name tooltip on the last row), so the
               first/last rows round their own corners instead. *@
            <ul class="mt-3 divide-y divide-gray-100 rounded-md border border-gray-200
                       dark:divide-gray-800 dark:border-gray-800">
                @foreach (var project in pageItems)
                {
                    <li @key="project.Id" class="first:rounded-t-md last:rounded-b-md">
                        <form method="post" action="projects/switch">
                            <AntiforgeryToken />
                            <input type="hidden" name="projectId" value="@project.Id" />
                            <button type="submit"
                                    class="flex w-full items-center gap-4 rounded-[inherit] bg-white px-4 py-3 text-left transition-colors
                                           hover:bg-gray-50 focus:bg-gray-50 focus:outline-none
                                           dark:bg-gray-900 dark:hover:bg-gray-800/60 dark:focus:bg-gray-800/60">
                                <span class="min-w-0 flex-1">
                                    <span class="group relative block">
                                        <span class="block truncate font-medium text-gray-900 dark:text-white">@project.Name</span>
                                        <span class="link-group-tip left-0 max-w-[min(20rem,100%)] break-words" aria-hidden="true">
                                            @project.Name
                                            <span class="absolute bottom-full left-3 -mb-px h-2 w-2 rotate-45 bg-gray-900 dark:bg-gray-700"></span>
                                        </span>
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(project.Brief))
                                    {
                                        <span class="mt-0.5 block truncate text-sm text-gray-500">@project.Brief</span>
                                    }
                                </span>
                                <span class="@ProjectStatusDisplay.BadgeClass(project.Status) shrink-0">
                                    @ProjectStatusDisplay.Label(project.Status)
                                </span>
                            </button>
                        </form>
                    </li>
                }
            </ul>
            <Pager ParamName="@pageParam" Current="page" TotalPages="totalPages" TotalItems="list.Count"
                   ItemNoun="project" ItemNounPlural="projects" Label="@($"{title} pages")" />
        }
    </text>;
}
