@page "/settings"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.DependencyInjection
@using QaTracker.Web.Auth
@using QaTracker.Web.Data
@using QaTracker.Web.Notifications

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager
@inject IServiceProvider Services

<PageTitle>Settings · QA Tracker</PageTitle>

<h1>Settings</h1>

<div class="card mt-6 max-w-lg">
    <h2>Appearance</h2>
    <p class="mt-1 text-sm text-gray-500">Choose how QA Tracker looks. "System" follows your device setting.</p>

    @* Three buttons, one per preference — clicking one applies it immediately, no Save step. *@
    <EditForm Model="Input" FormName="appearance" OnValidSubmit="SaveAsync" method="post" class="mt-4">
        <div class="inline-flex overflow-hidden rounded-md border border-gray-300 dark:border-gray-700" role="group" aria-label="Appearance">
            @foreach (var option in Enum.GetValues<ThemePreference>())
            {
                var selected = Input.Theme == option;
                <button type="submit" name="Input.Theme" value="@option"
                        title="@Describe(option)"
                        aria-pressed="@(selected ? "true" : "false")"
                        class="@($"px-4 py-2 text-sm font-medium transition-colors first:border-l-0 border-l border-gray-300 dark:border-gray-700 {(selected ? "bg-brand-600 text-white" : "bg-white text-gray-700 hover:bg-gray-100 dark:bg-gray-900 dark:text-gray-200 dark:hover:bg-gray-800")}")">
                    @option
                </button>
            }
        </div>
    </EditForm>
</div>

<div class="card mt-6 max-w-lg">
    <h2>Notifications</h2>
    <p class="mt-1 text-sm text-gray-500">
        Play a sound when a new notification arrives. This only fires for notifications
        picked up in the background — not just for opening the bell.
    </p>

    @* Two buttons, on/off — clicking one applies it immediately, no Save step (same pattern as Appearance above). *@
    <EditForm Model="ToggleInput" FormName="notification-toggle" OnValidSubmit="SaveNotificationToggleAsync" method="post" class="mt-4">
        <div class="inline-flex overflow-hidden rounded-md border border-gray-300 dark:border-gray-700" role="group" aria-label="Notification sound">
            <button type="submit" name="ToggleInput.SoundEnabled" value="true"
                    aria-pressed="@(ToggleInput.SoundEnabled ? "true" : "false")"
                    class="@($"px-4 py-2 text-sm font-medium transition-colors {(ToggleInput.SoundEnabled ? "bg-brand-600 text-white" : "bg-white text-gray-700 hover:bg-gray-100 dark:bg-gray-900 dark:text-gray-200 dark:hover:bg-gray-800")}")">
                On
            </button>
            <button type="submit" name="ToggleInput.SoundEnabled" value="false"
                    aria-pressed="@(!ToggleInput.SoundEnabled ? "true" : "false")"
                    class="@($"px-4 py-2 text-sm font-medium transition-colors border-l border-gray-300 dark:border-gray-700 {(!ToggleInput.SoundEnabled ? "bg-brand-600 text-white" : "bg-white text-gray-700 hover:bg-gray-100 dark:bg-gray-900 dark:text-gray-200 dark:hover:bg-gray-800")}")">
                Off
            </button>
        </div>
    </EditForm>

    @if (ToggleInput.SoundEnabled)
    {
        @* Each row picks the sound immediately on click — no Save step (same pattern as the toggle above). *@
        <EditForm Model="SoundInput" FormName="notification-sound" OnValidSubmit="SaveNotificationSoundAsync" method="post" class="mt-4 space-y-2">
            @foreach (var sound in NotificationSounds.All)
            {
                var selected = SoundInput.Sound == sound.Key;
                <div class="flex items-stretch gap-3 rounded-md border pr-3 text-sm
                            @(selected ? "border-brand-600" : "border-gray-200 hover:bg-gray-50 dark:border-gray-800 dark:hover:bg-gray-800")" @key="sound.Key">
                    <button type="submit" name="SoundInput.Sound" value="@sound.Key"
                            aria-pressed="@(selected ? "true" : "false")"
                            class="@($"flex-1 px-3 py-2 text-left font-medium {(selected ? "text-brand-600 dark:text-brand-400" : "text-gray-700 dark:text-gray-200")}")">
                        @sound.Label
                        @if (selected)
                        {
                            <span aria-hidden="true">&check;</span>
                        }
                    </button>
                    <button type="button" class="btn-secondary btn-sm self-center" data-play-sound="@sound.Key">
                        Preview
                    </button>
                </div>
            }
        </EditForm>
    }
</div>

<div class="card mt-6 max-w-lg">
    <h2>Account</h2>
    <dl class="mt-3 space-y-2 text-sm">
        <div class="flex items-center justify-between">
            <dt class="text-gray-500">Email</dt>
            <dd class="font-medium text-gray-900 dark:text-white">@currentEmail</dd>
        </div>
        <div class="flex items-center justify-between">
            <dt class="text-gray-500">Sign-in method</dt>
            <dd class="font-medium text-gray-900 dark:text-white">
                @(externalProvider is null ? "Local password" : $"{providerLabel} (SSO)")
            </dd>
        </div>
        <div class="flex items-center justify-between">
            <dt class="text-gray-500">Last sign-in</dt>
            <dd class="font-medium text-gray-900 dark:text-white">@lastSignIn</dd>
        </div>
        <div class="flex items-center justify-between">
            <dt class="text-gray-500">Permissions</dt>
            <dd class="flex flex-wrap justify-end gap-1">
                @if (roles.Count == 0)
                {
                    <span class="badge badge-gray">No roles</span>
                }
                else
                {
                    @foreach (var role in roles)
                    {
                        <span class="badge badge-brand" @key="role">@role</span>
                    }
                }
            </dd>
        </div>
    </dl>
</div>

@if (canManageCredentials)
{
    <div class="card mt-6 max-w-lg">
        <h2>Change email</h2>

        @if (EmailSaved)
        {
            <div class="alert alert-success mt-3">Email updated.</div>
        }
        @if (emailError is not null)
        {
            <div class="alert alert-danger mt-3">@emailError</div>
        }

        <EditForm Model="EmailInput" FormName="change-email" OnValidSubmit="ChangeEmailAsync" method="post" class="mt-4 space-y-3">
            <DataAnnotationsValidator />

            <div>
                <label class="form-label" for="new-email">New email</label>
                <InputText id="new-email" @bind-Value="EmailInput.NewEmail" class="form-control" />
                <ValidationMessage For="() => EmailInput.NewEmail" />
            </div>

            <div>
                <label class="form-label" for="email-current-password">Current password</label>
                <InputText type="password" id="email-current-password" @bind-Value="EmailInput.CurrentPassword" class="form-control" autocomplete="off" />
                <ValidationMessage For="() => EmailInput.CurrentPassword" />
            </div>

            <button type="submit" class="btn-primary mt-2">Update email</button>
        </EditForm>
    </div>

    <div class="card mt-6 max-w-lg">
        <h2>Change password</h2>

        @if (PasswordSaved)
        {
            <div class="alert alert-success mt-3">Password updated.</div>
        }
        @if (passwordError is not null)
        {
            <div class="alert alert-danger mt-3">@passwordError</div>
        }

        <EditForm Model="PasswordInput" FormName="change-password" OnValidSubmit="ChangePasswordAsync" method="post" class="mt-4 space-y-3">
            <DataAnnotationsValidator />

            <div>
                <label class="form-label" for="password-current-password">Current password</label>
                <InputText type="password" id="password-current-password" @bind-Value="PasswordInput.CurrentPassword" class="form-control" />
                <ValidationMessage For="() => PasswordInput.CurrentPassword" />
            </div>

            <div>
                <label class="form-label" for="new-password">New password</label>
                <InputText type="password" id="new-password" @bind-Value="PasswordInput.NewPassword" class="form-control" />
                <ValidationMessage For="() => PasswordInput.NewPassword" />
            </div>

            <div>
                <label class="form-label" for="confirm-new-password">Confirm new password</label>
                <InputText type="password" id="confirm-new-password" @bind-Value="PasswordInput.ConfirmNewPassword" class="form-control" />
                <ValidationMessage For="() => PasswordInput.ConfirmNewPassword" />
            </div>

            <button type="submit" class="btn-primary mt-2">Update password</button>
        </EditForm>
    </div>
}
else
{
    <div class="card mt-6 max-w-lg">
        <p class="text-sm text-gray-500">
            @if (externalProvider is not null)
            {
                @($"Your account is managed by {providerLabel}. Email, password and permissions are controlled there.")
            }
            else
            {
                @("This account doesn't have a local password, so email and password can't be changed here.")
            }
        </p>
    </div>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "appearance")]
    private AppearanceModel Input { get; set; } = new();

    [SupplyParameterFromForm(FormName = "notification-toggle")]
    private NotificationToggleModel ToggleInput { get; set; } = new();

    [SupplyParameterFromForm(FormName = "notification-sound")]
    private NotificationSoundModel SoundInput { get; set; } = new();

    [SupplyParameterFromForm(FormName = "change-email")]
    private ChangeEmailModel EmailInput { get; set; } = new();

    [SupplyParameterFromForm(FormName = "change-password")]
    private ChangePasswordModel PasswordInput { get; set; } = new();

    [SupplyParameterFromQuery]
    private bool EmailSaved { get; set; }

    [SupplyParameterFromQuery]
    private bool PasswordSaved { get; set; }

    private string currentEmail = "";
    private string lastSignIn = "—";
    private IList<string> roles = [];
    private bool hasPassword;
    private string? externalProvider;
    private string providerLabel = "SSO";
    private string? emailError;
    private string? passwordError;

    // Only local-password accounts can self-serve email/password; provider-managed accounts
    // are read-only in-app.
    private bool canManageCredentials => hasPassword && externalProvider is null;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            return;
        }

        currentEmail = user.Email ?? user.UserName ?? "";
        lastSignIn = user.LastLoginUtc is { } t
            ? t.UtcDateTime.ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture)
            : "Not recorded yet";
        roles = await UserManager.GetRolesAsync(user);
        hasPassword = await UserManager.HasPasswordAsync(user);
        externalProvider = user.ExternalProvider;
        providerLabel = Services.GetService<OidcAuthSettings>()?.ProviderLabel ?? externalProvider ?? "SSO";

        // Seed the forms from the current values on GET; keep posted values on POST.
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            var claim = HttpContext.User.FindFirst(AdditionalUserClaimsPrincipalFactory.ThemeClaimType)?.Value;
            Input.Theme = Enum.TryParse<ThemePreference>(claim, out var theme) ? theme : ThemePreference.System;

            ToggleInput.SoundEnabled = user.NotificationSoundEnabled;
            SoundInput.Sound = user.NotificationSound;
        }
    }

    private async Task SaveAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is not null)
        {
            user.Theme = Input.Theme;
            await UserManager.UpdateAsync(user);
            await SignInManager.RefreshSignInAsync(user);
        }

        // Full reload so App.razor re-resolves the colour scheme before paint.
        NavigationManager.NavigateTo("settings", forceLoad: true);
    }

    private async Task SaveNotificationToggleAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is not null)
        {
            user.NotificationSoundEnabled = ToggleInput.SoundEnabled;
            await UserManager.UpdateAsync(user);
            await SignInManager.RefreshSignInAsync(user);
        }

        // Full reload so the notification bell picks up the refreshed claim, and so the
        // sound picker below shows/hides based on the new setting.
        NavigationManager.NavigateTo("settings", forceLoad: true);
    }

    private async Task SaveNotificationSoundAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is not null)
        {
            user.NotificationSound = NotificationSounds.IsValid(SoundInput.Sound)
                ? SoundInput.Sound
                : NotificationSounds.Default;
            await UserManager.UpdateAsync(user);
            await SignInManager.RefreshSignInAsync(user);
        }

        // Full reload so the notification bell picks up the refreshed sound claim.
        NavigationManager.NavigateTo("settings", forceLoad: true);
    }

    private async Task ChangeEmailAsync()
    {
        emailError = null;
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            return;
        }

        if (!await UserManager.CheckPasswordAsync(user, EmailInput.CurrentPassword))
        {
            emailError = "Current password is incorrect.";
            return;
        }

        var newEmail = EmailInput.NewEmail.Trim();
        if (await UserManager.FindByEmailAsync(newEmail) is { } existing && existing.Id != user.Id)
        {
            emailError = "That email is already in use.";
            return;
        }

        user.Email = newEmail;
        user.UserName = newEmail;
        user.EmailConfirmed = true;
        var result = await UserManager.UpdateAsync(user);
        if (!result.Succeeded)
        {
            emailError = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        await UserManager.UpdateSecurityStampAsync(user);
        await SignInManager.RefreshSignInAsync(user);
        NavigationManager.NavigateTo("settings?emailSaved=true", forceLoad: true);
    }

    private async Task ChangePasswordAsync()
    {
        passwordError = null;
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, PasswordInput.CurrentPassword, PasswordInput.NewPassword);
        if (!result.Succeeded)
        {
            passwordError = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        NavigationManager.NavigateTo("settings?passwordSaved=true", forceLoad: true);
    }

    private static string Describe(ThemePreference theme) => theme switch
    {
        ThemePreference.System => "Match my device",
        ThemePreference.Light => "Always light",
        ThemePreference.Dark => "Always dark",
        _ => "",
    };

    private sealed class AppearanceModel
    {
        public ThemePreference Theme { get; set; }
    }

    private sealed class NotificationToggleModel
    {
        public bool SoundEnabled { get; set; } = true;
    }

    private sealed class NotificationSoundModel
    {
        public string Sound { get; set; } = NotificationSounds.Default;
    }

    private sealed class ChangeEmailModel
    {
        [Required]
        [EmailAddress]
        public string NewEmail { get; set; } = "";

        [Required]
        public string CurrentPassword { get; set; } = "";
    }

    private sealed class ChangePasswordModel
    {
        [Required]
        public string CurrentPassword { get; set; } = "";

        [Required]
        public string NewPassword { get; set; } = "";

        [Required]
        [Compare(nameof(NewPassword), ErrorMessage = "The new password and confirmation don't match.")]
        public string ConfirmNewPassword { get; set; } = "";
    }
}
