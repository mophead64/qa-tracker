@page "/Error"
@using System.Diagnostics
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@* The exception handler re-executes the failed request against this page, keeping its HTTP
   method — so a failed POST lands here as a POST, which has no antiforgery token to validate. *@
@attribute [Microsoft.AspNetCore.Mvc.IgnoreAntiforgeryToken]
@layout QaTracker.Web.Components.Layout.AuthLayout

<PageTitle>Something went wrong · QA Tracker</PageTitle>

@* Deliberately generic: never render exception messages or stack traces here. The full
   exception is logged server-side; the request ID below is how to find it. *@
<div class="text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-red-600 dark:text-red-400">Error 500</p>
    <h1 class="mt-2">Something went wrong</h1>
    <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
        An unexpected error occurred while handling your request. It has been logged.
        Please try again, and if the problem keeps happening let your administrator know.
    </p>

    @if (ShowRequestId)
    {
        <p class="mt-4 text-xs text-gray-500">
            Reference: <code class="font-mono">@RequestId</code>
        </p>
    }

    <a href="" class="btn-primary mt-6 no-underline">Back to dashboard</a>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
