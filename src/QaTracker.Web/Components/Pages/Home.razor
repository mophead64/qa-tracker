@page "/"
@inject NavigationManager Nav
@inject ProjectService Projects
@using QaTracker.Web.Data
@using QaTracker.Web.Projects

<PageTitle>QA Tracker</PageTitle>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // Land on the current project's dashboard when one is selected and still exists;
        // otherwise send the user to the project picker.
        var user = (await AuthState).User;
        var claim = user.FindFirst(AdditionalUserClaimsPrincipalFactory.CurrentProjectClaimType)?.Value;

        if (Guid.TryParse(claim, out var id) && await Projects.ExistsAsync(id))
        {
            Nav.NavigateTo($"projects/{id}", replace: true);
        }
        else
        {
            Nav.NavigateTo("projects", replace: true);
        }
    }
}
