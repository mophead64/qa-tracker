    private static RenderFragment Icon(string path) =>
        @<svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="@path" />
        </svg>;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        var claim = user.FindFirst(AdditionalUserClaimsPrincipalFactory.CurrentProjectClaimType)?.Value;
        if (Guid.TryParse(claim, out var id))
        {
            currentProject = await Projects.GetAsync(id);
        }
    }
