@* Left navigation. Fixed overlay on small screens (toggled via #sidebar-toggle),
   static column from lg upwards — which the top bar's burger can collapse to an icon rail
   (.nav-collapsed on the layout root, remembered in a cookie; see side-nav.js / app.css).
   Labels stay in the DOM when collapsed (visually hidden), so links keep their names, and each
   gets the app tooltip then (data-tip-collapsed). Its project section tracks the user's current project. *@

@inject ProjectService Projects
@inject QaTracker.Web.Hosting.BuildInfo Build
@inject QaTracker.Web.Hosting.UpdateCheck.UpdateCheckService UpdateCheck
@using QaTracker.Web.Data
@using QaTracker.Web.Hosting.UpdateCheck
@using QaTracker.Web.Projects

<aside data-side-nav
       class="fixed inset-y-0 left-0 z-30 flex w-64 -translate-x-full flex-col border-r border-gray-200
              bg-white transition-[transform,width] peer-checked:translate-x-0
              dark:border-gray-800 dark:bg-gray-900
              lg:static lg:translate-x-0">
    <div class="nav-brand flex h-14 items-center gap-2 border-b border-gray-200 px-4 text-lg font-semibold
                text-gray-900 dark:border-gray-800 dark:text-white">
        <img src="qa-logo.png" alt="QA" class="h-7 w-7 shrink-0" />
        <span class="nav-label">Tracker</span>
    </div>

    <nav class="flex-1 space-y-1 overflow-y-auto p-3 text-sm">
        <NavLink href="projects" Match="NavLinkMatch.All" class="nav-side" ActiveClass="nav-side-active"
                 title="All projects" data-tip-collapsed>
            @Icon(SquaresIcon)<span class="nav-label">All projects</span>
        </NavLink>

        @if (currentProject is not null)
        {
            @* Name and brief are cut off with an ellipsis; the full text appears in the app's
               tooltip (tooltip.js) only when it actually is truncated. *@
            <div class="pb-1 pt-4" data-nav-expanded-only>
                <p class="mx-3 truncate text-sm font-bold text-gray-900 dark:text-white"
                   title="@currentProject.Name" data-tip-truncated>@currentProject.Name</p>
                @if (!string.IsNullOrWhiteSpace(currentProject.Brief))
                {
                    <p class="mx-3 mt-1 truncate text-xs font-medium text-gray-500 dark:text-gray-400"
                       title="@currentProject.Brief" data-tip-truncated>@currentProject.Brief</p>
                }
            </div>
            @* Collapsed, the project's name is hidden; a rule marks where its links start. *@
            <hr class="nav-collapsed-only my-3 border-gray-200 dark:border-gray-800" />
            <NavLink href="@($"projects/{currentProject.Id}")" Match="NavLinkMatch.All"
                     class="nav-side" ActiveClass="nav-side-active" title="Dashboard" data-tip-collapsed>
                @Icon(HomeIcon)<span class="nav-label">Dashboard</span>
            </NavLink>
            <NavLink href="@($"projects/{currentProject.Id}/test-cases")"
                     class="nav-side" ActiveClass="nav-side-active" title="Test cases" data-tip-collapsed>
                @Icon(ClipboardIcon)<span class="nav-label">Test cases</span>
            </NavLink>
            <NavLink href="@($"projects/{currentProject.Id}/defects")"
                     class="nav-side" ActiveClass="nav-side-active" title="Defects" data-tip-collapsed>
                @Icon(BugIcon)<span class="nav-label">Defects</span>
            </NavLink>
        }
    </nav>

    <p class="px-6 pb-3 font-mono text-xs text-gray-400" title="QA Tracker version" data-nav-expanded-only>@Build.DisplayVersion</p>

    <AuthorizeView Roles="@Roles.QA">
        <div class="border-t border-gray-200 p-3 text-sm dark:border-gray-800">
            <NavLink href="admin" class="nav-side relative" ActiveClass="nav-side-active" title="System settings" data-tip-collapsed>
                @Icon(CogIcon)<span class="nav-label">System settings</span>
                @if (UpdateCheck.Current.State == UpdateState.UpdateAvailable)
                {
                    <span class="nav-update-dot inline-block h-2 w-2 shrink-0 rounded-full bg-amber-500"
                          title="Update available"></span>
                }
            </NavLink>
        </div>
    </AuthorizeView>
</aside>

