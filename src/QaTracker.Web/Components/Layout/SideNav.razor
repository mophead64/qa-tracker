@* Left navigation. Fixed overlay on small screens (toggled via #sidebar-toggle),
   static column from lg upwards. Its project section tracks the user's current project. *@

@inject ProjectService Projects
@using QaTracker.Web.Data
@using QaTracker.Web.Projects

<aside class="fixed inset-y-0 left-0 z-30 flex w-64 -translate-x-full flex-col border-r border-gray-200
              bg-white transition-transform peer-checked:translate-x-0
              dark:border-gray-800 dark:bg-gray-900
              lg:static lg:translate-x-0">
    <div class="flex h-14 items-center gap-2 border-b border-gray-200 px-4 text-lg font-semibold
                text-gray-900 dark:border-gray-800 dark:text-white">
        <img src="qa-logo.png" alt="QA" class="h-7 w-7" />
        Tracker
    </div>

    <nav class="flex-1 space-y-1 overflow-y-auto p-3 text-sm">
        <NavLink href="projects" Match="NavLinkMatch.All" class="nav-side" ActiveClass="nav-side-active">
            All projects
        </NavLink>

        @if (currentProject is not null)
        {
            <p class="px-3 pb-1 pt-4 text-xs font-semibold uppercase tracking-wide text-gray-400">
                @currentProject.Name
            </p>
            <NavLink href="@($"projects/{currentProject.Id}")" Match="NavLinkMatch.All"
                     class="nav-side" ActiveClass="nav-side-active">
                Dashboard
            </NavLink>
            <NavLink href="@($"projects/{currentProject.Id}/test-cases")"
                     class="nav-side" ActiveClass="nav-side-active">
                Test cases
            </NavLink>
            <NavLink href="@($"projects/{currentProject.Id}/defects")"
                     class="nav-side" ActiveClass="nav-side-active">
                Defects
            </NavLink>
        }
    </nav>

    <AuthorizeView Roles="@Roles.QA">
        <div class="border-t border-gray-200 p-3 dark:border-gray-800">
            <NavLink href="admin" class="nav-side" ActiveClass="nav-side-active">
                System settings
            </NavLink>
        </div>
    </AuthorizeView>
</aside>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Project? currentProject;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        var claim = user.FindFirst(AdditionalUserClaimsPrincipalFactory.CurrentProjectClaimType)?.Value;
        if (Guid.TryParse(claim, out var id))
        {
            currentProject = await Projects.GetAsync(id);
        }
    }
}
