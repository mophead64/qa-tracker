@implements IDisposable
@inject NavigationManager NavigationManager
@inject ProjectService Projects
@using System.Security.Claims
@using QaTracker.Web.Data
@using QaTracker.Web.Projects

<header class="sticky top-0 z-10 flex h-14 items-center gap-3 border-b border-gray-200 bg-white/95
               px-4 backdrop-blur dark:border-gray-800 dark:bg-gray-900/95">
    @* Burger: on small screens it slides the nav in (the #sidebar-toggle checkbox); from lg up it
       collapses the nav to an icon rail and back (side-nav.js). *@
    <label for="sidebar-toggle"
           class="-ml-1 cursor-pointer rounded-md p-2 text-gray-600 hover:bg-gray-100
                  dark:text-gray-300 dark:hover:bg-gray-800 lg:hidden"
           aria-label="Toggle navigation">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
        </svg>
    </label>
    <button type="button" data-nav-collapse-toggle aria-label="Collapse navigation" aria-expanded="true"
            class="-ml-1 hidden rounded-md p-2 text-gray-600 hover:bg-gray-100
                   dark:text-gray-300 dark:hover:bg-gray-800 lg:inline-flex">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
        </svg>
    </button>

    @* The switcher grows to fit the project name, up to 200 characters wide; beyond that, or when
       the header runs out of room, the name is cut off with an ellipsis. The <details> isn't
       positioned itself, so the panel below is positioned against the sticky header: it can then
       be capped to the header's width and never runs off the right edge of the page. *@
    @* A live region (live-page.js): an in-place change on a live page — a project's status or
       tags — refreshes the switcher too. *@
    <details class="group min-w-0" data-dropdown id="project-switcher" data-live-region>
        <summary class="flex max-w-[200ch] cursor-pointer list-none items-center gap-2 rounded-md
                        border border-gray-200 px-3 py-1.5 text-sm font-medium text-gray-700
                        hover:bg-gray-100 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800
                        [&::-webkit-details-marker]:hidden">
            <span class="truncate">@(currentProject?.Name ?? "Select project")</span>
            <svg class="h-4 w-4 shrink-0 text-gray-400 transition-transform group-open:rotate-180"
                 fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
        </summary>

        @* Header (All projects + a filter box once there are a few projects), then the projects in
           ProjectOrdering order, a rule between status groups — Active and Upcoming soonest start first. Typing filters
           by name, brief or tag (project-switcher.js); ↓/↑ move through the matches, Enter on the box
           opens the first one. The list scrolls on its own so the header stays put. *@
        <div class="absolute left-4 top-[3.25rem] flex max-h-[min(75vh,36rem)] w-max min-w-[min(22rem,calc(100%-2rem))]
                    max-w-[min(52rem,calc(100%-2rem))]
                    flex-col overflow-hidden rounded-md border border-gray-200 text-sm
                    bg-white shadow-lg dark:border-gray-800 dark:bg-gray-900" data-project-switcher>
            <div class="shrink-0 border-b border-gray-100 dark:border-gray-800">
                <a href="projects"
                   class="flex w-full items-center justify-between gap-2 px-3 py-2
                          text-left text-sm text-gray-700 no-underline hover:bg-gray-100
                          dark:text-gray-200 dark:hover:bg-gray-800">
                    <span class="truncate">All projects</span>
                    <span class="w-3 shrink-0 text-brand-600 dark:text-brand-400">@if (currentProject is null) {<text>&check;</text>}</span>
                </a>
                @if (projects.Count > FilterThreshold)
                {
                    <div class="px-2 pb-2">
                        <label class="sr-only" for="project-switcher-filter">Find a project</label>
                        <input id="project-switcher-filter" type="search" class="form-control !py-1.5 text-sm"
                               placeholder="Find a project…" autocomplete="off" autocapitalize="off" spellcheck="false"
                               data-1p-ignore data-lpignore="true" data-bwignore data-form-type="other"
                               data-switcher-filter />
                    </div>
                }
            </div>

            @* Five columns shared by every row (CSS subgrid, so they line up down the list): name (as wide as
               the longest, up to 16rem) · brief (likewise, up to 22rem, cut off past that) · status · tags
               (all of them, right-aligned, wrapping past 20rem) · tick. The panel is only as wide as that needs (w-max), so short names and
               briefs don't leave a gap. Name and brief tooltips show only when cut off (data-tip-truncated).
               Status groups are split by a thin rule. Below sm the brief and tag columns collapse. Rows and
               groups are hidden by project-switcher.js with the hidden attribute, which has to beat their
               display: grid — hence [&[hidden]]:!hidden. *@
            <div class="min-h-0 flex-1 overflow-y-auto py-1" data-switcher-list>
                @if (projects.Count == 0)
                {
                    <p class="px-3 py-2 text-sm text-gray-500">No projects yet.</p>
                }
                else
                {
                    <div class="grid grid-cols-[minmax(0,1fr)_0_auto_0_1rem] gap-x-3
                                sm:grid-cols-[fit-content(16rem)_fit-content(22rem)_auto_fit-content(20rem)_1rem]">
                        @foreach (var group in projects.GroupBy(p => p.Status))
                        {
                            <div class="col-span-full grid grid-cols-subgrid border-gray-100 [&:not(:first-child)]:mt-1
                                        [&:not(:first-child)]:border-t [&:not(:first-child)]:pt-1 dark:border-gray-800
                                        [&[hidden]]:!hidden"
                                 data-switcher-group="@ProjectStatusDisplay.Label(group.Key)">
                                @foreach (var project in group)
                                {
                                    var current = project.Id == currentProject?.Id;
                                    <form method="post" action="projects/switch" data-switcher-item
                                          class="col-span-full grid grid-cols-subgrid [&[hidden]]:!hidden"
                                          data-search="@SearchText(project)" data-project-status="@ProjectStatusDisplay.Label(project.Status)"
                                          @key="project.Id">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="projectId" value="@project.Id" />
                                        <button type="submit"
                                                class="col-span-full grid grid-cols-subgrid items-center py-1.5 pl-3 pr-4 text-left text-sm
                                                       text-gray-700 hover:bg-gray-100 focus:bg-gray-100 focus:outline-none
                                                       dark:text-gray-200 dark:hover:bg-gray-800 dark:focus:bg-gray-800"
                                                data-current="@(current ? "true" : null)">
                                            <span class="col-start-1 truncate font-medium" title="@project.Name" data-tip-truncated
                                                  data-switcher-name>@project.Name</span>
                                            <span class="col-start-2 hidden truncate text-gray-500 dark:text-gray-400 sm:block"
                                                  title="@project.Brief" data-tip-truncated data-switcher-brief>@project.Brief</span>
                                            <span class="col-start-3"><span class="@ProjectStatusDisplay.BadgeClass(project.Status)"
                                                  data-switcher-status>@ProjectStatusDisplay.Label(project.Status)</span></span>
                                            <span class="col-start-4 hidden justify-self-end sm:block">
                                                <TagBadges Tags="project.Tags" Class="justify-end" />
                                            </span>
                                            <span class="col-start-5 text-center text-brand-600 dark:text-brand-400">@if (current) {<text>&check;</text>}</span>
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                    <p class="px-3 py-2 text-sm text-gray-500" data-switcher-empty hidden>No projects match.</p>
                }
            </div>
        </div>
    </details>

    <div class="ml-auto flex shrink-0 items-center gap-1">
        <AuthorizeView>
            <Authorized>
                <NotificationBell />
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <details class="group relative" role="menu" data-dropdown>
                    <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md px-2 py-1.5
                                    text-sm font-medium text-gray-700 hover:bg-gray-100
                                    dark:text-gray-200 dark:hover:bg-gray-800 [&::-webkit-details-marker]:hidden">
                        <span class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-600
                                     text-xs font-semibold text-white">
                            @Initials(DisplayName(context))
                        </span>
                        <span class="hidden sm:inline" data-current-user>@DisplayName(context)</span>
                        <svg class="h-4 w-4 text-gray-400 transition-transform group-open:rotate-180"
                             fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                        </svg>
                    </summary>

                    <div class="absolute right-0 mt-2 w-48 overflow-hidden rounded-md border border-gray-200
                                bg-white py-1 shadow-lg dark:border-gray-800 dark:bg-gray-900">
                        <div class="border-b border-gray-100 px-3 py-2 dark:border-gray-800">
                            <p class="truncate text-sm font-medium text-gray-900 dark:text-white">@DisplayName(context)</p>
                            <p class="truncate text-xs text-gray-500">@context.User.Identity?.Name</p>
                        </div>
                        <a href="settings"
                           class="block px-3 py-2 text-sm text-gray-700 no-underline hover:bg-gray-100
                                  dark:text-gray-200 dark:hover:bg-gray-800">Settings</a>
                        <form action="Account/Logout" method="post" class="block">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                            <button type="submit"
                                    class="w-full px-3 py-2 text-left text-sm text-gray-700 hover:bg-gray-100
                                           dark:text-gray-200 dark:hover:bg-gray-800">Logout</button>
                        </form>
                    </div>
                </details>
            </Authorized>
        </AuthorizeView>
    </div>
</header>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    /// <summary>The filter box shows once there are more projects than this.</summary>
    private const int FilterThreshold = 6;

    private string? currentUrl;
    private IReadOnlyList<Project> projects = [];
    private Project? currentProject;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        // Offer the same projects as the user's filter on the All Projects page.
        var user = (await AuthState).User;
        projects = await Projects.ListForSwitcherAsync(user.FindFirst(ClaimTypes.NameIdentifier)?.Value);

        var claim = user.FindFirst(AdditionalUserClaimsPrincipalFactory.CurrentProjectClaimType)?.Value;
        if (Guid.TryParse(claim, out var id))
        {
            // Still name the current project in the toggle even if the filter hides it.
            currentProject = projects.FirstOrDefault(p => p.Id == id)
                ?? await Projects.GetAsync(id);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    // What the switcher's filter box matches: name, brief and tag names, lower-cased.
    private static string SearchText(Project project) =>
        string.Join(' ', new[] { project.Name, project.Brief ?? "" }.Concat(project.Tags.Select(t => t.Name))).ToLowerInvariant();

    private static string DisplayName(AuthenticationState context)
    {
        var fullName = context.User.FindFirst("FullName")?.Value;
        return string.IsNullOrWhiteSpace(fullName)
            ? context.User.Identity?.Name ?? "Account"
            : fullName;
    }

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => (parts[0][..1] + parts[^1][..1]).ToUpperInvariant(),
        };
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
