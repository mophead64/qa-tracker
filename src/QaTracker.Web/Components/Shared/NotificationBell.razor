@* Notification bell in the top bar. Static SSR: the page carries only the unread count;
   the dropdown's list is fetched from /notifications/panel each time it opens, and the
   badge/toasts are kept live by polling /notifications/feed — both in notification-poll.js.
   So notification text never sits in every page's DOM.

   The sound prefs (data-notif-sound / data-notif-sound-enabled) come from claims baked into
   the sign-in cookie — see AdditionalUserClaimsPrincipalFactory — so notification-poll.js can
   read them with no extra request, same as data-poll-seconds below. *@
@using QaTracker.Web.Data
@using QaTracker.Web.Notifications
@inject NotificationService Notifications
@inject IConfiguration Configuration

<details id="notification-bell" class="group relative" data-dropdown data-poll-seconds="@pollSeconds"
          data-notif-sound="@soundKey" data-notif-sound-enabled="@(soundEnabled ? "true" : "false")">
    <summary class="relative flex cursor-pointer list-none items-center rounded-md p-2 text-gray-600
                    hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800 [&::-webkit-details-marker]:hidden"
             aria-label="Notifications">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967
                     8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714
                     0a3 3 0 1 1-5.714 0" />
        </svg>
        @if (count > 0)
        {
            <span class="absolute right-0.5 top-0.5 flex h-4 min-w-4 items-center justify-center rounded-full
                         bg-red-600 px-1 text-[10px] font-semibold leading-none text-white">
                @(count > 9 ? "9+" : count.ToString())
            </span>
        }
    </summary>

    <div data-notif-panel
         class="absolute right-0 z-20 mt-2 max-h-96 w-80 overflow-y-auto rounded-md border border-gray-200
                bg-white py-1 shadow-lg dark:border-gray-800 dark:bg-gray-900">
        <p class="px-3 py-4 text-center text-sm text-gray-500">Loading…</p>
    </div>
</details>

@* Toast shown by notification-poll.js when a poll turns up a notification the tab hasn't
   seen yet. Kept here as a <template> so Tailwind picks up its classes. *@
<template id="notif-toast-template">
    <a class="notif-toast pointer-events-auto block rounded-md border border-gray-200 bg-white p-3 text-sm
              no-underline shadow-lg transition-opacity duration-300 dark:border-gray-700 dark:bg-gray-900">
        <span data-toast-message class="block text-gray-800 dark:text-gray-100"></span>
        <span data-toast-project class="mt-0.5 block text-xs text-gray-400" hidden></span>
    </a>
</template>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private int count;
    private string soundKey = NotificationSounds.Default;
    private bool soundEnabled = true;

    // How often notification-poll.js re-checks the backend, per open tab. Clamped to a
    // sane range; QATRACKER_NOTIFICATIONS_POLL_SECONDS overrides the 45s default.
    private int pollSeconds =>
        Math.Clamp(Configuration.GetValue("QATRACKER_NOTIFICATIONS_POLL_SECONDS", 45), 5, 3600);

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        if (!string.IsNullOrEmpty(userId))
        {
            count = await Notifications.CountActiveAsync(userId);
        }

        var claimSound = user.FindFirst(AdditionalUserClaimsPrincipalFactory.NotificationSoundClaimType)?.Value;
        soundKey = NotificationSounds.IsValid(claimSound) ? claimSound! : NotificationSounds.Default;

        var claimEnabled = user.FindFirst(AdditionalUserClaimsPrincipalFactory.NotificationSoundEnabledClaimType)?.Value;
        soundEnabled = !bool.TryParse(claimEnabled, out var enabled) || enabled;
    }
}
