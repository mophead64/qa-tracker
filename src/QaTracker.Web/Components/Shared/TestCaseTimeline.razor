@using QaTracker.Web.TestCases

@* A test case's history, phrased for the shared HistoryTimeline. Result changes colour the dot
   with the new result's colour; everything else stays neutral, so the run history stands out. *@
<HistoryTimeline Entries="@CommentHistory.Merge(Events.Select(ToEntry), Comments)" />

@code {
    /// <summary>History entries, newest first (as <see cref="TestCaseService.ListHistoryAsync"/> returns them).</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<TestCaseEventView> Events { get; set; } = [];

    /// <summary>Comments to show among the events (<see cref="CommentHistory.Entries"/>).</summary>
    [Parameter]
    public IEnumerable<HistoryEntry> Comments { get; set; } = [];

    private static HistoryEntry ToEntry(TestCaseEventView e) =>
        new(e.Id, e.Kind.ToString(), e.ActorName, e.OccurredUtc, DotClass(e), Describe(e));

    /// <summary>
    /// "who did what" after the actor's name. On the case's own timeline the case is implied
    /// ("marked it as Passed"); the project activity feed passes <paramref name="subject"/> (a
    /// link to the case) to name it ("marked <i>Signs in</i> as Passed").
    /// </summary>
    public static RenderFragment Describe(TestCaseEventView e, RenderFragment? subject = null) => e.Kind switch
    {
        TestCaseEventKind.Created when subject is null => @<text>created this test case</text>,
        TestCaseEventKind.Created => @<text>created test case @subject</text>,
        TestCaseEventKind.Imported when subject is null => @<text>imported this test case from a CSV file</text>,
        TestCaseEventKind.Imported => @<text>imported test case @subject</text>,
        TestCaseEventKind.Edited => @<text>edited the @(e.ToValue ?? "test case")@(Of(subject))</text>,
        TestCaseEventKind.Moved =>
            @<text>moved @It(subject) from <span class="font-medium">@e.FromValue</span> to <span class="font-medium">@e.ToValue</span></text>,
        TestCaseEventKind.FileAdded => @<text>attached <span class="font-medium">@e.ToValue</span>@(To(subject))</text>,
        TestCaseEventKind.FileRemoved => @<text>removed the attachment <span class="font-medium">@e.FromValue</span>@(From(subject))</text>,
        TestCaseEventKind.DefectLinked => @<text>linked defect <span class="font-medium">@e.ToValue</span>@(To(subject))</text>,
        TestCaseEventKind.DefectUnlinked => @<text>unlinked defect <span class="font-medium">@e.FromValue</span>@(From(subject))</text>,
        TestCaseEventKind.ResultChanged => DescribeResult(e, subject),
        _ when subject is null => @<text>changed this test case</text>,
        _ => @<text>changed test case @subject</text>,
    };

    private static RenderFragment DescribeResult(TestCaseEventView e, RenderFragment? subject)
    {
        var to = e.ToResult ?? TestResult.NotRun;
        if (to == TestResult.NotRun)
        {
            RenderFragment reset = subject is null ? @<text>reset the result</text> : @<text>reset @subject</text>;
            return @<text>@reset to @Badge(TestResult.NotRun)@if (e.FromResult is { } was && was != TestResult.NotRun) {<text> (was @Badge(was))</text>}</text>;
        }

        if (e.FromResult is null or TestResult.NotRun)
        {
            return to == TestResult.Running
                ? @<text>started testing @It(subject) (@Badge(to))</text>
                : @<text>marked @It(subject) as @Badge(to)</text>;
        }

        RenderFragment what = subject ?? (@<text>the result</text>);
        return @<text>changed @what from @Badge(e.FromResult.Value) to @Badge(to)</text>;
    }

    private static RenderFragment It(RenderFragment? subject) => subject ?? (@<text>it</text>);

    private static RenderFragment Of(RenderFragment? subject) => subject is null ? (@<text></text>) : @<text> of @subject</text>;

    private static RenderFragment To(RenderFragment? subject) => subject is null ? (@<text></text>) : @<text> to @subject</text>;

    private static RenderFragment From(RenderFragment? subject) => subject is null ? (@<text></text>) : @<text> from @subject</text>;

    private static RenderFragment Badge(TestResult result) =>
        @<span class="@TestCaseDisplay.ResultBadgeClass(result) align-middle">@TestCaseDisplay.ResultLabel(result)</span>;

    public static string DotClass(TestCaseEventView e) =>
        e.Kind != TestCaseEventKind.ResultChanged ? "" : e.ToResult switch
        {
            TestResult.Passed => "timeline-brand",
            TestResult.Failed => "timeline-red",
            TestResult.Blocked => "timeline-orange",
            TestResult.Inconclusive => "timeline-blue",
            TestResult.Running => "timeline-purple",
            _ => "",
        };
}
