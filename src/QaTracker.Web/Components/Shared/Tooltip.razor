@* A small instant hover/focus tooltip next to an info icon — not the native browser
   `title` tooltip, which has a long hover delay and can't be styled or themed. *@

<span class="group relative inline-flex">
    <button type="button" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300" aria-label="@Text">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
        </svg>
    </button>
    @* Opens down and to the right, flush with the icon's left edge: opening upward or
       centered gets clipped by any ancestor using `overflow-hidden` for rounded corners
       (e.g. the panel cards on the dashboard) when the icon sits near an edge — down
       and rightward stays inside the trigger's own container, which always has room. *@
    <span class="pointer-events-none absolute left-0 top-full z-20 mt-2 w-max max-w-xs
                 rounded-md bg-gray-900 px-2.5 py-1.5 text-left text-xs font-normal leading-snug text-white
                 opacity-0 shadow-lg transition-opacity duration-100
                 group-hover:opacity-100 group-focus-within:opacity-100 dark:bg-gray-700">
        @Text
        <span class="absolute bottom-full left-3 -mb-px h-2 w-2 rotate-45 bg-gray-900 dark:bg-gray-700"></span>
    </span>
</span>

@code {
    /// <summary>The tooltip's message.</summary>
    [Parameter, EditorRequired]
    public string Text { get; set; } = "";
}
