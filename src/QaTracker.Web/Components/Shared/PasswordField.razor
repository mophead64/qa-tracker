@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@using QaTracker.Web.Auth
@inject IOptions<IdentityOptions> Identity

@* A new-password field: the input (ChildContent, which must carry data-password-input), a
   show/hide toggle, a strength meter, "Generate a strong password", Copy, and the password
   rules Identity enforces — ticked off as you type and enforced before the form posts
   (password-field.js), so a weak password never needs a round trip to be rejected. The server
   validates through Identity either way. Generating also fills ConfirmFieldId, when given. *@
<div data-password-field
     data-min-length="@Options.RequiredLength"
     data-require-lower="@Flag(Options.RequireLowercase)"
     data-require-upper="@Flag(Options.RequireUppercase)"
     data-require-digit="@Flag(Options.RequireDigit)"
     data-require-symbol="@Flag(Options.RequireNonAlphanumeric)"
     data-unique="@Options.RequiredUniqueChars"
     data-symbols="@PasswordRules.Symbols"
     data-generate-length="@Math.Max(PasswordRules.GeneratedLength, Options.RequiredLength)"
     data-confirm="@ConfirmFieldId">
    <div class="flex items-stretch gap-2">
        <div class="min-w-0 flex-1">@ChildContent</div>
        <button type="button" class="btn-secondary shrink-0 px-3" data-password-toggle
                aria-label="Show password" aria-pressed="false" title="Show password">
            <svg class="password-eye h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            </svg>
            <svg class="password-eye-off h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
            </svg>
        </button>
    </div>

    <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1">
        <div class="flex min-w-[12rem] flex-1 items-center gap-2">
            <div class="password-meter" data-password-meter data-score="0" aria-hidden="true">
                <span></span><span></span><span></span><span></span>
            </div>
            <span class="w-40 shrink-0 text-xs text-gray-500 dark:text-gray-400" data-password-strength aria-live="polite"></span>
        </div>
        <span class="flex items-center gap-3 text-xs">
            <button type="button" class="btn-link" data-password-generate>Generate a strong password</button>
            <button type="button" class="btn-link group" data-password-copy hidden>
                <span class="group-data-[copied]:hidden">Copy</span><span class="hidden group-data-[copied]:inline">Copied</span>
            </button>
        </span>
    </div>

    <ul class="mt-2 grid gap-x-4 gap-y-0.5 sm:grid-cols-2" data-password-rules aria-label="Password rules">
        @foreach (var rule in PasswordRules.For(Options))
        {
            <li class="password-rule" data-rule="@rule.Key">@rule.Text</li>
        }
    </ul>
</div>

@code {
    /// <summary>The password input (an InputText or input), marked <c>data-password-input</c>.</summary>
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    /// <summary>The id of a "confirm password" input that Generate fills in too, and that's checked
    /// for a match before the form posts.</summary>
    [Parameter]
    public string? ConfirmFieldId { get; set; }

    private PasswordOptions Options => Identity.Value.Password;

    private static string Flag(bool value) => value ? "true" : "false";
}
