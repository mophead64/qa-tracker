@* Colour-coded pill for a user's role: QA green, Dev blue, none grey. *@
@using QaTracker.Web.Data

<span class="@Css">@Text</span>

@code {
    [Parameter]
    public string? Role { get; set; }

    private string Text => string.IsNullOrWhiteSpace(Role) ? "No role" : Role!;

    private string Css => Role switch
    {
        Roles.QA => "badge badge-brand",
        Roles.Dev => "badge badge-blue",
        _ => "badge badge-gray",
    };
}
