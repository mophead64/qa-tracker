@* Previous / "Page X of Y · N items" / Next, driven by a query-string parameter.
   Static SSR — the buttons are plain links that swap one query parameter and keep the
   rest (search terms, other sections' page numbers). Renders nothing for a single page.
   Fragment makes each link land on a section (e.g. #comments) instead of the page top, and
   ClearParams drops one-off flags (an error message, a dialog trigger) the target shouldn't
   repeat. The arrows match the Previous / Next step-through buttons on the test case and defect
   pages; they're aria-hidden so the links' accessible names stay just the labels. *@
@inject NavigationManager Nav

@if (TotalPages > 1)
{
    <nav class="mt-3 flex items-center justify-between gap-2" aria-label="@Label">
        <a href="@PageUrl(Current - 1)"
           class="btn-secondary btn-sm @(Current <= 1 ? "pointer-events-none opacity-50" : "")"
           aria-disabled="@(Current <= 1)"><span aria-hidden="true">&larr;</span> @PreviousLabel</a>
        <span class="text-xs text-gray-400">
            Page @Current of @TotalPages · @TotalItems @(TotalItems == 1 ? ItemNoun : ItemNounPlural)
        </span>
        <a href="@PageUrl(Current + 1)"
           class="btn-secondary btn-sm @(Current >= TotalPages ? "pointer-events-none opacity-50" : "")"
           aria-disabled="@(Current >= TotalPages)">@NextLabel <span aria-hidden="true">&rarr;</span></a>
    </nav>
}

@code {
    /// <summary>Query-string parameter this pager reads and writes (e.g. "page").</summary>
    [Parameter, EditorRequired]
    public string ParamName { get; set; } = "page";

    [Parameter, EditorRequired]
    public int Current { get; set; }

    [Parameter, EditorRequired]
    public int TotalPages { get; set; }

    [Parameter]
    public int TotalItems { get; set; }

    [Parameter]
    public string ItemNoun { get; set; } = "item";

    [Parameter]
    public string ItemNounPlural { get; set; } = "items";

    [Parameter]
    public string Label { get; set; } = "Pages";

    [Parameter]
    public string PreviousLabel { get; set; } = "Previous";

    [Parameter]
    public string NextLabel { get; set; } = "Next";

    /// <summary>Element id (without '#') each link scrolls to on arrival.</summary>
    [Parameter]
    public string? Fragment { get; set; }

    /// <summary>Query parameters to remove from the links, alongside setting the page.</summary>
    [Parameter]
    public IReadOnlyList<string> ClearParams { get; set; } = [];

    private string PageUrl(int target)
    {
        var parameters = new Dictionary<string, object?>();
        foreach (var name in ClearParams)
        {
            parameters[name] = null;
        }
        parameters[ParamName] = Math.Clamp(target, 1, TotalPages);

        var url = Nav.GetUriWithQueryParameters(parameters);
        return string.IsNullOrEmpty(Fragment) ? url : $"{url}#{Fragment}";
    }
}
