@inject TimeProvider Time

@* Shared history timeline (test cases, defects): newest first, a dot per entry joined by a
   rule, "who did what" with a relative time (RelativeTime) and the exact UTC time on hover.
   Callers phrase each entry; see TestCaseTimeline / DefectTimeline. *@
@if (Entries.Count == 0)
{
    <p class="mt-2 text-sm text-gray-400">No history recorded.</p>
}
else
{
    var now = Time.GetUtcNow();
    <ol class="timeline" data-history>
        @foreach (var e in Entries)
        {
            <li class="timeline-item @e.DotClass" data-history-kind="@e.Kind" @key="e.Id">
                <time class="timeline-when" datetime="@e.OccurredUtc.UtcDateTime.ToString("O")"
                      title="@RelativeTime.Timestamp(e.OccurredUtc)">@RelativeTime.Format(e.OccurredUtc, now)</time>
                <div class="timeline-what">
                    <span class="font-medium text-gray-900 dark:text-gray-100">@e.ActorName</span>
                    @e.Description
                </div>
            </li>
        }
    </ol>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<HistoryEntry> Entries { get; set; } = [];
}
