@* A delete that asks first: a small red trigger opens a popover — "Delete this …? This can't be
   undone." with [Cancel] [Delete]. For destructive actions the safe choice comes first and the
   destructive one last (the reverse of create / save rows, where the positive action leads).
   Closes on Cancel, outside click or Escape (dropdown.js). *@
<details class="relative inline-block" data-dropdown data-confirm-delete>
    <summary role="button" aria-label="@Label"
             class="cursor-pointer list-none text-xs font-medium text-red-600 hover:underline dark:text-red-400
                    [&::-webkit-details-marker]:hidden">@TriggerText</summary>
    <div class="absolute right-0 z-20 mt-2 w-60 rounded-md border border-gray-200 bg-white p-3 text-left shadow-lg
                dark:border-gray-800 dark:bg-gray-900">
        <p class="text-sm text-gray-700 dark:text-gray-200">@Prompt</p>
        <p class="mt-0.5 text-xs text-gray-400">This can't be undone.</p>
        <div class="mt-3 flex justify-end gap-2">
            <button type="button" class="btn-secondary btn-sm" data-dropdown-close>Cancel</button>
            <form method="post" action="@Action">
                <AntiforgeryToken />
                @foreach (var (name, value) in HiddenFields)
                {
                    <input type="hidden" name="@name" value="@value" />
                }
                <button type="submit" class="btn-danger btn-sm">Delete</button>
            </form>
        </div>
    </div>
</details>

@code {
    [Parameter, EditorRequired]
    public string Action { get; set; } = "";

    /// <summary>The question, e.g. "Delete this comment?".</summary>
    [Parameter, EditorRequired]
    public string Prompt { get; set; } = "";

    /// <summary>Accessible name of the trigger, e.g. "Delete comment".</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string TriggerText { get; set; } = "Delete";

    [Parameter]
    public IReadOnlyDictionary<string, string?> HiddenFields { get; set; } = new Dictionary<string, string?>();
}
