@* Uploaded-file list + uploader, shared by project, test-case and defect attachments.
   Static SSR: the file list and each Delete are plain form posts;
   the uploader is an "Add attachments" modal (<dialog>) driven by wwwroot/js/attachment-upload.js,
   which POSTs each picked file to /attachments/upload in turn. Each row downloads; images, video,
   audio and PDFs also open the shared preview modal (AttachmentPreviewDialog) from their name or eye icon.
   Files attached to the item's comments follow its own, marked with the comment they came with
   (linked; they're removed with the comment, not from here).
   The list pages 5 at a time via the ?filesPage query parameter and, once there's more than a page
   of it, can be searched (by file name, description or uploader) via ?attachmentQ and filtered by
   type (images, videos, audio, docs, other) via ?attachmentType. The preview modal steps through
   every previewable file the list currently holds — across all its pages — via the panel's
   data-preview-sequence (JSON; an attribute rather than a <template>, because enhanced navigation
   refreshes attributes but not a template's content). *@
@using Microsoft.AspNetCore.WebUtilities
@using QaTracker.Web.Admin
@using QaTracker.Web.Attachments
@using QaTracker.Web.Data
@inject AttachmentService Attachments
@inject SystemSettingsService SettingsService
@inject NavigationManager Nav

<div id="attachments" class="space-y-3" data-preview-group data-preview-sequence="@PreviewSequenceJson">
    @if (allItems.Count == 0)
    {
        <p class="text-sm text-gray-400">No attachments yet.</p>
    }
    else
    {
        @if (allItems.Count > PageSize || searchActive || typeFilter is not null)
        {
            <div class="flex items-center gap-2">
            @* GET form back to this same page: other query parameters are carried over as hidden
               fields, and the page number is dropped so a new search starts on page 1. *@
            <form method="get" action="@(searchPath)#attachments" class="flex min-w-0 flex-1 items-center gap-2">
                @foreach (var (key, value) in carriedQuery)
                {
                    <input type="hidden" name="@key" value="@value" />
                }
                <input type="search" name="attachmentQ" value="@SearchTerm" placeholder="Search attachments"
                       aria-label="Search attachments" class="form-control" />
                <button type="submit" class="btn-secondary shrink-0">Search</button>
                @if (searchActive)
                {
                    <a href="@ClearSearchUrl" class="btn-link shrink-0 text-sm">Clear</a>
                }
            </form>
            @TypeFilter()
            </div>
        }

        @if (items.Count == 0)
        {
            <p class="text-sm text-gray-400" data-attachments-empty>@EmptyText</p>
        }

        <ul class="space-y-3">
            @foreach (var item in pageItems)
            {
                <li class="flex flex-wrap items-start gap-3 rounded-md border border-gray-200 p-3 dark:border-gray-800" @key="item.Id">
                    @{ var preview = Preview(item); }
                    <div class="min-w-0 flex-1">
                        @if (preview is not null)
                        {
                            @* Previewable: the name opens the preview modal (attachment-preview.js). *@
                            <p>
                                <button type="button" class="break-words text-left font-medium text-gray-900 hover:underline dark:text-gray-100"
                                        @attributes="preview.Attributes">@item.FileName</button>
                            </p>
                        }
                        else
                        {
                            <p class="break-words font-medium text-gray-900 dark:text-gray-100">@item.FileName</p>
                        }
                        @if (item.Comment is { } comment)
                        {
                            <p class="text-xs text-gray-400" data-attachment-comment>
                                @ByteSize.Format(item.SizeBytes) · With a comment by
                                <span class="font-medium text-gray-500 dark:text-gray-300">@comment.AuthorName</span> ·
                                <a href="@CommentHref(comment)" class="text-gray-400 underline-offset-2 hover:text-gray-600 hover:underline dark:hover:text-gray-200">@Format(comment.CreatedUtc)</a>
                            </p>
                        }
                        else
                        {
                            <p class="text-xs text-gray-400">
                                @ByteSize.Format(item.SizeBytes) · @item.UploadedByName · @Format(item.UploadedUtc)
                            </p>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <p class="mt-1 text-sm text-gray-700 dark:text-gray-300">@item.Description</p>
                        }
                    </div>
                    <div class="flex shrink-0 items-center gap-1">
                        @if (preview is not null)
                        {
                            <button type="button" aria-label="Preview @item.FileName" title="Preview"
                                    @attributes="preview.Attributes"
                                    class="inline-flex items-center justify-center rounded-md p-1.5 text-gray-500
                                           hover:bg-gray-100 hover:text-gray-700 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                            </svg>
                            </button>
                        }
                        <a href="attachments/@item.Id" download="@item.FileName" aria-label="Download @item.FileName"
                           class="inline-flex items-center justify-center rounded-md p-1.5 text-gray-500 no-underline
                                  hover:bg-gray-100 hover:text-gray-700 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                            </svg>
                        </a>
                        @if (CanDelete(item))
                        {
                            <details class="group relative" data-dropdown>
                                <summary role="button" title="Delete @item.FileName" aria-label="Delete @item.FileName"
                                         class="inline-flex cursor-pointer list-none items-center justify-center rounded-md p-1.5
                                                text-gray-500 hover:bg-red-50 hover:text-red-600 group-open:bg-red-50 group-open:text-red-600
                                                dark:text-gray-400 dark:hover:bg-red-950 dark:hover:text-red-400
                                                dark:group-open:bg-red-950 dark:group-open:text-red-400
                                                [&::-webkit-details-marker]:hidden">
                                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M6 7h12M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2m-1 3v7m-4-7v7M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2l1-12" />
                                    </svg>
                                </summary>
                                <div class="absolute right-0 z-20 mt-2 w-56 rounded-md border border-gray-200 bg-white p-3 text-left shadow-lg
                                            dark:border-gray-800 dark:bg-gray-900">
                                    <p class="text-sm text-gray-700 dark:text-gray-200">Delete this attachment?</p>
                                    <p class="mt-0.5 text-xs text-gray-400">This can't be undone.</p>
                                    @* Destructive: safe choice first, Delete last (see ConfirmDelete). *@
                                    <div class="mt-3 flex justify-end gap-2">
                                        <button type="button" class="btn-secondary btn-sm" data-dropdown-close>Cancel</button>
                                        <form method="post" action="attachments/@item.Id/delete">
                                            <AntiforgeryToken />
                                            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                                            <button type="submit" class="btn-danger btn-sm">Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </details>
                        }
                    </div>
                </li>
            }
        </ul>

        @if (totalPages > 1)
        {
            <nav class="flex items-center justify-between gap-2 pt-1" aria-label="Attachments pages">
                <a href="@PageUrl(currentPage - 1)"
                   class="btn-secondary btn-sm @(currentPage <= 1 ? "pointer-events-none opacity-50" : "")"
                   aria-disabled="@(currentPage <= 1)">Previous</a>
                <span class="text-xs text-gray-400">Page @currentPage of @totalPages · @items.Count @(items.Count == 1 ? "attachment" : "attachments")</span>
                <a href="@PageUrl(currentPage + 1)"
                   class="btn-secondary btn-sm @(currentPage >= totalPages ? "pointer-events-none opacity-50" : "")"
                   aria-disabled="@(currentPage >= totalPages)">Next</a>
            </nav>
        }
    }

    @if (!canContribute)
    {
        @* Viewers read and download only. *@
    }
    else if (!Attachments.StorageConfigured)
    {
        <p class="text-xs text-gray-400">Attachment storage isn't configured.</p>
    }
    else
    {
        <div data-upload-panel
             data-owner="@Owner"
             data-owner-id="@OwnerId"
             data-return-url="@ReturnUrl"
             data-max-bytes="@maxBytes">
            <button type="button" class="btn-secondary" data-upload-open>Add attachments</button>

            @if (uploadError is not null)
            {
                <p class="mt-2 text-sm text-red-600 dark:text-red-400">@uploadError</p>
            }

            <dialog data-upload-dialog
                    class="w-full max-w-lg modal">
                <form data-upload-form class="space-y-4 p-6">
                    <AntiforgeryToken />
                    <h3 class="text-base font-semibold">Add attachments</h3>

                    <div class="flex flex-wrap items-center gap-3">
                        <label for="upload-input-@OwnerId" class="btn-secondary cursor-pointer" data-upload-choose>
                            Choose files
                        </label>
                        <span class="text-xs text-gray-400">Max @maxMb MB per file</span>
                        <input id="upload-input-@OwnerId" type="file" name="files" multiple
                               data-upload-input class="sr-only" />
                    </div>

                    @* Scrolls inside a bordered panel (like the team-member picker) so a long batch of
                       files can't stretch the modal. Hidden until something is staged (attachment-upload.js). *@
                    <div data-upload-list-panel hidden
                         class="max-h-64 overflow-y-auto rounded-md border border-gray-200 bg-gray-50 p-1
                                dark:border-gray-800 dark:bg-gray-950/40">
                        <ul data-upload-list class="divide-y divide-gray-200 dark:divide-gray-800"></ul>
                    </div>
                    <div class="flex items-center justify-between gap-3 text-sm text-gray-400">
                        <span data-upload-empty>No attachments added yet.</span>
                        <span data-upload-total hidden></span>
                    </div>

                    <input class="form-control" name="Description" placeholder="Description (optional)"
                           data-upload-description />

                    <div data-upload-progress hidden class="space-y-1">
                        <progress data-upload-bar value="0" max="1" class="h-2 w-full"></progress>
                        <p data-upload-status class="text-xs text-gray-500 dark:text-gray-400"></p>
                    </div>

                    <p data-upload-error hidden class="text-sm text-red-600 dark:text-red-400"></p>

                    <div class="flex flex-wrap items-center gap-2">
                        <button type="submit" class="btn-primary" data-upload-submit disabled>
                            <svg data-upload-spinner hidden class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                                <path class="opacity-75" fill="currentColor"
                                      d="M4 12a8 8 0 0 1 8-8V0C5.4 0 0 5.4 0 12h4z" />
                            </svg>
                            Upload
                        </button>
                        <button type="button" class="btn-secondary" data-upload-cancel>Cancel</button>
                    </div>
                </form>
            </dialog>
        </div>
    }
</div>

@code {
    private const int PageSize = 5;

    [Parameter, EditorRequired]
    public AttachmentOwner Owner { get; set; }

    [Parameter, EditorRequired]
    public Guid OwnerId { get; set; }

    [Parameter, EditorRequired]
    public string CurrentUserId { get; set; } = "";

    [Parameter]
    public bool IsQa { get; set; }

    /// <summary>Same-site path the upload/delete posts redirect back to.</summary>
    [Parameter, EditorRequired]
    public string ReturnUrl { get; set; } = "/";

    private IReadOnlyList<AttachmentView> allItems = [];
    private IReadOnlyList<AttachmentView> items = [];
    private IReadOnlyList<AttachmentView> pageItems = [];
    private int currentPage = 1;
    private int totalPages = 1;
    private string? uploadError;
    private string? SearchTerm;
    private bool searchActive;
    private string searchPath = "/";
    private List<KeyValuePair<string, string>> carriedQuery = [];
    private long maxBytes;
    private long maxMb;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>Names that can be @-mentioned here, so a comment shown in the preview tags them green.</summary>
    [Parameter]
    public IReadOnlyList<string> MentionNames { get; set; } = [];

    /// <summary>The ?attachmentType filter, or null for every type.</summary>
    private AttachmentCategory? typeFilter;

    /// <summary>How many of the searched files are of each type (the filter menu's counts).</summary>
    private Dictionary<AttachmentCategory, int> typeCounts = [];

    private int searchedCount;

    /// <summary>QA or Dev: may add files and remove their own. Viewers only read and download.</summary>
    private bool canContribute;

    protected override async Task OnParametersSetAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        canContribute = user is not null && Roles.Contributors.Any(user.IsInRole);

        maxMb = await SettingsService.GetMaxUploadMbAsync();
        maxBytes = maxMb * 1024 * 1024;

        var query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        uploadError = query.TryGetValue("attachmentError", out var err) ? err.ToString() : null;

        SearchTerm = query.TryGetValue("attachmentQ", out var q) ? q.ToString().Trim() : null;
        searchActive = !string.IsNullOrEmpty(SearchTerm);
        searchPath = new Uri(Nav.Uri).AbsolutePath;
        carriedQuery = query
            .Where(kv => kv.Key is not ("attachmentQ" or "filesPage" or "attachmentError"))
            .SelectMany(kv => kv.Value.Select(v => new KeyValuePair<string, string>(kv.Key, v ?? "")))
            .ToList();

        allItems = Owner switch
        {
            AttachmentOwner.Project => await Attachments.ListForProjectAsync(OwnerId),
            AttachmentOwner.TestCase => await Attachments.ListForTestCaseAsync(OwnerId),
            AttachmentOwner.Defect => await Attachments.ListForDefectAsync(OwnerId),
            _ => [],
        };

        var searched = !searchActive
            ? allItems
            : allItems.Where(a =>
                    a.FileName.Contains(SearchTerm!, StringComparison.OrdinalIgnoreCase)
                    || (a.Description?.Contains(SearchTerm!, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (a.UploadedByName?.Contains(SearchTerm!, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();

        typeFilter = AttachmentCategories.Parse(query.TryGetValue("attachmentType", out var type) ? type.ToString() : null);
        typeCounts = searched
            .GroupBy(a => AttachmentCategories.Of(a.FileName, a.ContentType))
            .ToDictionary(g => g.Key, g => g.Count());
        searchedCount = searched.Count;
        items = typeFilter is { } only
            ? searched.Where(a => AttachmentCategories.Of(a.FileName, a.ContentType) == only).ToList()
            : searched;

        totalPages = Math.Max(1, (int)Math.Ceiling(items.Count / (double)PageSize));
        currentPage = query.TryGetValue("filesPage", out var raw) && int.TryParse(raw, out var requested)
            ? Math.Clamp(requested, 1, totalPages)
            : 1;
        pageItems = items.Skip((currentPage - 1) * PageSize).Take(PageSize).ToList();
    }

    private string PageUrl(int target) =>
        Nav.GetUriWithQueryParameter("filesPage", Math.Clamp(target, 1, totalPages));

    private string ClearSearchUrl =>
        Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["attachmentQ"] = null, ["filesPage"] = null }) + "#attachments";

    /// <summary>Every previewable file in the (searched / filtered) list, in order, for the preview
    /// modal's Previous / Next (attachment-preview.js).</summary>
    private string PreviewSequenceJson => PreviewItem.Json(items.Select(Preview).OfType<PreviewItem>());

    /// <summary>What the preview modal shows for a file: who added it and when, and its comment, if any.</summary>
    private PreviewItem? Preview(AttachmentView item) => item.Comment is { } c
        ? PreviewItem.For(item.Id, item.FileName, c.AuthorName, c.CreatedUtc, c.AuthorName, c.CreatedUtc, c.Body, CommentHref(c),
            item.Description, CommentBody.Segments(c.Body, MentionNames))
        : PreviewItem.For(item.Id, item.FileName, item.UploadedByName, item.UploadedUtc, description: item.Description);

    /// <summary>Straight to the comment, on its page of this page's comment thread, outlined.</summary>
    private string CommentHref(AttachmentComment comment) =>
        $"{searchPath}?{Comments.CommentPaging.QueryParam}={comment.ThreadPage}&{Comments.CommentPaging.HighlightParam}={comment.Id}#comment-{comment.Id}";

    private string EmptyText => (typeFilter, searchActive) switch
    {
        ({ } t, true) => $"No {AttachmentCategories.Label(t).ToLowerInvariant()} match “{SearchTerm}”.",
        ({ } t, false) => $"No {AttachmentCategories.Label(t).ToLowerInvariant()} attached.",
        _ => $"No attachments match “{SearchTerm}”.",
    };

    private string TypeUrl(AttachmentCategory? category) =>
        Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["attachmentType"] = category is { } c ? AttachmentCategories.Value(c) : null,
            ["filesPage"] = null,
        }) + "#attachments";

    /// <summary>The type filter: a small toggle beside the search box (showing the type while one is
    /// picked) opening a menu of types with how many files each has.</summary>
    private RenderFragment TypeFilter() => __builder =>
    {
        <details class="group relative shrink-0" data-dropdown data-attachment-type-filter>
            <summary aria-label="Filter attachments by type" title="Filter by type"
                     class="@($"flex cursor-pointer list-none items-center gap-1.5 rounded-md border px-2.5 py-2 text-sm font-medium [&::-webkit-details-marker]:hidden {(typeFilter is null ? "border-gray-300 bg-white text-gray-600 hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300 dark:hover:bg-gray-800" : "border-brand-600 bg-brand-50 text-brand-800 dark:border-brand-500 dark:bg-brand-950 dark:text-brand-300")}")">
                <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z" />
                </svg>
                @if (typeFilter is { } current)
                {
                    <span data-attachment-type-current>@AttachmentCategories.Label(current)</span>
                }
            </summary>
            <div class="absolute right-0 z-20 mt-2 w-48 rounded-md border border-gray-200 bg-white py-1 shadow-lg dark:border-gray-800 dark:bg-gray-900">
                @TypeOption(null, "All", searchedCount)
                <div class="my-1 border-t border-gray-100 dark:border-gray-800" role="separator"></div>
                @foreach (var category in AttachmentCategories.All)
                {
                    @TypeOption(category, AttachmentCategories.Label(category), typeCounts.GetValueOrDefault(category))
                }
            </div>
        </details>
    };

    private RenderFragment TypeOption(AttachmentCategory? category, string label, int count) =>
        @<a href="@TypeUrl(category)" data-attachment-type="@(category is { } c ? AttachmentCategories.Value(c) : "all")"
            aria-current="@(typeFilter == category ? "true" : null)"
            class="@($"flex items-center gap-2 px-3 py-1.5 text-sm no-underline hover:bg-gray-100 dark:hover:bg-gray-800 {(count == 0 && typeFilter != category ? "text-gray-400 dark:text-gray-500" : "text-gray-700 dark:text-gray-200")}")">
            <span class="flex-1">@label</span>
            <span class="text-xs text-gray-400">@count</span>
            <span class="w-3 text-brand-600 dark:text-brand-400">@(typeFilter == category ? "✓" : "")</span>
        </a>;

    private bool CanDelete(AttachmentView item) =>
        item.Comment is null && canContribute && (IsQa || item.UploadedById == CurrentUserId);

    private static string Format(DateTimeOffset utc) =>
        utc.UtcDateTime.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture) + " UTC";
}
