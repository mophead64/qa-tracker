@using QaTracker.Web.TestCases
@using QaTracker.Web.Defects
@* A scope / test case / defect ID ("S-3", "T-12", "D-2") shown in front of its name wherever tests are mentioned:
   small, monospaced and muted, so the name still reads first. Kind decides the hover title and
   the data hook (data-scope-ref / data-case-ref) tests and scripts use. *@

<span class="@($"shrink-0 whitespace-nowrap font-mono text-xs font-normal text-gray-400 {Class}")"
      title="@(Kind switch { IdKind.Scope => "Scope ID", IdKind.Case => "Test case ID", _ => "Defect ID" })"
      data-scope-ref="@(Kind == IdKind.Scope ? "" : null)" data-case-ref="@(Kind == IdKind.Case ? "" : null)"
      data-defect-ref="@(Kind == IdKind.Defect ? "" : null)">@Text</span>

@code {
    public enum IdKind { Scope, Case, Defect }

    [Parameter, EditorRequired]
    public IdKind Kind { get; set; }

    [Parameter, EditorRequired]
    public int Number { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private string Text => Kind switch
    {
        IdKind.Scope => TestCaseDisplay.ScopeRef(Number),
        IdKind.Case => TestCaseDisplay.CaseRef(Number),
        _ => DefectDisplay.Ref(Number),
    };
}
