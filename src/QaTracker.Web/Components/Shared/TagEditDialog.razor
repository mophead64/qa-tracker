@* The small "edit tag" modal behind a clickable tag name (project dashboard, System settings tags
   page): name, colour, [Save] [Cancel] and, far right, [Delete] with its own "are you sure?" step.
   Tags are system-wide, so both say how many projects the change reaches. Posts to /tags/{id}
   with ReturnUrl; when the page comes back with this tag's edit error, it opens again by itself.
   Only render it for people who can manage projects (the endpoints check that too). *@

<dialog id="@DialogId" class="modal w-full max-w-sm" aria-labelledby="@($"{DialogId}-title")"
        data-dialog-autoopen="@(Error is not null ? "true" : "false")" data-tag-edit-dialog>
    <div class="space-y-4 p-6">
        <h3 id="@($"{DialogId}-title")" class="text-base font-semibold">Edit tag</h3>

        <form id="@($"{DialogId}-form")" method="post" action="@($"tags/{Item.Id}")" class="space-y-3">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <div>
                <label class="form-label" for="@($"{DialogId}-name")">Name</label>
                <input id="@($"{DialogId}-name")" name="tagName" class="form-control" maxlength="@Tag.MaxNameLength"
                       value="@Item.Name" autocomplete="off" autocapitalize="off" spellcheck="false"
                       data-1p-ignore data-lpignore="true" data-bwignore data-form-type="other" required />
            </div>
            <TagColourPicker Current="Item.Colour" />
            @if (Error is not null)
            {
                <p class="text-sm text-red-600 dark:text-red-400" data-tag-edit-error>@Error</p>
            }
            <p class="text-xs text-gray-400">@Reach</p>
        </form>

        <div class="flex items-center gap-2 pt-1">
            <button type="submit" form="@($"{DialogId}-form")" class="btn-primary">Save</button>
            <button type="button" class="btn-outline" data-dialog-close>Cancel</button>
            <details class="relative ml-auto" data-dropdown data-tag-delete>
                <summary class="btn-danger-outline cursor-pointer list-none [&::-webkit-details-marker]:hidden">Delete</summary>
                <div class="absolute bottom-full right-0 z-20 mb-2 w-64 rounded-md border border-gray-200 bg-white p-3 text-left
                            shadow-lg dark:border-gray-800 dark:bg-gray-900">
                    <p class="text-sm text-gray-700 dark:text-gray-200">@DeletePrompt</p>
                    <p class="mt-0.5 text-xs text-gray-400">This can't be undone.</p>
                    <form method="post" action="@($"tags/{Item.Id}/delete")" class="mt-3 flex gap-2">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="@DeleteReturnUrl" />
                        <button type="submit" class="btn-danger btn-sm">Delete tag</button>
                        <button type="button" class="btn-secondary btn-sm" data-dropdown-close>Cancel</button>
                    </form>
                </div>
            </details>
        </div>
    </div>
</dialog>

@code {
    [Parameter, EditorRequired]
    public TagUsage Item { get; set; } = default!;

    /// <summary>Same-site path (starting "/") to land on after saving.</summary>
    [Parameter, EditorRequired]
    public string ReturnUrl { get; set; } = "/";

    /// <summary>Where to land after deleting; defaults to <see cref="ReturnUrl"/>.</summary>
    [Parameter]
    public string? AfterDeleteUrl { get; set; }

    /// <summary>The server's reason this tag's last edit was turned down (reopens the modal).</summary>
    [Parameter]
    public string? Error { get; set; }

    public static string IdFor(Guid tagId) => $"tag-edit-{tagId}";

    private string DialogId => IdFor(Item.Id);

    private string DeleteReturnUrl => AfterDeleteUrl ?? ReturnUrl;

    private string Projects(int n) => n == 1 ? "1 project" : $"{n} projects";

    private string Reach => Item.ProjectCount switch
    {
        0 => "Not on any project yet.",
        1 => "Changes show on the 1 project with this tag.",
        var n => $"Changes show on all {n} projects with this tag.",
    };

    private string DeletePrompt => Item.ProjectCount == 0
        ? $"Delete the tag \"{Item.Name}\"?"
        : $"Delete the tag \"{Item.Name}\"? It comes off {Projects(Item.ProjectCount)}.";
}
