@using QaTracker.Web.Board

@* The "Board" card on defect and test case pages: the stories and bugs linked to this item, with
   their column. Shown only for projects using the development board. *@
<div id="board-items" class="card scroll-mt-6" data-linked-board-items>
    <h2>Board</h2>
    <p class="card-intro">@Intro</p>
    @if (Items.Count == 0)
    {
        <p class="mt-3 text-sm text-gray-400">Nothing on the board is linked.</p>
    }
    else
    {
        <ul class="mt-3 divide-y divide-gray-100 dark:divide-gray-800">
            @foreach (var linked in Items)
            {
                <li class="flex flex-wrap items-center gap-3 py-2" @key="linked.Id" data-linked-board-item="@linked.Ref">
                    <span class="@BoardDisplay.TypeBadgeClass(linked.Type) shrink-0">@BoardDisplay.TypeLabel(linked.Type)</span>
                    <span class="shrink-0 font-mono text-xs text-gray-500 dark:text-gray-400">@linked.Ref</span>
                    <a href="@AppUrls.BoardItem(ProjectId, linked.Id)" class="min-w-0 flex-1 truncate no-underline hover:underline">@linked.Title</a>
                    <span class="@BoardDisplay.ColumnBadgeClass(linked.Column) shrink-0">@BoardDisplay.ColumnLabel(linked.Column)</span>
                </li>
            }
        </ul>
    }
    @if (ChildContent is not null)
    {
        <div class="mt-4 flex flex-wrap gap-2">@ChildContent</div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public Guid ProjectId { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<LinkedBoardItem> Items { get; set; } = [];

    [Parameter]
    public string Intro { get; set; } = "Stories and bugs on the development board linked to this.";

    /// <summary>Buttons under the list (e.g. "Create bug from this defect").</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
