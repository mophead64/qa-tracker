@* Fully colour-coded status dropdown that submits as soon as an option is picked.
   The toggle *is* the current status (solid colour block); the panel lists every
   state as its own colour block. Static-rendered, so each option is its own POST
   form — same pattern as the project switcher in the top bar. *@

<details class="group relative inline-block" data-dropdown>
    <summary aria-label="@Label"
             class="@CurrentChipClass cursor-pointer list-none hover:opacity-90
                    [&::-webkit-details-marker]:hidden">
        <span>@CurrentLabel</span>
        <svg class="h-4 w-4 shrink-0 opacity-80 transition-transform group-open:rotate-180"
             fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
        </svg>
    </summary>

    <div class="absolute left-0 z-20 mt-2 w-56 space-y-1 rounded-md border border-gray-200
                bg-white p-1 shadow-lg dark:border-gray-800 dark:bg-gray-900">
        @foreach (var option in Options)
        {
            <form method="post" action="@Action">
                <AntiforgeryToken />
                @foreach (var field in HiddenFields)
                {
                    <input type="hidden" name="@field.Key" value="@field.Value" />
                }
                <input type="hidden" name="@FieldName" value="@option.Value" />
                <button type="submit"
                        class="@option.ChipClass flex w-full items-center justify-between
                               hover:opacity-90 disabled:cursor-default disabled:opacity-100"
                        disabled="@(option.Value == Current)">
                    <span>@option.Label</span>
                    @if (option.Value == Current)
                    {
                        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24"
                             stroke-width="3" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                        </svg>
                    }
                </button>
            </form>
        }
    </div>
</details>

@code {
    /// <summary>Form-post URL the chosen option submits to.</summary>
    [Parameter, EditorRequired]
    public string Action { get; set; } = "";

    /// <summary>Name of the form field carrying the selected value.</summary>
    [Parameter]
    public string FieldName { get; set; } = "status";

    /// <summary>Accessible label for the dropdown toggle.</summary>
    [Parameter]
    public string Label { get; set; } = "Change status";

    /// <summary>Currently selected value (matched against <see cref="Option.Value"/>).</summary>
    [Parameter, EditorRequired]
    public string Current { get; set; } = "";

    [Parameter, EditorRequired]
    public string CurrentLabel { get; set; } = "";

    /// <summary>Solid chip classes for the current status, e.g. "chip chip-red".</summary>
    [Parameter]
    public string CurrentChipClass { get; set; } = "chip chip-gray";

    [Parameter, EditorRequired]
    public IReadOnlyList<Option> Options { get; set; } = [];

    /// <summary>Extra hidden fields to post alongside the value, e.g. a return URL.</summary>
    [Parameter]
    public IReadOnlyDictionary<string, string?> HiddenFields { get; set; } =
        new Dictionary<string, string?>();

    /// <summary>One selectable state: its posted value, display label and solid chip classes.</summary>
    public sealed record Option(string Value, string Label, string ChipClass);
}
